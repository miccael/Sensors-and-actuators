                                 	//---------------------1-wire init Vcc powered device Overdrive Mode---------------
                                 
000261 d017                      	rcall OWResetOD
000262 e30c                      	ldi r16, 0x3C     //Overdrive skip ROM
000263 d032                      	rcall OWWriteByteOD
000264 ef00                      	ldi r16, 0xF0     //Read PIO Registers command
000265 d030                      	rcall OWWriteByteOD
000266 e80d                      	ldi r16, 0x8D     //TA1 beginning adress
000267 d02e                      	rcall OWWriteByteOD
000268 e000                      	ldi r16, 0x00     //TA2 adress 008Dh
000269 d02c                      	rcall OWWriteByteOD
00026a d046                      	rcall OWReadByteOD //Read Control/Status Register and verify
                                 
00026b d00d                      	rcall OWResetOD
00026c e30c                      	ldi r16, 0x3C     //Overdrive skip ROM
00026d d028                      	rcall OWWriteByteOD
00026e e50a                      	ldi r16, 0x5A     //Channel-access Write command
00026f d026                      	rcall OWWriteByteOD
000270 2f02                      	mov r16, r18     //Write byte to PIO
000271 d024                      	rcall OWWriteByteOD
000272 2f02                      	mov r16, r18     //
000273 9500                      	com r16           //
                                 	//ldi r16, 0xFF     //Write inverted byte to PIO
000274 d021                      	rcall OWWriteByteOD
000275 d03b                      	rcall OWReadByteOD //Read for verification (AAh = success)
000276 d03a                      	rcall OWReadByteOD //Read PIO pin status
000277 d001                      	rcall OWResetOD
                                 	
000278 9508                      ret
                                 
                                 
                                 
                                 ;-------------------Overdrive Mode Start---------------------------------------
                                 ;------------------------------------------------------------------------------
                                 
                                 ;------------------------------------------------------------------------------
                                 ; Output : T - presence bit
                                 ;------------------------------------------------------------------------------
                                 OWResetOD:
000279 985c                      	cbi		OW_PORT,OW_DQ
00027a 9a54                      	sbi		OW_DDR,OW_DQ
                                 
00027b e0b1                      	ldi		XH, HIGH(DVUS(55))
00027c e1a3                      	ldi		XL, LOW(DVUS(55))
00027d ddaf                      	rcall	Wait4xCycles
                                 	
00027e 9854                      	cbi		OW_DDR,OW_DQ
                                 
00027f e0b0                      	ldi		XH, HIGH(DVUS(8))
000280 e2a8                      	ldi		XL, LOW(DVUS(8))
000281 ddab                      	rcall	Wait4xCycles
                                 
000282 9468                      	set
000283 9b4c                      	sbis	OW_PIN,OW_DQ
000284 94e8                      	clt
                                 
000285 e0b0                      	ldi		XH, HIGH(DVUS(48))
000286 efa0                      	ldi		XL, LOW(DVUS(48))
000287 dda5                      	rcall	Wait4xCycles
                                 
000288 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Input : C - bit to write
                                 ;------------------------------------------------------------------------------
                                 OWWriteBitOD:
000289 f418                      	brcc	OWWriteZeroOD
00028a e0b0                      	ldi		XH, HIGH(DVUS(1))//Måste Kalibreras
00028b e0a5                      	ldi		XL, LOW(DVUS(1))//Måste Kalibreras
00028c c002                      	rjmp	OWWriteOneOD
                                 OWWriteZeroOD:	
00028d e0b0                      	ldi		XH, HIGH(DVUS(10)) 
00028e e3a2                      	ldi		XL, LOW(DVUS(10)) 
                                 OWWriteOneOD:
00028f 9a54                      	sbi		OW_DDR, OW_DQ
000290 dd9c                      	rcall	Wait4xCycles
000291 9854                      	cbi		OW_DDR, OW_DQ
                                 	
000292 e0b0                      	ldi		XH, HIGH(DVUS(10))
000293 e3a2                      	ldi		XL, LOW(DVUS(10))
000294 dd98                      	rcall	Wait4xCycles
000295 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Input : r16 - byte to write
                                 ;------------------------------------------------------------------------------
                                 OWWriteByteOD:
000296 931f                      	push	OWCount
000297 e010                      	ldi		OWCount,0
                                 OWWriteLoopOD:	
000298 9507                      	ror		r16
000299 dfef                      	rcall	OWWriteBitOD	
00029a 9513                      	inc		OWCount
00029b 3018                      	cpi		OWCount,8
00029c f7d9                      	brne	OWWriteLoopOD
00029d 911f                      	pop		OWCount		
00029e 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Output : C - bit from slave
                                 ;------------------------------------------------------------------------------
                                 OWReadBitOD:
00029f e0b0                      	ldi		XH, HIGH(DVUS(1)) //Måste kalibreras
0002a0 e0a5                      	ldi		XL, LOW(DVUS(1)) //Måste kalibreras
0002a1 9a54                      	sbi		OW_DDR, OW_DQ
0002a2 dd8a                      	rcall	Wait4xCycles
0002a3 9854                      	cbi		OW_DDR, OW_DQ
0002a4 e0b0                      	ldi		XH, HIGH(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent, 1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
0002a5 e0a5                      	ldi		XL, LOW(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent,  1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
0002a6 dd86                      	rcall	Wait4xCycles
0002a7 94e8                      	clt
0002a8 994c                      	sbic	OW_PIN,OW_DQ
0002a9 9468                      	set
0002aa e0b0                      	ldi		XH, HIGH(DVUS(10))
0002ab e3a2                      	ldi		XL, LOW(DVUS(10))
0002ac dd80                      	rcall	Wait4xCycles
0002ad 9408                      	sec
0002ae f00e                      	brts	OWReadBitEndOD
0002af 9488                      	clc
                                 OWReadBitEndOD:
0002b0 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Output : r16 - byte from slave
                                 ;------------------------------------------------------------------------------
                                 OWReadByteOD:
0002b1 931f                      	push	OWCount
0002b2 e010                      	ldi		OWCount,0
                                 OWReadLoopOD:
0002b3 dfeb                      	rcall	OWReadBitOD
0002b4 9507                      	ror		r16
0002b5 9513                      	inc		OWCount
0002b6 3018                      	cpi		OWCount,8
0002b7 f7d9                      	brne	OWReadLoopOD
0002b8 911f                      	pop		OWCount
0002b9 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ;
                                 ;------------------------------------------------------------------------------
                                 
                                 ;-------------------Overdrive Mode End-----------------------------------------
                                 ;------------------------------------------------------------------------------
                                 
                                 
                                 
                                 ;-------------------Standard Mode Start-----------------------------------------
                                 ;------------------------------------------------------------------------------
                                 
                                 ;------------------------------------------------------------------------------
                                 ; Output : T - presence bit
                                 ;------------------------------------------------------------------------------
                                 OWReset:
0002ba 985c                      	cbi		OW_PORT,OW_DQ
0002bb 9a54                      	sbi		OW_DDR,OW_DQ
                                 
0002bc e0b9                      	ldi		XH, HIGH(DVUS(470))
0002bd e2ae                      	ldi		XL, LOW(DVUS(470))
0002be dd6e                      	rcall	Wait4xCycles
                                 	
0002bf 9854                      	cbi		OW_DDR,OW_DQ
                                 
0002c0 e0b1                      	ldi		XH, HIGH(DVUS(70))
0002c1 e5ae                      	ldi		XL, LOW(DVUS(70))
0002c2 dd6a                      	rcall	Wait4xCycles
                                 
0002c3 9468                      	set
0002c4 9b4c                      	sbis	OW_PIN,OW_DQ
0002c5 94e8                      	clt
                                 
0002c6 e0b4                      	ldi		XH, HIGH(DVUS(240))
0002c7 eba0                      	ldi		XL, LOW(DVUS(240))
0002c8 dd64                      	rcall	Wait4xCycles
                                 
0002c9 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Input : C - bit to write
                                 ;------------------------------------------------------------------------------
                                 OWWriteBit:
0002ca f418                      	brcc	OWWriteZero
0002cb e0b0                      	ldi		XH, HIGH(DVUS(1))
0002cc e0a5                      	ldi		XL, LOW(DVUS(1))
0002cd c002                      	rjmp	OWWriteOne
                                 OWWriteZero:	
0002ce e0b1                      	ldi		XH, HIGH(DVUS(70)) //Changed from 120
0002cf e5ae                      	ldi		XL, LOW(DVUS(70)) //Changed from 120
                                 OWWriteOne:
0002d0 9a54                      	sbi		OW_DDR, OW_DQ
0002d1 dd5b                      	rcall	Wait4xCycles
0002d2 9854                      	cbi		OW_DDR, OW_DQ
                                 	
0002d3 e0b1                      	ldi		XH, HIGH(DVUS(60))
0002d4 e2ac                      	ldi		XL, LOW(DVUS(60))
0002d5 dd57                      	rcall	Wait4xCycles
0002d6 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Input : r16 - byte to write
                                 ;------------------------------------------------------------------------------
                                 OWWriteByte:
0002d7 931f                      	push	OWCount
0002d8 e010                      	ldi		OWCount,0
                                 OWWriteLoop:	
0002d9 9507                      	ror		r16
0002da dfef                      	rcall	OWWriteBit	
0002db 9513                      	inc		OWCount
0002dc 3018                      	cpi		OWCount,8
0002dd f7d9                      	brne	OWWriteLoop
0002de 911f                      	pop		OWCount		
0002df 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Output : C - bit from slave
                                 ;------------------------------------------------------------------------------
                                 OWReadBit:
0002e0 e0b0                      	ldi		XH, HIGH(DVUS(1))
0002e1 e0a5                      	ldi		XL, LOW(DVUS(1))
0002e2 9a54                      	sbi		OW_DDR, OW_DQ
0002e3 dd49                      	rcall	Wait4xCycles
0002e4 9854                      	cbi		OW_DDR, OW_DQ
0002e5 e0b0                      	ldi		XH, HIGH(DVUS(8)) //Kolla så att sampling inte sker försent, max 15us tRD - READ VALID, pga oexakta tider, oscilloskop!
0002e6 e2a8                      	ldi		XL, LOW(DVUS(8)) //Kolla så att sampling inte sker försent, max 15us tRD - READ VALID, pga oexakta tider, oscilloskop!
0002e7 dd45                      	rcall	Wait4xCycles
0002e8 94e8                      	clt
0002e9 994c                      	sbic	OW_PIN,OW_DQ
0002ea 9468                      	set
0002eb e0b0                      	ldi		XH, HIGH(DVUS(50))
0002ec efaa                      	ldi		XL, LOW(DVUS(50))
0002ed dd3f                      	rcall	Wait4xCycles
0002ee 9408                      	sec
0002ef f00e                      	brts	OWReadBitEnd
0002f0 9488                      	clc
                                 OWReadBitEnd:
0002f1 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Output : r16 - byte from slave
                                 ;------------------------------------------------------------------------------
                                 OWReadByte:
0002f2 931f                      	push	OWCount
0002f3 e010                      	ldi		OWCount,0
                                 OWReadLoop:
0002f4 dfeb                      	rcall	OWReadBit
0002f5 9507                      	ror		r16
0002f6 9513                      	inc		OWCount
0002f7 3018                      	cpi		OWCount,8
0002f8 f7d9                      	brne	OWReadLoop
0002f9 911f                      	pop		OWCount
0002fa 9508                      	ret
