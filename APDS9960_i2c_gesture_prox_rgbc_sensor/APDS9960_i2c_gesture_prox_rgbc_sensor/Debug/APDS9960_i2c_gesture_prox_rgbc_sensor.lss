                                 .dseg
000100                           DUMMY_PAGE_1: .BYTE 1 ; reserve 1 byte to DUMMY_PAGE_1
                                 .cseg
                                 
                                 
                                 //---------System Clock init----------------
                                   #define F_CPU 20000000 //
                                  //---------System Clock init----------------
                                  
                                 	
                                 	//---------------I2C definitions and init----------------------
                                 	//-------------------------------------------------------------
                                 		.def COMMAND = r19
                                 		.def DATA = r20
                                 		.def DATA1 = r21 //Particle sensing mode MAX30105 1 channel tot 3 bytes. LED1 RED only. Byte LED1[23:16]
                                 		.def DATA2 = r22 //Particle sensing mode MAX30105 1 channel tot 3 bytes. LED1 RED only. Byte LED1[15:8]
                                 		.def DATA3 = r23 //Particle sensing mode MAX30105 1 channel tot 3 bytes. LED1 RED only. Byte LED1[7:0]
                                 		.equ SLA_W = 0x72 //0x72 slave adress, 0x39 and R/W=0
                                 		.equ SLA_R = 0x73 //0x73 slave adress, 0x39 and R/W=1 
                                 		.equ START = 0x08
                                 		.equ R_START = 0x10
                                 		.equ MT_SLA_ACK = 0x18
                                 		.equ MR_SLA_ACK = 0x40
                                 		.equ MT_DATA_ACK = 0x28
                                 		.equ MR_DATA_ACK = 0x50
                                 		.equ MT_DATA_NOACK = 0x30
                                 		.equ MR_DATA_NOACK = 0x58
                                 
000000 e604                      		ldi r16, 100
000001 d02e                      		rcall	WaitMiliseconds //wait .1s
                                 
                                 		// deactivate internal pullups for twi.
000002 e000                      		ldi r16, (0<<PC4)|(0<<PC5)
000003 9300 0007                 		sts DDRC, r16
                                 
                                 		//------------SCL speed 50kHz @ 20MHz ATmega328p-----------
000005 ec00                      		ldi r16, 0xC0
000006 9300 00b8                 		sts TWBR, r16 //50kHz TWI (400 kHz max in MAX30105)
000008 e000                      		ldi r16, (0<<TWPS1)|(0<<TWPS0) //Prescaler 1
000009 9300 00b9                 		sts TWSR, r16
                                 		 //--------------------------------------------
                                 	
                                 		// enable twi module, acks, and twi interrupt
00000b e405                      		ldi r16, (1<<TWEN) | (1<<TWIE) | (1<<TWEA)
00000c 9300 00bc                 		sts TWCR, r16
                                 	//---------------I2C definitions and init----------------------
                                 	//-------------------------------------------------------------
                                 
                                 
                                 
                                 //---------------init of MAX30105------------------------------------
                                 //-----------------------------------------------------------------
00000e d00c                      rcall MAX30105_settings
00000f ec08                      		ldi r16, 200
000010 d01f                      		rcall	WaitMiliseconds //wait 200ms
                                 //---------------init of MAX30105------------------------------------
                                 //-----------------------------------------------------------------
                                  
000011 d1af                       rcall LCD
                                 
                                 
                                 
                                 
                                 ; Replace with your application code
                                 main:
000012 e001                      		ldi r16, 1
000013 d01c                      		rcall	WaitMiliseconds //wait
000014 ef3c                      				ldi COMMAND, 0xFC //read FIFO Data 
000015 d152                      				rcall MAX30105Read ;output in DATA
000016 2f54                      				mov DATA1, DATA
                                 /*						ldi r16, 10
                                 		rcall	WaitMiliseconds //wait*/
                                 /*				ldi COMMAND, 0xFD //read FIFO Data 
                                 				rcall MAX30105Read ;output in DATA
                                 				mov DATA2, DATA*/
000017 d023                      			rcall LCDwrite
000018 e001                      		ldi r16, 1
000019 d016                      		rcall	WaitMiliseconds //wait
00001a cff7                      rjmp main
                                 
                                 
                                 
                                 
                                 
                                 MAX30105_settings:
                                 
00001b e604                      		ldi r16, 100
00001c d013                      		rcall	WaitMiliseconds //wait
                                 
00001d e830                      ldi COMMAND, 0x80 //ENABLE register
00001e e041                      ldi DATA, 0b00000001 //PON=1, POWER ON
00001f d10a                      rcall MAX30105Write ;
                                 
000020 e604                      		ldi r16, 100
000021 d00e                      		rcall	WaitMiliseconds //wait	
                                 
000022 e830                      ldi COMMAND, 0x80 //ENABLE register
000023 e441                      ldi DATA, 0b01000001 //GEN=1, Gesture Enable
000024 d105                      rcall MAX30105Write ;
                                 
000025 e604                      		ldi r16, 100
000026 d009                      		rcall	WaitMiliseconds //wait	
                                 
000027 ea3b                      ldi COMMAND, 0xAB //GCONFIG4 register
000028 e041                      ldi DATA, 0b00000001 //GMODE=1, Gesture Mode
000029 d100                      rcall MAX30105Write ;
                                 
00002a e604                      		ldi r16, 100
00002b d004                      		rcall	WaitMiliseconds //wait	
                                 
00002c 9508                      ret
                                 
                                 
                                 
                                 
                                 #include "wait.asm" ; AVR Assembler v.2
                                 
                                  * wait.asm
                                  *
                                  *  Created: 2015-01-01 18:40:21
                                  *   Author: Mikael
                                  */ 
                                 
                                 
                                 ;------------------------------------------------------------------------------
                                 ; Busy-wait loops utilities module
                                 ; For F_CPU >= 4MHz
                                 ; http://avr-mcu.dxp.pl
                                 ; (c) Radoslaw Kwiecien, 2008
                                 ;------------------------------------------------------------------------------
                                 
                                 #ifndef F_CPU
                                 #endif
                                 
                                 #if F_CPU < 4000000
                                 #endif
                                 
                                 #define CYCLES_PER_US (F_CPU/1000000)
                                 #define C4PUS (CYCLES_PER_US/4)
                                 #define DVUS(x) (C4PUS*x)
                                 
                                 ;------------------------------------------------------------------------------
                                 ; Input : XH:XL - number of CPU cycles to wait (divided by four)
                                 ;------------------------------------------------------------------------------
                                 Wait4xCycles:
00002d 9711                        sbiw	  XH:XL, 1
00002e f7f1                        brne	  Wait4xCycles
00002f 9508                        ret
                                 ;------------------------------------------------------------------------------
                                 ; Input : r16 - number of miliseconds to wait
                                 ;------------------------------------------------------------------------------
                                 WaitMiliseconds:
000030 930f                        push	r16
                                 WaitMsLoop: 
000031 e0b9                        ldi	   XH,HIGH(DVUS(500))
000032 eca4                        ldi	   XL,LOW(DVUS(500))
000033 dff9                        rcall	 Wait4xCycles
000034 e0b9                        ldi	   XH,HIGH(DVUS(500))
000035 eca4                        ldi	   XL,LOW(DVUS(500))
000036 dff6                        rcall	 Wait4xCycles
000037 950a                        dec	   r16
000038 f7c1                        brne	  WaitMsLoop
000039 910f                        pop	   r16
00003a 9508                        ret
                                 ;------------------------------------------------------------------------------
                                 ; End of file
                                 
