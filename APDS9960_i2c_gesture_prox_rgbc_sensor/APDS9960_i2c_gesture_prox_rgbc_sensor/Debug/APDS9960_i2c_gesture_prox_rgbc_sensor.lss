                                 ;writes two bytes with the selected start register
                                 MAX30105Write://(byte command, byte data){
                                   
                                  
                                     //TWCR = (1<<TWINT)|(1<<TWSTA)|
                                     //(1<<TWEN);
00012a ea04                      	ldi r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
00012b 9300 00bc                 	sts TWCR, r16
                                     
                                     //while (!(TWCR & (1<<TWINT)))
                                     ;
                                     wait1:
00012d 9100 00bc                 	lds r16,TWCR
00012f ff07                      	sbrs r16,TWINT
000130 cffc                      	rjmp wait1
                                 
                                     //if ((TWSR & 0xF8) != START)
                                     //ERROR();
000131 9100 00b9                     lds r16,TWSR
000133 7f08                      	andi r16, 0xF8
000134 3008                      	cpi r16, START
000135 f799                      	brne ERROR1
                                 
                                 	
                                     //TWDR = SLA_W;
                                     //TWCR = (1<<TWINT) |
                                     //(1<<TWEN);
000136 e702                      	ldi r16, SLA_W
000137 9300 00bb                 	sts TWDR, r16
000139 e804                      	ldi r16, (1<<TWINT)|(1<<TWEN)
00013a 9300 00bc                 	sts TWCR, r16
                                     
                                 	
                                     //while (!(TWCR & (1<<TWINT)))
                                     //;
                                 	wait2:
00013c 9100 00bc                 	lds r16,TWCR
00013e ff07                      	sbrs r16,TWINT
00013f cffc                      	rjmp wait2
                                 
                                     
                                     //if ((TWSR & 0xF8) !=
                                     //MT_SLA_ACK)
                                     //ERROR();
000140 9100 00b9                 	lds r16,TWSR
000142 7f08                      	andi r16, 0xF8
000143 3108                      	cpi r16, MT_SLA_ACK
000144 f721                      	brne ERROR1
                                 
                                     
                                 	
                                 
                                     //---------------------
                                     //TWDR = command; //
                                     //TWCR = (1<<TWINT) |
                                     //(1<<TWEN);
000145 2f03                          mov r16, COMMAND //ex. COMMAND
000146 9300 00bb                 	sts TWDR, r16
000148 e804                      	ldi r16, (1<<TWINT)|(1<<TWEN)
000149 9300 00bc                 	sts TWCR, r16
                                 
                                 	
                                     //while (!(TWCR & (1<<TWINT)))
                                     //;
                                 	wait3:
00014b 9100 00bc                 	lds r16,TWCR
00014d ff07                      	sbrs r16,TWINT
00014e cffc                      	rjmp wait3
                                     
                                 	
                                     //if ((TWSR & 0xF8) !=
                                     //MT_DATA_ACK)
                                     //ERROR();
00014f 9100 00b9                 	lds r16,TWSR
000151 7f08                      	andi r16, 0xF8 
000152 3208                      	cpi r16, MT_DATA_ACK
000153 f499                      	brne ERROR2
                                 	//---------------------
                                 
                                 
                                 	//---------------------
                                     //TWDR = data; //
                                     //TWCR = (1<<TWINT) |
                                     //(1<<TWEN);
000154 2f04                          mov r16, DATA //ex. DATA
000155 9300 00bb                 	sts TWDR, r16
000157 e804                      	ldi r16, (1<<TWINT)|(1<<TWEN)
000158 9300 00bc                 	sts TWCR, r16
                                 
                                 	
                                     //while (!(TWCR & (1<<TWINT)))
                                     //;
                                 	wait5:
00015a 9100 00bc                 	lds r16,TWCR
00015c ff07                      	sbrs r16,TWINT
00015d cffc                      	rjmp wait5
                                     
                                 	
                                     //if ((TWSR & 0xF8) !=
                                     //MT_DATA_ACK)
                                     //ERROR();
00015e 9100 00b9                 	lds r16,TWSR
000160 7f08                      	andi r16, 0xF8
000161 3208                      	cpi r16, MT_DATA_ACK
000162 f421                      	brne ERROR2
                                 	//---------------------
                                 
                                 
                                     //TWCR = (1<<TWINT)|(1<<TWEN)|
                                     //(1<<TWSTO);
000163 e904                      	ldi r16,(1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
000164 9300 00bc                 	sts TWCR, r16
                                 
000166 9508                      ret
                                 
                                 
                                 ERROR2: 
                                 ;rcall LCD
000167 9508                      ret
                                 
                                 ;reads two bytes with the selected start register
                                 MAX30105Read://(byte command){
                                 
                                 
                                       //byte data;  
                                        
                                       //TWCR = (1<<TWINT)|(1<<TWSTA)|
                                       //(1<<TWEN); //Start Condition
000168 ea04                      	  ldi r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
000169 9300 00bc                 	  sts TWCR, r16
                                       
                                       //while (!(TWCR & (1<<TWINT)))
                                       //;
                                 	  wait6:
00016b 9100 00bc                 	  lds r16,TWCR
00016d ff07                      	  sbrs r16,TWINT
00016e cffc                      	  rjmp wait6
                                 
                                       
                                       //if ((TWSR & 0xF8) != START)
                                       //ERROR();
00016f 9100 00b9                 	  lds r16,TWSR
000171 7f08                      	  andi r16, 0xF8
000172 3008                      	  cpi r16, START
000173 f799                      	  brne ERROR2
                                       
                                 
                                 	  
                                       //TWDR = SLA_W;
                                       //TWCR = (1<<TWINT) |
                                       //(1<<TWEN);
000174 e702                      	  ldi r16, SLA_W
000175 9300 00bb                 	  sts TWDR, r16
000177 e804                      	  ldi r16, (1<<TWINT)|(1<<TWEN)
000178 9300 00bc                 	  sts TWCR, r16
                                       
                                 	  
                                       //while (!(TWCR & (1<<TWINT)))
                                       //;
                                       wait7:
00017a 9100 00bc                 	  lds r16,TWCR
00017c ff07                      	  sbrs r16,TWINT
00017d cffc                      	  rjmp wait7
                                 
                                 	 
                                       //if ((TWSR & 0xF8) !=
                                       //MT_SLA_ACK)
                                       //ERROR();
00017e 9100 00b9                 	  lds r16,TWSR
000180 7f08                      	  andi r16, 0xF8
000181 3108                      	  cpi r16, MT_SLA_ACK
000182 f721                      	  brne ERROR2
                                       
                                 	  //---------------------
                                     //TWDR = command; //
                                     //TWCR = (1<<TWINT) |
                                     //(1<<TWEN);
000183 2f03                          mov r16, COMMAND //ex. COMMAND
000184 9300 00bb                 	sts TWDR, r16
000186 e804                      	ldi r16, (1<<TWINT)|(1<<TWEN)
000187 9300 00bc                 	sts TWCR, r16
                                 
                                 	
                                     //while (!(TWCR & (1<<TWINT)))
                                     //;
                                 	wait8:
000189 9100 00bc                 	lds r16,TWCR
00018b ff07                      	sbrs r16,TWINT
00018c cffc                      	rjmp wait8
                                     
                                 	
                                     //if ((TWSR & 0xF8) !=
                                     //MT_DATA_ACK)
                                     //ERROR();
00018d 9100 00b9                 	lds r16,TWSR
00018f 7f08                      	andi r16, 0xF8
000190 3208                      	cpi r16, MT_DATA_ACK
000191 f6a9                      	brne ERROR2
                                 	//---------------------
                                 
                                 	
                                 	  
                                       //TWCR = (1<<TWINT)|(1<<TWSTA)|
                                       //(1<<TWEN); //Repeated Start Condition 
000192 ea04                            ldi r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
000193 9300 00bc                 	  sts TWCR, r16
                                 	  
                                 	  
                                       //while (!(TWCR & (1<<TWINT)))
                                       //;
                                       wait10:
000195 9100 00bc                 	  lds r16,TWCR
000197 ff07                      	  sbrs r16,TWINT
000198 cffc                      	  rjmp wait10
                                 
                                 	  
                                       //if ((TWSR & 0xF8) != R_START)
                                       //ERROR();
000199 9100 00b9                 	  lds r16,TWSR
00019b 7f08                      	  andi r16, 0xF8
00019c 3100                      	  cpi r16, R_START
00019d f511                      	  brne ERROR3
                                 
                                 
                                 
                                       
                                       
                                       //TWDR = SLA_R;
                                       //TWCR = (1<<TWINT) |
                                       //(1<<TWEN);
00019e e703                            ldi r16, SLA_R
00019f 9300 00bb                 	  sts TWDR, r16
0001a1 e804                      	  ldi r16, (1<<TWINT)|(1<<TWEN)
0001a2 9300 00bc                 	  sts TWCR, r16
                                 
                                 	  
                                       //while (!(TWCR & (1<<TWINT)))
                                       //;
                                 	  wait11:
0001a4 9100 00bc                 	  lds r16,TWCR
0001a6 ff07                      	  sbrs r16,TWINT
0001a7 cffc                      	  rjmp wait11
                                       
                                 	 
                                       //if ((TWSR & 0xF8) !=
                                       //MR_SLA_ACK)
                                       //ERROR();
0001a8 9100 00b9                 	  lds r16,TWSR
0001aa 7f08                      	  andi r16, 0xF8
0001ab 3400                      	  cpi r16, MR_SLA_ACK
0001ac f499                      	  brne ERROR3
                                 
                                 
                                 
                                 
                                       //TWCR = (1<<TWINT) |
                                       //(0<<TWEA)|(1<<TWEN); //Data byte will be received and 
                                                             //NOT ACK TWEA=0 will be returned
0001ad e804                            ldi r16, (1<<TWINT)|(0<<TWEA)|(1<<TWEN)
0001ae 9300 00bc                 	  sts TWCR, r16
                                 	  
                                 	  
                                       //while (!(TWCR & (1<<TWINT)))
                                       //;
                                 	  wait12:
0001b0 9100 00bc                 	  lds r16,TWCR
0001b2 ff07                      	  sbrs r16,TWINT
0001b3 cffc                      	  rjmp wait12
                                       
                                 	  
                                       //if ((TWSR & 0xF8) !=
                                       //MR_DATA_NOACK)
                                       //ERROR();
0001b4 9100 00b9                 	  lds r16,TWSR
0001b6 7f08                      	  andi r16, 0xF8
0001b7 3508                      	  cpi r16, MR_DATA_NOACK//MR_DATA_NOACK
0001b8 f439                      	  brne ERROR3
                                       
                                      
                                       //data = TWDR; //read data byte
0001b9 9100 00bb                       lds r16,TWDR
0001bb 2f40                      	  mov DATA,r16
                                 
                                       
                                       //TWCR = (1<<TWINT)|(1<<TWEN)|
                                       //(1<<TWSTO); // Send a Stop Condition
0001bc e904                            ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
0001bd 9300 00bc                 	  sts TWCR, r16
                                 
                                 	  
                                       //return data;
                                 
0001bf 9508                      ret
                                 
