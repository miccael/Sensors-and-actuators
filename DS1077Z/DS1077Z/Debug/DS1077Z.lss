                 DAC:
                 
                  //---------------------1-wire init Vcc powered device Overdrive Mode---------------
000342 d063      	rcall OWReset
000343 e30c      	ldi r16, 0x3C     //Overdrive skip ROM
000344 d07e      	rcall OWWriteByte
000345 ec0c      	ldi r16, 0xCC     //Write Conditional Search Register command
000346 d03b      	rcall OWWriteByteOD
000347 e80d      	ldi r16, 0x8D     //TA1 beginning adress
000348 d039      	rcall OWWriteByteOD
000349 e000      	ldi r16, 0x00     //TA2 adress 008Dh
00034a d037      	rcall OWWriteByteOD
00034b e801      	ldi r16, 0x81     //data byte adress 008Dh
00034c d035      	rcall OWWriteByteOD
                 	//---------------------1-wire init Vcc powered device Overdrive Mode---------------
                 
00034d d017      	rcall OWResetOD
00034e e30c      	ldi r16, 0x3C     //Overdrive skip ROM
00034f d032      	rcall OWWriteByteOD
000350 ef00      	ldi r16, 0xF0     //Read PIO Registers command
000351 d030      	rcall OWWriteByteOD
000352 e80d      	ldi r16, 0x8D     //TA1 beginning adress
000353 d02e      	rcall OWWriteByteOD
000354 e000      	ldi r16, 0x00     //TA2 adress 008Dh
000355 d02c      	rcall OWWriteByteOD
000356 d046      	rcall OWReadByteOD //Read Control/Status Register and verify
                 
000357 d00d      	rcall OWResetOD
000358 e30c      	ldi r16, 0x3C     //Overdrive skip ROM
000359 d028      	rcall OWWriteByteOD
00035a e50a      	ldi r16, 0x5A     //Channel-access Write command
00035b d026      	rcall OWWriteByteOD
00035c 2f02      	mov r16, r18     //Write byte to PIO
00035d d024      	rcall OWWriteByteOD
00035e 2f02      	mov r16, r18     //
00035f 9500      	com r16           //
                 	//ldi r16, 0xFF     //Write inverted byte to PIO
000360 d021      	rcall OWWriteByteOD
000361 d03b      	rcall OWReadByteOD //Read for verification (AAh = success)
000362 d03a      	rcall OWReadByteOD //Read PIO pin status
000363 d001      	rcall OWResetOD
                 	
000364 9508      ret
                 
                 
                 
                 ;-------------------Overdrive Mode Start---------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 ;------------------------------------------------------------------------------
                 ; Output : T - presence bit
                 ;------------------------------------------------------------------------------
                 OWResetOD:
000365 9859      	cbi		OW_PORT,OW_DQ
000366 9a51      	sbi		OW_DDR,OW_DQ
                 
000367 e0b1      	ldi		XH, HIGH(DVUS(55))
000368 e1a3      	ldi		XL, LOW(DVUS(55))
000369 dd01      	rcall	Wait4xCycles
                 	
00036a 9851      	cbi		OW_DDR,OW_DQ
                 
00036b e0b0      	ldi		XH, HIGH(DVUS(8))
00036c e2a8      	ldi		XL, LOW(DVUS(8))
00036d dcfd      	rcall	Wait4xCycles
                 
00036e 9468      	set
00036f 9b49      	sbis	OW_PIN,OW_DQ
000370 94e8      	clt
                 
000371 e0b0      	ldi		XH, HIGH(DVUS(48))
000372 efa0      	ldi		XL, LOW(DVUS(48))
000373 dcf7      	rcall	Wait4xCycles
                 
000374 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : C - bit to write
                 ;------------------------------------------------------------------------------
                 OWWriteBitOD:
000375 f418      	brcc	OWWriteZeroOD
000376 e0b0      	ldi		XH, HIGH(DVUS(1))//Måste Kalibreras
000377 e0a5      	ldi		XL, LOW(DVUS(1))//Måste Kalibreras
000378 c002      	rjmp	OWWriteOneOD
                 OWWriteZeroOD:	
000379 e0b0      	ldi		XH, HIGH(DVUS(10)) 
00037a e3a2      	ldi		XL, LOW(DVUS(10)) 
                 OWWriteOneOD:
00037b 9a51      	sbi		OW_DDR, OW_DQ
00037c dcee      	rcall	Wait4xCycles
00037d 9851      	cbi		OW_DDR, OW_DQ
                 	
00037e e0b0      	ldi		XH, HIGH(DVUS(10))
00037f e3a2      	ldi		XL, LOW(DVUS(10))
000380 dcea      	rcall	Wait4xCycles
000381 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : r16 - byte to write
                 ;------------------------------------------------------------------------------
                 OWWriteByteOD:
000382 931f      	push	OWCount
000383 e010      	ldi		OWCount,0
                 OWWriteLoopOD:	
000384 9507      	ror		r16
000385 dfef      	rcall	OWWriteBitOD	
000386 9513      	inc		OWCount
000387 3018      	cpi		OWCount,8
000388 f7d9      	brne	OWWriteLoopOD
000389 911f      	pop		OWCount		
00038a 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Output : C - bit from slave
                 ;------------------------------------------------------------------------------
                 OWReadBitOD:
00038b e0b0      	ldi		XH, HIGH(DVUS(1)) //Måste kalibreras
00038c e0a5      	ldi		XL, LOW(DVUS(1)) //Måste kalibreras
00038d 9a51      	sbi		OW_DDR, OW_DQ
00038e dcdc      	rcall	Wait4xCycles
00038f 9851      	cbi		OW_DDR, OW_DQ
000390 e0b0      	ldi		XH, HIGH(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent, 1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
000391 e0a5      	ldi		XL, LOW(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent,  1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
000392 dcd8      	rcall	Wait4xCycles
000393 94e8      	clt
000394 9949      	sbic	OW_PIN,OW_DQ
000395 9468      	set
000396 e0b0      	ldi		XH, HIGH(DVUS(10))
000397 e3a2      	ldi		XL, LOW(DVUS(10))
000398 dcd2      	rcall	Wait4xCycles
000399 9408      	sec
00039a f00e      	brts	OWReadBitEndOD
00039b 9488      	clc
                 OWReadBitEndOD:
00039c 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Output : r16 - byte from slave
                 ;------------------------------------------------------------------------------
                 OWReadByteOD:
00039d 931f      	push	OWCount
00039e e010      	ldi		OWCount,0
                 OWReadLoopOD:
00039f dfeb      	rcall	OWReadBitOD
0003a0 9507      	ror		r16
0003a1 9513      	inc		OWCount
0003a2 3018      	cpi		OWCount,8
0003a3 f7d9      	brne	OWReadLoopOD
0003a4 911f      	pop		OWCount
0003a5 9508      	ret
                 ;------------------------------------------------------------------------------
                 ;
                 ;------------------------------------------------------------------------------
                 
                 ;-------------------Overdrive Mode End-----------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 
                 
                 ;-------------------Standard Mode Start-----------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 ;------------------------------------------------------------------------------
                 ; Output : T - presence bit
                 ;------------------------------------------------------------------------------
                 OWReset:
0003a6 9859      	cbi		OW_PORT,OW_DQ
0003a7 9a51      	sbi		OW_DDR,OW_DQ
                 
0003a8 e0b9      	ldi		XH, HIGH(DVUS(470))
0003a9 e2ae      	ldi		XL, LOW(DVUS(470))
0003aa dcc0      	rcall	Wait4xCycles
                 	
0003ab 9851      	cbi		OW_DDR,OW_DQ
                 
0003ac e0b1      	ldi		XH, HIGH(DVUS(70))
0003ad e5ae      	ldi		XL, LOW(DVUS(70))
0003ae dcbc      	rcall	Wait4xCycles
                 
0003af 9468      	set
0003b0 9b49      	sbis	OW_PIN,OW_DQ
0003b1 94e8      	clt
                 
0003b2 e0b4      	ldi		XH, HIGH(DVUS(240))
0003b3 eba0      	ldi		XL, LOW(DVUS(240))
0003b4 dcb6      	rcall	Wait4xCycles
                 
0003b5 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : C - bit to write
                 ;------------------------------------------------------------------------------
                 OWWriteBit:
0003b6 f418      	brcc	OWWriteZero
0003b7 e0b0      	ldi		XH, HIGH(DVUS(1))
0003b8 e0a5      	ldi		XL, LOW(DVUS(1))
0003b9 c002      	rjmp	OWWriteOne
                 OWWriteZero:	
0003ba e0b1      	ldi		XH, HIGH(DVUS(70)) //Changed from 120
0003bb e5ae      	ldi		XL, LOW(DVUS(70)) //Changed from 120
                 OWWriteOne:
0003bc 9a51      	sbi		OW_DDR, OW_DQ
0003bd dcad      	rcall	Wait4xCycles
0003be 9851      	cbi		OW_DDR, OW_DQ
                 	
0003bf e0b1      	ldi		XH, HIGH(DVUS(60))
0003c0 e2ac      	ldi		XL, LOW(DVUS(60))
0003c1 dca9      	rcall	Wait4xCycles
0003c2 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : r16 - byte to write
                 ;------------------------------------------------------------------------------
                 OWWriteByte:
0003c3 931f      	push	OWCount
0003c4 e010      	ldi		OWCount,0
                 OWWriteLoop:	
0003c5 9507      	ror		r16
0003c6 dfef      	rcall	OWWriteBit	
0003c7 9513      	inc		OWCount
0003c8 3018      	cpi		OWCount,8
0003c9 f7d9      	brne	OWWriteLoop
0003ca 911f      	pop		OWCount		
0003cb 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Output : C - bit from slave
                 ;------------------------------------------------------------------------------
                 OWReadBit:
0003cc e0b0      	ldi		XH, HIGH(DVUS(1))
0003cd e0a5      	ldi		XL, LOW(DVUS(1))
0003ce 9a51      	sbi		OW_DDR, OW_DQ
0003cf dc9b      	rcall	Wait4xCycles
0003d0 9851      	cbi		OW_DDR, OW_DQ
0003d1 e0b0      	ldi		XH, HIGH(DVUS(8)) //Kolla så att sampling inte sker försent, max 15us tRD - READ VALID, pga oexakta tider, oscilloskop!
0003d2 e2a8      	ldi		XL, LOW(DVUS(8)) //Kolla så att sampling inte sker försent, max 15us tRD - READ VALID, pga oexakta tider, oscilloskop!
0003d3 dc97      	rcall	Wait4xCycles
0003d4 94e8      	clt
0003d5 9949      	sbic	OW_PIN,OW_DQ
0003d6 9468      	set
0003d7 e0b0      	ldi		XH, HIGH(DVUS(50))
0003d8 efaa      	ldi		XL, LOW(DVUS(50))
0003d9 dc91      	rcall	Wait4xCycles
0003da 9408      	sec
0003db f00e      	brts	OWReadBitEnd
0003dc 9488      	clc
                 OWReadBitEnd:
0003dd 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Output : r16 - byte from slave
                 ;------------------------------------------------------------------------------
                 OWReadByte:
0003de 931f      	push	OWCount
0003df e010      	ldi		OWCount,0
                 OWReadLoop:
0003e0 dfeb      	rcall	OWReadBit
0003e1 9507      	ror		r16
0003e2 9513      	inc		OWCount
0003e3 3018      	cpi		OWCount,8
0003e4 f7d9      	brne	OWReadLoop
0003e5 911f      	pop		OWCount
0003e6 9508      	ret
