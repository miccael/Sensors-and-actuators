                 .cseg
                 
                 
                 //---------System Clock init----------------
                   #define F_CPU 20000000 //
                  //---------System Clock init----------------
                  
                 	 
                 	
                 
000000 9a5c      	 sbi PORTD, PD4 //lit a LED on PD4
000001 9a54      	 sbi DDRD, PD4
                 	 
                  
000002 d1a2       rcall LCD
                 
                 	
                 
                 	
                 	//---------------I2C definitions and init----------------------
                 	//-------------------------------------------------------------
                 	
                 	.def COMMAND = r19
                 	.def DATA_MSB = r20
                 	.def DATA_LSB = r21
                 	.def DIV_MSB = r22
                 	.def DIV_LSB = r23
                 	.def DAT_MSB = r24
                 	.def DAT_LSB = r25
                 	.equ SLA_W = 0xB0 //0xB0 slave adress, 0x58 and R/W=0
                 	.equ SLA_R = 0xB1 //0xB1 slave adress, 0x58 and R/W=1 
                 	.equ START = 0x08
                 	.equ R_START = 0x10
                 	.equ MT_SLA_ACK = 0x18
                 	.equ MR_SLA_ACK = 0x40
                 	.equ MT_DATA_ACK = 0x28
                 	.equ MR_DATA_ACK = 0x50
                 	.equ MR_DATA_NOACK = 0x58
                 
                 
                 	
                 	//------------SCL speed-----------
000003 ef0f      	ldi r16, 0xFF
000004 9300 00b8 	sts TWBR, r16
000006 e003      	ldi r16, (1<<TWPS1)|(1<<TWPS0) //Prescaler 64
000007 9300 00b9 	sts TWSR, r16
                 	 //--------------------------------
                 
                 	 //Must be written to enable 2-wire serial interface
000009 e000      	 ldi r16, (0<<PRTWI)
00000a 9300 0064 	 sts PRR, r16
                 	 //---------------------------
                 
00000c e000      	 ldi r16, (0<<DDC4) //PC4 SDA [27] input
00000d b907      	 out DDRC, r16		//PC4 SDA [27] input
                 	 //---------------I2C definitions and init-----------------------
                 	 //--------------------------------------------------------------
                 	
00000e ec08      		ldi r16, 200
00000f d05e      		rcall	WaitMiliseconds //wait 
000010 ec08      		ldi r16, 200
000011 d05c      		rcall	WaitMiliseconds
000012 ec08      		ldi r16, 200
000013 d05a      		rcall	WaitMiliseconds //
000014 ec08      		ldi r16, 200
000015 d058      		rcall	WaitMiliseconds
                 
000016 e03d       ldi COMMAND, 0x0D //Access BUS [0D]
000017 e048       ldi DATA_MSB, 0b00001000 // WC=1, the EEPROM is only written when the “WRITE ” command is issued.
000018 d14f       rcall DS1077Z_BUS_Write
                 
000019 ec08      		ldi r16, 200
00001a d053      		rcall	WaitMiliseconds //wait
00001b ec08      		ldi r16, 200
00001c d051      		rcall	WaitMiliseconds
00001d ec08      		ldi r16, 200
00001e d04f      		rcall	WaitMiliseconds //
00001f ec08      		ldi r16, 200
000020 d04d      		rcall	WaitMiliseconds
                 		
000021 e032       ldi COMMAND, 0x02 //Access MUX [02]
000022 e14f       ldi DATA_MSB, 0b00011111 //PDN1=PDN0=0 no shutdown control, SEL0=1,EN0=1, 0M1=0M0=1 prescaler P0 8, 1M1=1
000023 e850       ldi DATA_LSB, 0b10000000 //1M0=1 prescaler P1 8, DIV1 = 0 (default) the N divider functions normally 
000024 d08e       rcall DS1077ZWrite
                 
000025 ec08      		ldi r16, 200
000026 d047      		rcall	WaitMiliseconds //wait
000027 ec08      		ldi r16, 200
000028 d045      		rcall	WaitMiliseconds
000029 ec08      		ldi r16, 200
00002a d043      		rcall	WaitMiliseconds //
00002b ec08      		ldi r16, 200
00002c d041      		rcall	WaitMiliseconds
                 		
00002d e031       ldi COMMAND, 0x01 //Access DIV [01]
00002e ef4f       ldi DATA_MSB, 0b11111111 //N9:N2 divisor N 
00002f ef5f       ldi DATA_LSB, 0b11111111 //N1:N0 divisor N 
000030 d082       rcall DS1077ZWrite
                 	
000031 ec08      		ldi r16, 200
000032 d03b      		rcall	WaitMiliseconds //wait
000033 ec08      		ldi r16, 200
000034 d039      		rcall	WaitMiliseconds
000035 ec08      		ldi r16, 200
000036 d037      		rcall	WaitMiliseconds //
000037 ec08      		ldi r16, 200
000038 d035      		rcall	WaitMiliseconds
                 
000039 e33f      ldi COMMAND, 0x3f //Write E2 [3F] lock in the MUX, BUS and DIV register contents in the EEPROM
00003a ef4f       ldi DATA_MSB, 0b11111111 // no needed in this case
00003b ef5f       ldi DATA_LSB, 0b11111111 // no needed in this case
00003c d076       rcall DS1077ZWrite
                 	
00003d ec08      		ldi r16, 200
00003e d02f      		rcall	WaitMiliseconds //wait
00003f ec08      		ldi r16, 200
000040 d02d      		rcall	WaitMiliseconds
000041 ec08      		ldi r16, 200
000042 d02b      		rcall	WaitMiliseconds //
000043 ec08      		ldi r16, 200
000044 d029      		rcall	WaitMiliseconds
                 	
                 
000045 e061      	ldi DIV_MSB, 0b00000001; reset DIV_MSB
                 ; Replace with your application code
                 main:
                 
                 		
                 		
                 	
                  //--------------------I2C DS1077Z---------------
000046 ec08      		ldi r16, 200
000047 d026      		rcall	WaitMiliseconds //wait
000048 ec08      		ldi r16, 200
000049 d024      		rcall	WaitMiliseconds
00004a ec08      		ldi r16, 200
00004b d022      		rcall	WaitMiliseconds //
00004c ec08      		ldi r16, 200
