                 #include "wait.asm" ; AVR Assembler v.2
                 
                  * wait.asm
                  *
                  *  Created: 2015-01-01 18:40:21
                  *   Author: Mikael
                  */ 
                 
                 
                 ;------------------------------------------------------------------------------
                 ; Busy-wait loops utilities module
                 ; For F_CPU >= 4MHz
                 ; http://avr-mcu.dxp.pl
                 ; (c) Radoslaw Kwiecien, 2008
                 ;------------------------------------------------------------------------------
                 
                 #ifndef F_CPU
                 #endif
                 
                 #if F_CPU < 4000000
                 #endif
                 
                 #define CYCLES_PER_US (F_CPU/1000000)
                 #define C4PUS (CYCLES_PER_US/4)
                 #define DVUS(x) (C4PUS*x)
                 
                 ;------------------------------------------------------------------------------
                 ; Input : XH:XL - number of CPU cycles to wait (divided by four)
                 ;------------------------------------------------------------------------------
                 Wait4xCycles:
00006b 9711        sbiw	  XH:XL, 1
00006c f7f1        brne	  Wait4xCycles
00006d 9508        ret
                 ;------------------------------------------------------------------------------
                 ; Input : r16 - number of miliseconds to wait
                 ;------------------------------------------------------------------------------
                 WaitMiliseconds:
00006e 930f        push	r16
                 WaitMsLoop: 
00006f e0b9        ldi	   XH,HIGH(DVUS(500))
000070 eca4        ldi	   XL,LOW(DVUS(500))
000071 dff9        rcall	 Wait4xCycles
000072 e0b9        ldi	   XH,HIGH(DVUS(500))
000073 eca4        ldi	   XL,LOW(DVUS(500))
000074 dff6        rcall	 Wait4xCycles
000075 950a        dec	   r16
000076 f7c1        brne	  WaitMsLoop
000077 910f        pop	   r16
000078 9508        ret
                 ;------------------------------------------------------------------------------
                 ; End of file
                  ;------------------------------------------------------------------------------
                 ; 1-wire definitions
                 ;------------------------------------------------------------------------------
                 .equ	OW_PORT	= PORTD
                 .equ	OW_PIN	= PIND
                 .equ	OW_DDR	= DDRD
                 .equ	OW_DQ	= PD1
                 
                 .def	OWCount = r17
                 ;------------------------------------------------------------------------------
                 ; 1-wire definitions
                 ;------------------------------------------------------------------------------
                 
                 
