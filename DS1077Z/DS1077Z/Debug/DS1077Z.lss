                 DS1077ZWrite://(byte command, byte data_msb, byte data_lsb){
                   
                  
                     //TWCR = (1<<TWINT)|(1<<TWSTA)|
                     //(1<<TWEN);
0000b3 ea04      	ldi r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
0000b4 9300 00bc 	sts TWCR, r16
                     
                     //while (!(TWCR & (1<<TWINT)))
                     ;
                     wait1:
0000b6 9100 00bc 	lds r16,TWCR
0000b8 ff07      	sbrs r16,TWINT
0000b9 cffc      	rjmp wait1
                 
                     //if ((TWSR & 0xF8) != START)
                     //ERROR();
0000ba 9100 00b9     lds r16,TWSR
0000bc 7f08      	andi r16, 0xF8
0000bd 3008      	cpi r16, START
0000be f799      	brne ERROR1
                 
                 	
                     //TWDR = SLA_W;
                     //TWCR = (1<<TWINT) |
                     //(1<<TWEN);
0000bf eb00      	ldi r16, SLA_W
0000c0 9300 00bb 	sts TWDR, r16
0000c2 e804      	ldi r16, (1<<TWINT)|(1<<TWEN)
0000c3 9300 00bc 	sts TWCR, r16
                     
                 	
                     //while (!(TWCR & (1<<TWINT)))
                     //;
                 	wait2:
0000c5 9100 00bc 	lds r16,TWCR
0000c7 ff07      	sbrs r16,TWINT
0000c8 cffc      	rjmp wait2
                 
                     
                     //if ((TWSR & 0xF8) !=
                     //MT_SLA_ACK)
                     //ERROR();
0000c9 9100 00b9 	lds r16,TWSR
0000cb 7f08      	andi r16, 0xF8
0000cc 3108      	cpi r16, MT_SLA_ACK
0000cd f721      	brne ERROR1
                 
                     
                 	
                 
                     //---------------------
                     //TWDR = command; //
                     //TWCR = (1<<TWINT) |
                     //(1<<TWEN);
0000ce 2f03          mov r16, COMMAND //ex. COMMAND
0000cf 9300 00bb 	sts TWDR, r16
0000d1 e804      	ldi r16, (1<<TWINT)|(1<<TWEN)
0000d2 9300 00bc 	sts TWCR, r16
                 
                 	
                     //while (!(TWCR & (1<<TWINT)))
                     //;
                 	wait3:
0000d4 9100 00bc 	lds r16,TWCR
0000d6 ff07      	sbrs r16,TWINT
0000d7 cffc      	rjmp wait3
                     
                 	
                     //if ((TWSR & 0xF8) !=
                     //MT_DATA_ACK)
                     //ERROR();
0000d8 9100 00b9 	lds r16,TWSR
0000da 7f08      	andi r16, 0xF8
0000db 3208      	cpi r16, MT_DATA_ACK
0000dc f511      	brne ERROR2
                 	//---------------------
                 
                    //----------------------------------------------------------------------------------------
                     //---------------------
                     //TWDR = data_msb; //
                     //TWCR = (1<<TWINT) |
                     //(1<<TWEN);
0000dd 2f04          mov r16, DATA_MSB //ex. DATA_MSB
0000de 9300 00bb 	sts TWDR, r16
0000e0 e804      	ldi r16, (1<<TWINT)|(1<<TWEN)
0000e1 9300 00bc 	sts TWCR, r16
                 
                 	
                     //while (!(TWCR & (1<<TWINT)))
                     //;
                 	wait4:
0000e3 9100 00bc 	lds r16,TWCR
0000e5 ff07      	sbrs r16,TWINT
0000e6 cffc      	rjmp wait4
                     
                 	
                     //if ((TWSR & 0xF8) !=
                     //MT_DATA_ACK)
                     //ERROR();
0000e7 9100 00b9 	lds r16,TWSR
0000e9 7f08      	andi r16, 0xF8
0000ea 3208      	cpi r16, MT_DATA_ACK
0000eb f499      	brne ERROR2
                 	//---------------------
                 
                 		
                 
                 	 //---------------------
                     //TWDR = data_lsb; //
                     //TWCR = (1<<TWINT) |
                     //(1<<TWEN);
0000ec 2f05          mov r16, DATA_LSB //ex. DATA_LSB
0000ed 9300 00bb 	sts TWDR, r16
0000ef e804      	ldi r16, (1<<TWINT)|(1<<TWEN)
0000f0 9300 00bc 	sts TWCR, r16
                 
                 	
                     //while (!(TWCR & (1<<TWINT)))
                     //;
                 	wait5:
0000f2 9100 00bc 	lds r16,TWCR
0000f4 ff07      	sbrs r16,TWINT
0000f5 cffc      	rjmp wait5
                     
                 	
                     //if ((TWSR & 0xF8) !=
                     //MT_DATA_ACK)
                     //ERROR();
0000f6 9100 00b9 	lds r16,TWSR
0000f8 7f08      	andi r16, 0xF8
0000f9 3208      	cpi r16, MT_DATA_ACK
0000fa f421      	brne ERROR2
                 	//---------------------
                     
                     
                 
                     //TWCR = (1<<TWINT)|(1<<TWEN)|
                     //(1<<TWSTO);
0000fb e904      	ldi r16,(1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
0000fc 9300 00bc 	sts TWCR, r16
                 
0000fe 9508      ret
                 
                 
                 ERROR2: 
                 ;rcall LCD
0000ff 9508      ret
                 
                 DS1077ZRead://(byte command){
                 
                 
                       //byte data;  
                        
                       //TWCR = (1<<TWINT)|(1<<TWSTA)|
                       //(1<<TWEN); //Start Condition
000100 ea04      	  ldi r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
000101 9300 00bc 	  sts TWCR, r16
                       
                       //while (!(TWCR & (1<<TWINT)))
                       //;
                 	  wait6:
000103 9100 00bc 	  lds r16,TWCR
000105 ff07      	  sbrs r16,TWINT
000106 cffc      	  rjmp wait6
                 
                       
                       //if ((TWSR & 0xF8) != START)
                       //ERROR();
000107 9100 00b9 	  lds r16,TWSR
000109 7f08      	  andi r16, 0xF8
00010a 3008      	  cpi r16, START
00010b f799      	  brne ERROR2
                       
                 
                 	  
                       //TWDR = SLA_W;
                       //TWCR = (1<<TWINT) |
                       //(1<<TWEN);
00010c eb00      	  ldi r16, SLA_W
00010d 9300 00bb 	  sts TWDR, r16
00010f e804      	  ldi r16, (1<<TWINT)|(1<<TWEN)
000110 9300 00bc 	  sts TWCR, r16
                       
                 	  
                       //while (!(TWCR & (1<<TWINT)))
                       //;
                       wait7:
000112 9100 00bc 	  lds r16,TWCR
000114 ff07      	  sbrs r16,TWINT
000115 cffc      	  rjmp wait7
                 
                 	 
                       //if ((TWSR & 0xF8) !=
                       //MT_SLA_ACK)
                       //ERROR();
000116 9100 00b9 	  lds r16,TWSR
000118 7f08      	  andi r16, 0xF8
000119 3108      	  cpi r16, MT_SLA_ACK
00011a f721      	  brne ERROR2
                       
                 	  //---------------------
                     //TWDR = command; //
                     //TWCR = (1<<TWINT) |
                     //(1<<TWEN);
00011b 2f03          mov r16, COMMAND //ex. COMMAND
00011c 9300 00bb 	sts TWDR, r16
00011e e804      	ldi r16, (1<<TWINT)|(1<<TWEN)
00011f 9300 00bc 	sts TWCR, r16
                 
                 	
                     //while (!(TWCR & (1<<TWINT)))
                     //;
                 	wait8:
000121 9100 00bc 	lds r16,TWCR
000123 ff07      	sbrs r16,TWINT
000124 cffc      	rjmp wait8
                     
                 	
                     //if ((TWSR & 0xF8) !=
                     //MT_DATA_ACK)
                     //ERROR();
000125 9100 00b9 	lds r16,TWSR
000127 7f08      	andi r16, 0xF8
000128 3208      	cpi r16, MT_DATA_ACK
000129 f6a9      	brne ERROR2
                 	//---------------------
                 
                      
                 	 
                       //TWCR = (1<<TWINT)|(1<<TWSTA)|
                       //(1<<TWEN); //Repeated Start Condition
00012a ea04            ldi r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
00012b 9300 00bc 	  sts TWCR, r16
                 	  
                 	  
                       //while (!(TWCR & (1<<TWINT)))
                       //;
                       wait9:
00012d 9100 00bc 	  lds r16,TWCR
00012f ff07      	  sbrs r16,TWINT
000130 cffc      	  rjmp wait9
                 
                 	  
                       //if ((TWSR & 0xF8) != R_START)
                       //ERROR();
000131 9100 00b9 	  lds r16,TWSR
000133 7f08      	  andi r16, 0xF8
000134 3100      	  cpi r16, R_START
000135 f589      	  brne ERROR3
                       
                       
                       //TWDR = SLA_R;
                       //TWCR = (1<<TWINT) |
                       //(1<<TWEN);
000136 eb01            ldi r16, SLA_R
000137 9300 00bb 	  sts TWDR, r16
000139 e804      	  ldi r16, (1<<TWINT)|(1<<TWEN)
00013a 9300 00bc 	  sts TWCR, r16
                 
                 	  
                       //while (!(TWCR & (1<<TWINT)))
                       //;
                 	  wait10:
00013c 9100 00bc 	  lds r16,TWCR
00013e ff07      	  sbrs r16,TWINT
00013f cffc      	  rjmp wait10
                       
                 	 
                       //if ((TWSR & 0xF8) !=
                       //MR_SLA_ACK)
                       //ERROR();
000140 9100 00b9 	  lds r16,TWSR
000142 7f08      	  andi r16, 0xF8
000143 3400      	  cpi r16, MR_SLA_ACK
000144 f511      	  brne ERROR3
                       
                       
                       //TWCR = (1<<TWINT) |
                       //(0<<TWEA)|(1<<TWEN); //Data byte will be received and 
                                             //ACK TWEA=1 will be returned
000145 ec04            ldi r16, (1<<TWINT)|(1<<TWEA)|(1<<TWEN)
000146 9300 00bc 	  sts TWCR, r16
                 	  
                 	  
                       //while (!(TWCR & (1<<TWINT)))
                       //;
                 	  wait11:
000148 9100 00bc 	  lds r16,TWCR
00014a ff07      	  sbrs r16,TWINT
00014b cffc      	  rjmp wait11
                       
                 	  
                       //if ((TWSR & 0xF8) !=
                       //MR_DATA_ACK)
                       //ERROR();
00014c 9100 00b9 	  lds r16,TWSR
00014e 7f08      	  andi r16, 0xF8
00014f 3500      	  cpi r16, MR_DATA_ACK
000150 f4b1      	  brne ERROR3
                       
                      
                       //data_msb = TWDR; //read data byte
000151 9100 00bb       lds r16,TWDR
000153 2f40      	  mov DATA_MSB,r16
                 
                 
                 	  //TWCR = (1<<TWINT) |
                       //(0<<TWEA)|(1<<TWEN); //Data byte will be received and 
                                             //NOT ACK TWEA=0 will be returned
000154 e804            ldi r16, (1<<TWINT)|(0<<TWEA)|(1<<TWEN)
000155 9300 00bc 	  sts TWCR, r16
                 	  
                 	  
                       //while (!(TWCR & (1<<TWINT)))
                       //;
                 	  wait12:
000157 9100 00bc 	  lds r16,TWCR
000159 ff07      	  sbrs r16,TWINT
00015a cffc      	  rjmp wait12
                       
                 	  
                       //if ((TWSR & 0xF8) !=
                       //MR_DATA_NOACK)
                       //ERROR();
00015b 9100 00b9 	  lds r16,TWSR
00015d 7f08      	  andi r16, 0xF8
00015e 3508      	  cpi r16, MR_DATA_NOACK
00015f f439      	  brne ERROR3
                       
                      
                       //data_lsb = TWDR; //read data byte
000160 9100 00bb       lds r16,TWDR
000162 2f50      	  mov DATA_LSB,r16
                 
                       
                       //TWCR = (1<<TWINT)|(1<<TWEN)|
                       //(1<<TWSTO); // Send a Stop Condition
000163 e904            ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
000164 9300 00bc 	  sts TWCR, r16
                 
                 	  
                       //return data;
                 
000166 9508      ret
                 
                 ERROR3:
                 ;rcall LCD
000167 9508      ret
                 
                 DS1077Z_BUS_Write://(byte command, byte data_msb){
                   
                  
                     //TWCR = (1<<TWINT)|(1<<TWSTA)|
                     //(1<<TWEN);
000168 ea04      	ldi r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
000169 9300 00bc 	sts TWCR, r16
                     
                     //while (!(TWCR & (1<<TWINT)))
                     ;
                     wait13:
00016b 9100 00bc 	lds r16,TWCR
00016d ff07      	sbrs r16,TWINT
00016e cffc      	rjmp wait13
                 
                     //if ((TWSR & 0xF8) != START)
                     //ERROR();
00016f 9100 00b9     lds r16,TWSR
000171 7f08      	andi r16, 0xF8
000172 3008      	cpi r16, START
000173 f799      	brne ERROR3
                 
                 	
                     //TWDR = SLA_W;
                     //TWCR = (1<<TWINT) |
                     //(1<<TWEN);
000174 eb00      	ldi r16, SLA_W
000175 9300 00bb 	sts TWDR, r16
000177 e804      	ldi r16, (1<<TWINT)|(1<<TWEN)
000178 9300 00bc 	sts TWCR, r16
                     
                 	
                     //while (!(TWCR & (1<<TWINT)))
                     //;
                 	wait14:
00017a 9100 00bc 	lds r16,TWCR
00017c ff07      	sbrs r16,TWINT
00017d cffc      	rjmp wait14
                 
                     
                     //if ((TWSR & 0xF8) !=
                     //MT_SLA_ACK)
                     //ERROR();
00017e 9100 00b9 	lds r16,TWSR
000180 7f08      	andi r16, 0xF8
000181 3108      	cpi r16, MT_SLA_ACK
000182 f721      	brne ERROR3
                 
                     
                 	
                 
                     //---------------------
                     //TWDR = command; //
                     //TWCR = (1<<TWINT) |
                     //(1<<TWEN);
000183 2f03          mov r16, COMMAND //ex. COMMAND
000184 9300 00bb 	sts TWDR, r16
000186 e804      	ldi r16, (1<<TWINT)|(1<<TWEN)
000187 9300 00bc 	sts TWCR, r16
                 
                 	
                     //while (!(TWCR & (1<<TWINT)))
                     //;
                 	wait15:
000189 9100 00bc 	lds r16,TWCR
00018b ff07      	sbrs r16,TWINT
00018c cffc      	rjmp wait15
                     
                 	
                     //if ((TWSR & 0xF8) !=
                     //MT_DATA_ACK)
                     //ERROR();
00018d 9100 00b9 	lds r16,TWSR
00018f 7f08      	andi r16, 0xF8
000190 3208      	cpi r16, MT_DATA_ACK
000191 f6a9      	brne ERROR3
                 	//---------------------
                 
                    //----------------------------------------------------------------------------------------
                     //---------------------
                     //TWDR = data_msb; //
                     //TWCR = (1<<TWINT) |
                     //(1<<TWEN);
000192 2f04          mov r16, DATA_MSB //ex. DATA_MSB
000193 9300 00bb 	sts TWDR, r16
000195 e804      	ldi r16, (1<<TWINT)|(1<<TWEN)
000196 9300 00bc 	sts TWCR, r16
                 
                 	
                     //while (!(TWCR & (1<<TWINT)))
                     //;
                 	wait16:
000198 9100 00bc 	lds r16,TWCR
00019a ff07      	sbrs r16,TWINT
00019b cffc      	rjmp wait16
                     
                 	
                     //if ((TWSR & 0xF8) !=
                     //MT_DATA_ACK)
                     //ERROR();
00019c 9100 00b9 	lds r16,TWSR
00019e 7f08      	andi r16, 0xF8
00019f 3208      	cpi r16, MT_DATA_ACK
0001a0 f631      	brne ERROR3
                 	//---------------------
                 
                 		
                     //TWCR = (1<<TWINT)|(1<<TWEN)|
                     //(1<<TWSTO);
0001a1 e904      	ldi r16,(1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
0001a2 9300 00bc 	sts TWCR, r16
                 
0001a4 9508      ret
                 
