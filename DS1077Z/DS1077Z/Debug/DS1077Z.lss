00004e e031       ldi COMMAND, 0x01 //Access DIV [01] 
00004f d0b0       rcall DS1077ZRead
000050 2f84       mov DAT_MSB, DATA_MSB //reading DIV register
000051 2f95       mov DAT_LSB, DATA_LSB //reading DIV register
                 
                 
000052 ec08      		ldi r16, 200
