                 ;------------------------------------------------------------------------------
                 ; Output : r16 - byte from slave
                 ;------------------------------------------------------------------------------
                 DAC:
                 
                  //---------------------1-wire init Vcc powered device Overdrive Mode---------------
0001bd d0cc      	rcall OWReset
0001be e30c      	ldi r16, 0x3C     //Overdrive skip ROM
0001bf d0e7      	rcall OWWriteByte
0001c0 ec0c      	ldi r16, 0xCC     //Write Conditional Search Register command
0001c1 d0a4      	rcall OWWriteByteOD
0001c2 e80d      	ldi r16, 0x8D     //TA1 beginning adress
0001c3 d0a2      	rcall OWWriteByteOD
0001c4 e000      	ldi r16, 0x00     //TA2 adress 008Dh
0001c5 d0a0      	rcall OWWriteByteOD
0001c6 e801      	ldi r16, 0x81     //data byte adress 008Dh
0001c7 d09e      	rcall OWWriteByteOD
                 	//---------------------1-wire init Vcc powered device Overdrive Mode---------------
                 
0001c8 d080      	rcall OWResetOD
0001c9 e30c      	ldi r16, 0x3C     //Overdrive skip ROM
0001ca d09b      	rcall OWWriteByteOD
0001cb ef00      	ldi r16, 0xF0     //Read PIO Registers command
0001cc d099      	rcall OWWriteByteOD
0001cd e80d      	ldi r16, 0x8D     //TA1 beginning adress
0001ce d097      	rcall OWWriteByteOD
0001cf e000      	ldi r16, 0x00     //TA2 adress 008Dh
0001d0 d095      	rcall OWWriteByteOD
0001d1 d0af      	rcall OWReadByteOD //Read Control/Status Register and verify
                 
0001d2 d076      	rcall OWResetOD
0001d3 e30c      	ldi r16, 0x3C     //Overdrive skip ROM
0001d4 d091      	rcall OWWriteByteOD
0001d5 e50a      	ldi r16, 0x5A     //Channel-access Write command
0001d6 d08f      	rcall OWWriteByteOD
0001d7 2f02      	mov r16, r18     //Write byte to PIO
0001d8 d08d      	rcall OWWriteByteOD
0001d9 2f02      	mov r16, r18     //
0001da 9500      	com r16           //
                 	//ldi r16, 0xFF     //Write inverted byte to PIO
0001db d08a      	rcall OWWriteByteOD
0001dc d0a4      	rcall OWReadByteOD //Read for verification (AAh = success)
0001dd d0a3      	rcall OWReadByteOD //Read PIO pin status
0001de d06a      	rcall OWResetOD
                 	
0001df 9508      ret
                 
                 ;------------------------------------------------------------------------------
                 ; Output : r16 - byte from slave
                 ;------------------------------------------------------------------------------
                 SENSOR_DS1822:
                 
0001e0 d0ea      	rcall OWResetDS1822
0001e1 ec0c      	ldi r16, 0xCC     //skip ROM
0001e2 d105      	rcall OWWriteByteDS1822
0001e3 e40e      	ldi r16, 0x4E     //Master issues Write Scratchpad command
0001e4 d103      	rcall OWWriteByteDS1822
0001e5 e400      	ldi r16, 0b01000000     //Master sends three data bytes to scratchpad (TH, TL, and config) [TH] S=0 positive numbers
0001e6 d101      	rcall OWWriteByteDS1822
0001e7 e008      	ldi r16, 0b00001000     // [TL] S=0 positive numbers
0001e8 d0ff      	rcall OWWriteByteDS1822
0001e9 e10f      	ldi r16, 0b00011111     // [CONFIGURATION REGISTER] 9-bit resolution, 93.75ms conversion time
0001ea d0fd      	rcall OWWriteByteDS1822
                 
0001eb d0df      	rcall OWResetDS1822
0001ec ec0c      	ldi r16, 0xCC     //skip ROM
0001ed d0fa      	rcall OWWriteByteDS1822
0001ee eb0e      	ldi r16, 0xBE     //Master issues Read Scratchpad command.
0001ef d0f8      	rcall OWWriteByteDS1822
0001f0 d112      	rcall OWReadByteDS1822 //Read 9 Byte
0001f1 d111      	rcall OWReadByteDS1822 //
0001f2 d110      	rcall OWReadByteDS1822 //
0001f3 d10f      	rcall OWReadByteDS1822 //
0001f4 d10e      	rcall OWReadByteDS1822 //
0001f5 d10d      	rcall OWReadByteDS1822 //
0001f6 d10c      	rcall OWReadByteDS1822 //
0001f7 d10b      	rcall OWReadByteDS1822 //
0001f8 d10a      	rcall OWReadByteDS1822 //
                 
0001f9 d0d1      	rcall OWResetDS1822
0001fa ec0c      	ldi r16, 0xCC     //skip ROM
0001fb d0ec      	rcall OWWriteByteDS1822
0001fc e408      	ldi r16, 0x48     //Master issues Copy Scratchpad command
0001fd d0ea      	rcall OWWriteByteDS1822
0001fe e00c      	ldi r16, 12
0001ff de15      	rcall	WaitMiliseconds //Master applies strong pullup to DQ for at least 10ms while copy operation is in progress
                 
000200 d0ca      	rcall OWResetDS1822
000201 ec0c      	ldi r16, 0xCC     //skip ROM
000202 d0e5      	rcall OWWriteByteDS1822
000203 e404      	ldi r16, 0x44     //Master issues Convert T command
000204 d0e3      	rcall OWWriteByteDS1822
000205 e604      	ldi r16, 100
000206 de0e      	rcall	WaitMiliseconds //Master applies strong pullup to DQ for the duration of the conversion (tconv)
                 
000207 d0c3      	rcall OWResetDS1822
000208 ec0c      	ldi r16, 0xCC     //skip ROM
000209 d0de      	rcall OWWriteByteDS1822
00020a eb0e      	ldi r16, 0xBE     //Master issues Read Scratchpad command
00020b d0dc      	rcall OWWriteByteDS1822
00020c d0f6      	rcall OWReadByteDS1822 //Read 2 Byte, Temperature LSB
00020d d0f5      	rcall OWReadByteDS1822 // Temperature MSB
00020e 2f30      	mov r19, r16
00020f 0f33      	lsl r19
000210 0f33      	lsl r19
000211 0f33      	lsl r19
                 
                 
                 
                 
000212 e020      	ldi r18, 0b00000000 //format RS:E:D7:D6:D5:D4:N/A:N/A Clear Display
000213 dfa9      rcall DAC
000214 ec08      	ldi r16, 200
000215 ddff      	rcall	WaitMiliseconds
000216 e420      ldi r18, 0b01000000 //format RS:E:D7:D6:D5:D4:N/A:N/A
000217 dfa5      rcall DAC
000218 ec08      	ldi r16, 200
000219 ddfb      	rcall	WaitMiliseconds
00021a e020      ldi r18, 0b00000000 //format RS:E:D7:D6:D5:D4:N/A:N/A
00021b dfa1      rcall DAC
00021c ec08      	ldi r16, 200
00021d ddf7      	rcall	WaitMiliseconds
00021e e024      ldi r18, 0b00000100 //format RS:E:D7:D6:D5:D4:N/A:N/A 
00021f df9d      rcall DAC
000220 ec08      	ldi r16, 200
000221 ddf3      	rcall	WaitMiliseconds
000222 e424      ldi r18, 0b01000100 //format RS:E:D7:D6:D5:D4:N/A:N/A
000223 df99      rcall DAC
000224 ec08      	ldi r16, 200
000225 ddef      	rcall	WaitMiliseconds
