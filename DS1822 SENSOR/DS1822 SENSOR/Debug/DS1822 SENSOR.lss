                  //---------System Clock init----------------
                   #define F_CPU 16000000
                 
                  //ldi r16, 0xFF
                  //out OSCCAL, r16
                 
                 /* ldi r16,(1<<CLKPS3)|(0<<CLKPS2)|(0<<CLKPS1)|(0<<CLKPS0)
                  out CLKPR, r16 //prescaler 256*/
                  //---------System Clock init----------------
                  
                  
                  //-------------------ADC init------------------------------------------------------------------------------
000000 e000       ldi r16, (0<<PRADC)
000001 9300 0064  sts PRR, r16 //Power Reduction ADC bit disabled
                  
000003 e600       ldi r16, (0<<REFS1)|(1<<REFS0)|(1<<ADLAR)|(0<<MUX3)|(0<<MUX2)|(0<<MUX1)|(0<<MUX0) 
000004 9300 007c  sts ADMUX, r16 ;AVCC with external capacitor at AREF pin, result left adjusted, ADC0/PC0 [23] input channel 
                 
000006 e807       ldi r16, (1<<ADEN)|(0<<ADSC)|(0<<ADATE)|(0<<ADIF)|(0<<ADIE)|(1<<ADPS2)|(1<<ADPS1)|(1<<ADPS0) 
000007 9300 007a  sts ADCSRA, r16 ;ADC Disable, ADC not start conversion, ADC Auto Trigger Enable, ADC Prescaler Select Bits 128
                 
                 
000009 e007       ldi r16, (1<<ADTS2)|(1<<ADTS1)|(1<<ADTS0)
00000a 9300 007b  sts ADCSRB, r16 ;ADC Auto Trigger Source: Free Running Mode (Temporarily Disabled)
                 
00000c e000       ldi r16, (0<<ADC0D)
00000d 9300 007e  sts DIDR0, r16 ;ADC5D..ADC0D: ADC5..0 Digital Input Enabled: on ADC0
                  //-------------------ADC init------------------------------------------------------------------------------
                  
00000f d010       rcall LCD
                 
                  Main:
                 
                  /*
                  //------------------ADC method-----------------------
                  ldi r16, (1<<ADEN)|(1<<ADSC)|(0<<ADATE)|(0<<ADIF)|(0<<ADIE)|(1<<ADPS2)|(1<<ADPS1)|(1<<ADPS0)
                  sts ADCSRA, r16 //ADC Conversion Started
                  loop:
                  lds r16, ADCSRA
                  sbrc r16, ADIF
                  rjmp loop
                  
                  
                  lds r18, ADCH
                  rcall DAC
                  
                  
                  ldi r16, (1<<ADEN)|(0<<ADSC)|(0<<ADATE)|(1<<ADIF)|(0<<ADIE)|(1<<ADPS2)|(1<<ADPS1)|(1<<ADPS0)
                  sts ADCSRA, r16 //ADC Flag cleared
                 //------------------ADC method-----------------------
                 */
                 
                 
                 
                 
000010 d1cf      	rcall SENSOR_DS1822
                 	
                 
                 
                  
                 	
                 
000011 cffe      	rjmp Main
                 
                 
                  #include "wait.asm" ; AVR Assembler v.2
                 
                  * wait.asm
                  *
                  *  Created: 2015-01-01 18:40:21
                  *   Author: Mikael
                  */ 
                 
                 
                 ;------------------------------------------------------------------------------
                 ; Busy-wait loops utilities module
                 ; For F_CPU >= 4MHz
                 ; http://avr-mcu.dxp.pl
                 ; (c) Radoslaw Kwiecien, 2008
                 ;------------------------------------------------------------------------------
                 
                 #ifndef F_CPU
                 #endif
                 
                 #if F_CPU < 4000000
                 #endif
                 
                 #define CYCLES_PER_US (F_CPU/1000000)
                 #define C4PUS (CYCLES_PER_US/4)
                 #define DVUS(x) (C4PUS*x)
                 
                 ;------------------------------------------------------------------------------
                 ; Input : XH:XL - number of CPU cycles to wait (divided by four)
                 ;------------------------------------------------------------------------------
                 Wait4xCycles:
000012 9711        sbiw	  XH:XL, 1
000013 f7f1        brne	  Wait4xCycles
000014 9508        ret
                 ;------------------------------------------------------------------------------
                 ; Input : r16 - number of miliseconds to wait
                 ;------------------------------------------------------------------------------
                 WaitMiliseconds:
000015 930f        push	r16
                 WaitMsLoop: 
000016 e0b7        ldi	   XH,HIGH(DVUS(500))
000017 eda0        ldi	   XL,LOW(DVUS(500))
000018 dff9        rcall	 Wait4xCycles
000019 e0b7        ldi	   XH,HIGH(DVUS(500))
00001a eda0        ldi	   XL,LOW(DVUS(500))
00001b dff6        rcall	 Wait4xCycles
00001c 950a        dec	   r16
00001d f7c1        brne	  WaitMsLoop
00001e 910f        pop	   r16
00001f 9508        ret
                 ;------------------------------------------------------------------------------
                 ; End of file
                  ;------------------------------------------------------------------------------
                 ; 1-wire definitions
                 ;------------------------------------------------------------------------------
                 .equ	OW_PORT	= PORTD
                 .equ	OW_PIN	= PIND
                 .equ	OW_DDR	= DDRD
                 .equ	OW_DQ	= PD1
                 
                 .def	OWCount = r17
                 ;------------------------------------------------------------------------------
                 ; 1-wire definitions
                 ;------------------------------------------------------------------------------
                 
                 
                 ;------------------------------------------------------------------------------
                 ; 1-wire definitions DS1822
                 ;------------------------------------------------------------------------------
                 .equ	OW_PORT_DS1822	= PORTD
                 .equ	OW_PIN_DS1822	= PIND
                 .equ	OW_DDR_DS1822	= DDRD
                 .equ	OW_DQ_DS1822	= PD2
                 
                 //.def	OWCount = r17
                 ;------------------------------------------------------------------------------
                 ; 1-wire definitions DS1822
                 ;------------------------------------------------------------------------------
                 
                 
                 .cseg
                 
