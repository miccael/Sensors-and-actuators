                 ;-------------------Overdrive Mode Start---------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 ;------------------------------------------------------------------------------
                 ; Output : T - presence bit
                 ;------------------------------------------------------------------------------
                 OWResetOD:
000249 9859      	cbi		OW_PORT,OW_DQ
00024a 9a51      	sbi		OW_DDR,OW_DQ
                 
00024b e0b0      	ldi		XH, HIGH(DVUS(55))
00024c edac      	ldi		XL, LOW(DVUS(55))
00024d ddc4      	rcall	Wait4xCycles
                 	
00024e 9851      	cbi		OW_DDR,OW_DQ
                 
00024f e0b0      	ldi		XH, HIGH(DVUS(8))
000250 e2a0      	ldi		XL, LOW(DVUS(8))
000251 ddc0      	rcall	Wait4xCycles
                 
000252 9468      	set
000253 9b49      	sbis	OW_PIN,OW_DQ
000254 94e8      	clt
                 
000255 e0b0      	ldi		XH, HIGH(DVUS(48))
000256 eca0      	ldi		XL, LOW(DVUS(48))
000257 ddba      	rcall	Wait4xCycles
                 
000258 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : C - bit to write
                 ;------------------------------------------------------------------------------
                 OWWriteBitOD:
000259 f418      	brcc	OWWriteZeroOD
00025a e0b0      	ldi		XH, HIGH(DVUS(1))//Måste Kalibreras
00025b e0a4      	ldi		XL, LOW(DVUS(1))//Måste Kalibreras
00025c c002      	rjmp	OWWriteOneOD
                 OWWriteZeroOD:	
00025d e0b0      	ldi		XH, HIGH(DVUS(10)) 
00025e e2a8      	ldi		XL, LOW(DVUS(10)) 
                 OWWriteOneOD:
00025f 9a51      	sbi		OW_DDR, OW_DQ
000260 ddb1      	rcall	Wait4xCycles
000261 9851      	cbi		OW_DDR, OW_DQ
                 	
000262 e0b0      	ldi		XH, HIGH(DVUS(10))
000263 e2a8      	ldi		XL, LOW(DVUS(10))
000264 ddad      	rcall	Wait4xCycles
000265 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : r16 - byte to write
                 ;------------------------------------------------------------------------------
                 OWWriteByteOD:
000266 931f      	push	OWCount
000267 e010      	ldi		OWCount,0
                 OWWriteLoopOD:	
000268 9507      	ror		r16
000269 dfef      	rcall	OWWriteBitOD	
00026a 9513      	inc		OWCount
00026b 3018      	cpi		OWCount,8
00026c f7d9      	brne	OWWriteLoopOD
00026d 911f      	pop		OWCount		
00026e 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Output : C - bit from slave
                 ;------------------------------------------------------------------------------
                 OWReadBitOD:
00026f e0b0      	ldi		XH, HIGH(DVUS(1)) //Måste kalibreras
000270 e0a4      	ldi		XL, LOW(DVUS(1)) //Måste kalibreras
000271 9a51      	sbi		OW_DDR, OW_DQ
000272 dd9f      	rcall	Wait4xCycles
000273 9851      	cbi		OW_DDR, OW_DQ
000274 e0b0      	ldi		XH, HIGH(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent, 1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
000275 e0a4      	ldi		XL, LOW(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent,  1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
000276 dd9b      	rcall	Wait4xCycles
000277 94e8      	clt
000278 9949      	sbic	OW_PIN,OW_DQ
000279 9468      	set
00027a e0b0      	ldi		XH, HIGH(DVUS(10))
00027b e2a8      	ldi		XL, LOW(DVUS(10))
00027c dd95      	rcall	Wait4xCycles
00027d 9408      	sec
00027e f00e      	brts	OWReadBitEndOD
00027f 9488      	clc
                 OWReadBitEndOD:
000280 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Output : r16 - byte from slave
                 ;------------------------------------------------------------------------------
                 OWReadByteOD:
000281 931f      	push	OWCount
000282 e010      	ldi		OWCount,0
                 OWReadLoopOD:
000283 dfeb      	rcall	OWReadBitOD
000284 9507      	ror		r16
000285 9513      	inc		OWCount
000286 3018      	cpi		OWCount,8
000287 f7d9      	brne	OWReadLoopOD
000288 911f      	pop		OWCount
000289 9508      	ret
                 ;------------------------------------------------------------------------------
                 ;
                 ;------------------------------------------------------------------------------
                 
                 
                 
                 ;-------------------Overdrive Mode End-----------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 
                 ;-------------------Standard Mode Start-----------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 ;------------------------------------------------------------------------------
                 ; Output : T - presence bit
                 ;------------------------------------------------------------------------------
                 OWReset:
00028a 9859      	cbi		OW_PORT,OW_DQ
00028b 9a51      	sbi		OW_DDR,OW_DQ
                 
00028c e0b7      	ldi		XH, HIGH(DVUS(470))
00028d e5a8      	ldi		XL, LOW(DVUS(470))
00028e dd83      	rcall	Wait4xCycles
                 	
00028f 9851      	cbi		OW_DDR,OW_DQ
                 
000290 e0b1      	ldi		XH, HIGH(DVUS(70))
000291 e1a8      	ldi		XL, LOW(DVUS(70))
000292 dd7f      	rcall	Wait4xCycles
                 
000293 9468      	set
000294 9b49      	sbis	OW_PIN,OW_DQ
000295 94e8      	clt
                 
000296 e0b3      	ldi		XH, HIGH(DVUS(240))
000297 eca0      	ldi		XL, LOW(DVUS(240))
000298 dd79      	rcall	Wait4xCycles
                 
000299 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : C - bit to write
                 ;------------------------------------------------------------------------------
                 OWWriteBit:
00029a f418      	brcc	OWWriteZero
00029b e0b0      	ldi		XH, HIGH(DVUS(1))
00029c e0a4      	ldi		XL, LOW(DVUS(1))
00029d c002      	rjmp	OWWriteOne
                 OWWriteZero:	
00029e e0b1      	ldi		XH, HIGH(DVUS(70)) //Changed from 120
00029f e1a8      	ldi		XL, LOW(DVUS(70)) //Changed from 120
                 OWWriteOne:
0002a0 9a51      	sbi		OW_DDR, OW_DQ
0002a1 dd70      	rcall	Wait4xCycles
0002a2 9851      	cbi		OW_DDR, OW_DQ
                 	
0002a3 e0b0      	ldi		XH, HIGH(DVUS(60))
0002a4 efa0      	ldi		XL, LOW(DVUS(60))
0002a5 dd6c      	rcall	Wait4xCycles
0002a6 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : r16 - byte to write
                 ;------------------------------------------------------------------------------
                 OWWriteByte:
0002a7 931f      	push	OWCount
0002a8 e010      	ldi		OWCount,0
                 OWWriteLoop:	
0002a9 9507      	ror		r16
0002aa dfef      	rcall	OWWriteBit	
0002ab 9513      	inc		OWCount
0002ac 3018      	cpi		OWCount,8
0002ad f7d9      	brne	OWWriteLoop
0002ae 911f      	pop		OWCount		
0002af 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Output : C - bit from slave
                 ;------------------------------------------------------------------------------
                 OWReadBit:
0002b0 e0b0      	ldi		XH, HIGH(DVUS(1))
0002b1 e0a4      	ldi		XL, LOW(DVUS(1))
0002b2 9a51      	sbi		OW_DDR, OW_DQ
0002b3 dd5e      	rcall	Wait4xCycles
0002b4 9851      	cbi		OW_DDR, OW_DQ
0002b5 e0b0      	ldi		XH, HIGH(DVUS(8)) //Kolla så att sampling inte sker försent, max 15us tRD - READ VALID, pga oexakta tider, oscilloskop!
0002b6 e2a0      	ldi		XL, LOW(DVUS(8)) //Kolla så att sampling inte sker försent, max 15us tRD - READ VALID, pga oexakta tider, oscilloskop!
0002b7 dd5a      	rcall	Wait4xCycles
0002b8 94e8      	clt
0002b9 9949      	sbic	OW_PIN,OW_DQ
0002ba 9468      	set
0002bb e0b0      	ldi		XH, HIGH(DVUS(50))
0002bc eca8      	ldi		XL, LOW(DVUS(50))
0002bd dd54      	rcall	Wait4xCycles
0002be 9408      	sec
0002bf f00e      	brts	OWReadBitEnd
0002c0 9488      	clc
                 OWReadBitEnd:
0002c1 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Output : r16 - byte from slave
                 ;------------------------------------------------------------------------------
                 OWReadByte:
0002c2 931f      	push	OWCount
0002c3 e010      	ldi		OWCount,0
                 OWReadLoop:
0002c4 dfeb      	rcall	OWReadBit
0002c5 9507      	ror		r16
0002c6 9513      	inc		OWCount
0002c7 3018      	cpi		OWCount,8
0002c8 f7d9      	brne	OWReadLoop
0002c9 911f      	pop		OWCount
0002ca 9508      	ret
                 ;------------------------------------------------------------------------------
                 ;
                 ;------------------------------------------------------------------------------
                 
                 ;-------------------Standard Mode End------------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 
                 
                 
                 ;-------------------Standard Mode Start DS1822-----------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 ;------------------------------------------------------------------------------
                 ; Output : T - presence bit
                 ;------------------------------------------------------------------------------
                 OWResetDS1822:
0002cb 985a      	cbi		OW_PORT_DS1822, OW_DQ_DS1822
0002cc 9a52      	sbi		OW_DDR_DS1822, OW_DQ_DS1822
                 
0002cd e0b7      	ldi		XH, HIGH(DVUS(480))
0002ce e8a0      	ldi		XL, LOW(DVUS(480))
0002cf dd42      	rcall	Wait4xCycles
                 	
0002d0 9852      	cbi		OW_DDR_DS1822, OW_DQ_DS1822
                 
0002d1 e0b1      	ldi		XH, HIGH(DVUS(70))
0002d2 e1a8      	ldi		XL, LOW(DVUS(70))
