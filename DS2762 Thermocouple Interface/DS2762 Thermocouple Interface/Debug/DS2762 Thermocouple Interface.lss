                 #if F_CPU < 4000000
                 #endif
                 
                 #define CYCLES_PER_US (F_CPU/1000000)
                 #define C4PUS (CYCLES_PER_US/4)
                 #define DVUS(x) (C4PUS*x)
                 
                 ;------------------------------------------------------------------------------
                 ; Input : XH:XL - number of CPU cycles to wait (divided by four)
                 ;------------------------------------------------------------------------------
                 Wait4xCycles:
000004 9711        sbiw	  XH:XL, 1
000005 f7f1        brne	  Wait4xCycles
000006 9508        ret
                 ;------------------------------------------------------------------------------
                 ; Input : r16 - number of miliseconds to wait
                 ;------------------------------------------------------------------------------
                 WaitMiliseconds:
000007 930f        push	r16
                 WaitMsLoop: 
000008 e0b9        ldi	   XH,HIGH(DVUS(500))
000009 eca4        ldi	   XL,LOW(DVUS(500))
00000a dff9        rcall	 Wait4xCycles
00000b e0b9        ldi	   XH,HIGH(DVUS(500))
00000c eca4        ldi	   XL,LOW(DVUS(500))
00000d dff6        rcall	 Wait4xCycles
00000e 950a        dec	   r16
00000f f7c1        brne	  WaitMsLoop
000010 910f        pop	   r16
000011 9508        ret
                 ;------------------------------------------------------------------------------
                 ; End of file
                  ;------------------------------------------------------------------------------
                 ; 1-wire definitions
                 ;------------------------------------------------------------------------------
                 .equ	OW_PORT	= PORTD
                 .equ	OW_PIN	= PIND
