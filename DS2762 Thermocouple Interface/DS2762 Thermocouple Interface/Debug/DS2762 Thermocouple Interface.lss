                 DAC:
                 
                  //---------------------1-wire init Vcc powered device Overdrive Mode---------------
0000a5 d0af      	rcall OWReset
0000a6 e30c      	ldi r16, 0x3C     //Overdrive skip ROM
0000a7 d0ca      	rcall OWWriteByte
0000a8 ec0c      	ldi r16, 0xCC     //Write Conditional Search Register command
0000a9 d087      	rcall OWWriteByteOD
0000aa e80d      	ldi r16, 0x8D     //TA1 beginning adress
0000ab d085      	rcall OWWriteByteOD
0000ac e000      	ldi r16, 0x00     //TA2 adress 008Dh
0000ad d083      	rcall OWWriteByteOD
0000ae e801      	ldi r16, 0x81     //data byte adress 008Dh
0000af d081      	rcall OWWriteByteOD
                 	//---------------------1-wire init Vcc powered device Overdrive Mode---------------
                 
0000b0 d063      	rcall OWResetOD
0000b1 e30c      	ldi r16, 0x3C     //Overdrive skip ROM
0000b2 d07e      	rcall OWWriteByteOD
0000b3 ef00      	ldi r16, 0xF0     //Read PIO Registers command
0000b4 d07c      	rcall OWWriteByteOD
0000b5 e80d      	ldi r16, 0x8D     //TA1 beginning adress
0000b6 d07a      	rcall OWWriteByteOD
0000b7 e000      	ldi r16, 0x00     //TA2 adress 008Dh
0000b8 d078      	rcall OWWriteByteOD
0000b9 d092      	rcall OWReadByteOD //Read Control/Status Register and verify
                 
0000ba d059      	rcall OWResetOD
0000bb e30c      	ldi r16, 0x3C     //Overdrive skip ROM
0000bc d074      	rcall OWWriteByteOD
0000bd e50a      	ldi r16, 0x5A     //Channel-access Write command
0000be d072      	rcall OWWriteByteOD
0000bf 2f02      	mov r16, r18     //Write byte to PIO
0000c0 d070      	rcall OWWriteByteOD
0000c1 2f02      	mov r16, r18     //
0000c2 9500      	com r16           //
                 	//ldi r16, 0xFF     //Write inverted byte to PIO
0000c3 d06d      	rcall OWWriteByteOD
0000c4 d087      	rcall OWReadByteOD //Read for verification (AAh = success)
0000c5 d086      	rcall OWReadByteOD //Read PIO pin status
0000c6 d04d      	rcall OWResetOD
                 	
0000c7 9508      ret
                 
                 ;------------------------------------------------------------------------------
                 ; Output : r16 - byte from slave
                 ;------------------------------------------------------------------------------
                 SENSOR_DS2762:
                 
                 	
                 
                 	
                 
0000c8 d0cd      	rcall OWResetDS2762
0000c9 ec0c      	ldi r16, 0xCC     //skip ROM
0000ca d0e8      	rcall OWWriteByteDS2762
0000cb e60c      	ldi r16, 0x6C     //Master issues a Write Data command.
0000cc d0e6      	rcall OWWriteByteDS2762
0000cd e000      	ldi r16, 0x00     //Master sends the starting memory address.
0000ce d0e4      	rcall OWWriteByteDS2762
0000cf e001      	ldi r16, 0b00000001    //DE=1 bit 0 [pin 3], Protection Register Format  Writing a 0 to this bit disables charging (DE output high, external charge FET off)
0000d0 d0e2      	rcall OWWriteByteDS2762
                 	
                 
                 
0000d1 d0c4      	rcall OWResetDS2762
0000d2 ec0c      	ldi r16, 0xCC     //skip ROM
0000d3 d0df      	rcall OWWriteByteDS2762
0000d4 e609      	ldi r16, 0x69     //Master issues a Read Data command.
0000d5 d0dd      	rcall OWWriteByteDS2762
0000d6 e00e      	ldi r16, 0x0E     //Master sends the starting memory address.
0000d7 d0db      	rcall OWWriteByteDS2762
0000d8 d0f5      	rcall OWReadByteDS2762 //Read 1 Byte (Current Register MSB)
                 	;rcall OWReadByteDS2762
                 
0000d9 2f50      	mov DATA, r16
                 	
                 	
                 
                 	
0000da 9508      ret
                 
                 LCDwrite:
0000db e020      	ldi r18, 0b00000000 //format RS:E:D7:D6:D5:D4:N/A:N/A Clear Display
0000dc dfc8      	rcall DAC
0000dd ec08      		ldi r16, 200
