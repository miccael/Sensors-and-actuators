                  //---------System Clock init----------------
                   #define F_CPU 20000000
                 
                  //---------System Clock init----------------
                  
                  
                 
                  
000000 d011       rcall LCD
                 
                  Main:
                 
                  
                 
                 
                 
                 
000001 d0c6      	rcall SENSOR_DS2762
000002 d0d8      	rcall LCDwrite
                 
                 
                  
                 	
                 
000003 cffd      	rjmp Main
                 
                 
