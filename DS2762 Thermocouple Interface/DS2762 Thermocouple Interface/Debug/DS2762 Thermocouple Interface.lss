00010c defa      		rcall	WaitMiliseconds
00010d e800      	ldi r16, 0b10000000
00010e 2b05      	or r16, DATA
00010f 2f20      	mov r18, r16 //format RS:E:D7:D6:D5:D4:N/A:N/A
000110 df94      	rcall DAC
000111 ec08      		ldi r16, 200
000112 def4      		rcall	WaitMiliseconds
000113 9508      ret
                 
                 ;-------------------Overdrive Mode Start---------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 ;------------------------------------------------------------------------------
                 ; Output : T - presence bit
                 ;------------------------------------------------------------------------------
                 OWResetOD:
000114 985a      	cbi		OW_PORT,OW_DQ
000115 9a52      	sbi		OW_DDR,OW_DQ
                 
000116 e0b1      	ldi		XH, HIGH(DVUS(55))
000117 e1a3      	ldi		XL, LOW(DVUS(55))
000118 deeb      	rcall	Wait4xCycles
                 	
000119 9852      	cbi		OW_DDR,OW_DQ
                 
00011a e0b0      	ldi		XH, HIGH(DVUS(8))
00011b e2a8      	ldi		XL, LOW(DVUS(8))
00011c dee7      	rcall	Wait4xCycles
                 
00011d 9468      	set
00011e 9b4a      	sbis	OW_PIN,OW_DQ
00011f 94e8      	clt
                 
000120 e0b0      	ldi		XH, HIGH(DVUS(48))
000121 efa0      	ldi		XL, LOW(DVUS(48))
000122 dee1      	rcall	Wait4xCycles
                 
000123 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : C - bit to write
                 ;------------------------------------------------------------------------------
                 OWWriteBitOD:
000124 f418      	brcc	OWWriteZeroOD
000125 e0b0      	ldi		XH, HIGH(DVUS(1))//Måste Kalibreras
000126 e0a5      	ldi		XL, LOW(DVUS(1))//Måste Kalibreras
000127 c002      	rjmp	OWWriteOneOD
                 OWWriteZeroOD:	
000128 e0b0      	ldi		XH, HIGH(DVUS(10)) 
000129 e3a2      	ldi		XL, LOW(DVUS(10)) 
                 OWWriteOneOD:
00012a 9a52      	sbi		OW_DDR, OW_DQ
00012b ded8      	rcall	Wait4xCycles
00012c 9852      	cbi		OW_DDR, OW_DQ
                 	
00012d e0b0      	ldi		XH, HIGH(DVUS(10))
00012e e3a2      	ldi		XL, LOW(DVUS(10))
00012f ded4      	rcall	Wait4xCycles
000130 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : r16 - byte to write
                 ;------------------------------------------------------------------------------
                 OWWriteByteOD:
000131 931f      	push	OWCount
000132 e010      	ldi		OWCount,0
                 OWWriteLoopOD:	
000133 9507      	ror		r16
000134 dfef      	rcall	OWWriteBitOD	
000135 9513      	inc		OWCount
000136 3018      	cpi		OWCount,8
000137 f7d9      	brne	OWWriteLoopOD
000138 911f      	pop		OWCount		
000139 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Output : C - bit from slave
                 ;------------------------------------------------------------------------------
                 OWReadBitOD:
00013a e0b0      	ldi		XH, HIGH(DVUS(1)) //Måste kalibreras
00013b e0a5      	ldi		XL, LOW(DVUS(1)) //Måste kalibreras
00013c 9a52      	sbi		OW_DDR, OW_DQ
00013d dec6      	rcall	Wait4xCycles
00013e 9852      	cbi		OW_DDR, OW_DQ
00013f e0b0      	ldi		XH, HIGH(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent, 1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
000140 e0a5      	ldi		XL, LOW(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent,  1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
000141 dec2      	rcall	Wait4xCycles
000142 94e8      	clt
000143 994a      	sbic	OW_PIN,OW_DQ
000144 9468      	set
000145 e0b0      	ldi		XH, HIGH(DVUS(10))
000146 e3a2      	ldi		XL, LOW(DVUS(10))
000147 debc      	rcall	Wait4xCycles
000148 9408      	sec
000149 f00e      	brts	OWReadBitEndOD
00014a 9488      	clc
                 OWReadBitEndOD:
00014b 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Output : r16 - byte from slave
                 ;------------------------------------------------------------------------------
                 OWReadByteOD:
00014c 931f      	push	OWCount
00014d e010      	ldi		OWCount,0
                 OWReadLoopOD:
00014e dfeb      	rcall	OWReadBitOD
00014f 9507      	ror		r16
000150 9513      	inc		OWCount
000151 3018      	cpi		OWCount,8
000152 f7d9      	brne	OWReadLoopOD
000153 911f      	pop		OWCount
000154 9508      	ret
                 ;------------------------------------------------------------------------------
                 ;
                 ;------------------------------------------------------------------------------
                 
                 
                 
                 ;-------------------Overdrive Mode End-----------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 
                 ;-------------------Standard Mode Start-----------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 ;------------------------------------------------------------------------------
                 ; Output : T - presence bit
                 ;------------------------------------------------------------------------------
                 OWReset:
000155 985a      	cbi		OW_PORT,OW_DQ
000156 9a52      	sbi		OW_DDR,OW_DQ
                 
000157 e0b9      	ldi		XH, HIGH(DVUS(470))
000158 e2ae      	ldi		XL, LOW(DVUS(470))
000159 deaa      	rcall	Wait4xCycles
                 	
00015a 9852      	cbi		OW_DDR,OW_DQ
                 
00015b e0b1      	ldi		XH, HIGH(DVUS(70))
00015c e5ae      	ldi		XL, LOW(DVUS(70))
00015d dea6      	rcall	Wait4xCycles
                 
00015e 9468      	set
00015f 9b4a      	sbis	OW_PIN,OW_DQ
000160 94e8      	clt
                 
000161 e0b4      	ldi		XH, HIGH(DVUS(240))
000162 eba0      	ldi		XL, LOW(DVUS(240))
000163 dea0      	rcall	Wait4xCycles
                 
000164 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : C - bit to write
