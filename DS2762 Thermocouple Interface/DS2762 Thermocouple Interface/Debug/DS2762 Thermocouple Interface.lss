0000f6 df10      		rcall	WaitMiliseconds
0000f7 ec2c      	ldi r18, 0b11001100 //format RS:E:D7:D6:D5:D4:N/A:N/A
0000f8 dfac      	rcall DAC
0000f9 ec08      		ldi r16, 200
0000fa df0c      		rcall	WaitMiliseconds
0000fb e82c      	ldi r18, 0b10001100 //format RS:E:D7:D6:D5:D4:N/A:N/A
0000fc dfa8      	rcall DAC
0000fd ec08      		ldi r16, 200
0000fe df08      		rcall	WaitMiliseconds
                 
                 		;swap DATA
0000ff 9556      		lsr DATA
000100 735f      		andi DATA, 0b00111111
                 	
                 		
000101 e800      	ldi r16, 0b10000000
000102 2b05      	or r16, DATA
000103 2f20      	mov r18, r16 //format RS:E:D7:D6:D5:D4:N/A:N/A 
000104 dfa0      	rcall DAC
000105 ec08      		ldi r16, 200
000106 df00      		rcall	WaitMiliseconds
000107 ec00      	ldi r16, 0b11000000
000108 2b05      	or r16, DATA
000109 2f20      	mov r18, r16 //format RS:E:D7:D6:D5:D4:N/A:N/A
00010a df9a      	rcall DAC
