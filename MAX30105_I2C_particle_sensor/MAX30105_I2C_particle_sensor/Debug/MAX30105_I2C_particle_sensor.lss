                                 ;writes two bytes with the selected start register
                                 MAX30105Write://(byte command, byte data){
                                   
                                  
                                     //TWCR = (1<<TWINT)|(1<<TWSTA)|
                                     //(1<<TWEN);
00015c ea04                      	ldi r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
00015d 9300 00bc                 	sts TWCR, r16
                                     
                                     //while (!(TWCR & (1<<TWINT)))
                                     ;
                                     wait1:
00015f 9100 00bc                 	lds r16,TWCR
000161 ff07                      	sbrs r16,TWINT
000162 cffc                      	rjmp wait1
                                 
                                     //if ((TWSR & 0xF8) != START)
                                     //ERROR();
000163 9100 00b9                     lds r16,TWSR
000165 7f08                      	andi r16, 0xF8
000166 3008                      	cpi r16, START
000167 f799                      	brne ERROR1
                                 
                                 	
                                     //TWDR = SLA_W;
                                     //TWCR = (1<<TWINT) |
                                     //(1<<TWEN);
000168 ea0e                      	ldi r16, SLA_W
000169 9300 00bb                 	sts TWDR, r16
00016b e804                      	ldi r16, (1<<TWINT)|(1<<TWEN)
00016c 9300 00bc                 	sts TWCR, r16
                                     
                                 	
                                     //while (!(TWCR & (1<<TWINT)))
                                     //;
                                 	wait2:
00016e 9100 00bc                 	lds r16,TWCR
000170 ff07                      	sbrs r16,TWINT
000171 cffc                      	rjmp wait2
                                 
                                     
                                     //if ((TWSR & 0xF8) !=
                                     //MT_SLA_ACK)
                                     //ERROR();
000172 9100 00b9                 	lds r16,TWSR
000174 7f08                      	andi r16, 0xF8
000175 3108                      	cpi r16, MT_SLA_ACK
000176 f721                      	brne ERROR1
                                 
                                     
                                 	
                                 
                                     //---------------------
                                     //TWDR = command; //
                                     //TWCR = (1<<TWINT) |
                                     //(1<<TWEN);
000177 2f03                          mov r16, COMMAND //ex. COMMAND
000178 9300 00bb                 	sts TWDR, r16
00017a e804                      	ldi r16, (1<<TWINT)|(1<<TWEN)
00017b 9300 00bc                 	sts TWCR, r16
                                 
                                 	
                                     //while (!(TWCR & (1<<TWINT)))
                                     //;
                                 	wait3:
00017d 9100 00bc                 	lds r16,TWCR
00017f ff07                      	sbrs r16,TWINT
000180 cffc                      	rjmp wait3
                                     
                                 	
                                     //if ((TWSR & 0xF8) !=
                                     //MT_DATA_ACK)
                                     //ERROR();
000181 9100 00b9                 	lds r16,TWSR
000183 7f08                      	andi r16, 0xF8 
000184 3208                      	cpi r16, MT_DATA_ACK
000185 f499                      	brne ERROR2
                                 	//---------------------
                                 
                                 
                                 	//---------------------
                                     //TWDR = data; //
                                     //TWCR = (1<<TWINT) |
                                     //(1<<TWEN);
000186 2f04                          mov r16, DATA //ex. DATA
000187 9300 00bb                 	sts TWDR, r16
000189 e804                      	ldi r16, (1<<TWINT)|(1<<TWEN)
00018a 9300 00bc                 	sts TWCR, r16
                                 
                                 	
                                     //while (!(TWCR & (1<<TWINT)))
                                     //;
                                 	wait5:
00018c 9100 00bc                 	lds r16,TWCR
00018e ff07                      	sbrs r16,TWINT
00018f cffc                      	rjmp wait5
                                     
                                 	
                                     //if ((TWSR & 0xF8) !=
                                     //MT_DATA_ACK)
                                     //ERROR();
000190 9100 00b9                 	lds r16,TWSR
000192 7f08                      	andi r16, 0xF8
000193 3208                      	cpi r16, MT_DATA_ACK
000194 f421                      	brne ERROR2
                                 	//---------------------
                                 
                                 
                                     //TWCR = (1<<TWINT)|(1<<TWEN)|
                                     //(1<<TWSTO);
000195 e904                      	ldi r16,(1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
000196 9300 00bc                 	sts TWCR, r16
                                 
000198 9508                      ret
                                 
                                 
                                 ERROR2: 
                                 ;rcall LCD
