000317 e0b0                      	ldi		XH, HIGH(DVUS(8)) //Kolla så att sampling inte sker försent, max 15us tRD - READ VALID, pga oexakta tider, oscilloskop!
000318 e2a8                      	ldi		XL, LOW(DVUS(8)) //Kolla så att sampling inte sker försent, max 15us tRD - READ VALID, pga oexakta tider, oscilloskop!
000319 dd45                      	rcall	Wait4xCycles
00031a 94e8                      	clt
00031b 994c                      	sbic	OW_PIN,OW_DQ
00031c 9468                      	set
00031d e0b0                      	ldi		XH, HIGH(DVUS(50))
00031e efaa                      	ldi		XL, LOW(DVUS(50))
00031f dd3f                      	rcall	Wait4xCycles
000320 9408                      	sec
000321 f00e                      	brts	OWReadBitEnd
000322 9488                      	clc
                                 OWReadBitEnd:
000323 9508                      	ret
