000303 dd5b                      	rcall	Wait4xCycles
000304 9854                      	cbi		OW_DDR, OW_DQ
                                 	
000305 e0b1                      	ldi		XH, HIGH(DVUS(60))
000306 e2ac                      	ldi		XL, LOW(DVUS(60))
000307 dd57                      	rcall	Wait4xCycles
000308 9508                      	ret
                                 ;------------------------------------------------------------------------------
