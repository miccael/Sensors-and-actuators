                                 ;------------------------------------------------------------------------------
                                 OWWriteBit:
0002fc f418                      	brcc	OWWriteZero
0002fd e0b0                      	ldi		XH, HIGH(DVUS(1))
0002fe e0a5                      	ldi		XL, LOW(DVUS(1))
0002ff c002                      	rjmp	OWWriteOne
                                 OWWriteZero:	
000300 e0b1                      	ldi		XH, HIGH(DVUS(70)) //Changed from 120
000301 e5ae                      	ldi		XL, LOW(DVUS(70)) //Changed from 120
                                 OWWriteOne:
