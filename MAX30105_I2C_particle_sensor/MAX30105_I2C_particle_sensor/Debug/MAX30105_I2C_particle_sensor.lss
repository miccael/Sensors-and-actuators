                                 #pragma AVRPART MEMORY INT_SRAM SIZE 2048
                                 #pragma AVRPART MEMORY INT_SRAM START_ADDR 0x100
                                 
                                 
                                 
                                 ; ***** BOOTLOADER DECLARATIONS ******************************************
                                 .equ	NRWW_START_ADDR	= 0x3800
                                 .equ	NRWW_STOP_ADDR	= 0x3fff
                                 .equ	RWW_START_ADDR	= 0x0
                                 .equ	RWW_STOP_ADDR	= 0x37ff
                                 .equ	PAGESIZE	= 64
                                 .equ	FIRSTBOOTSTART	= 0x3f00
                                 .equ	SECONDBOOTSTART	= 0x3e00
                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; MAX30105_I2C_particle_sensor.asm
                                 ;
                                 ; Created: 2019-11-09 23:09:11
                                 ; Author : Mikael Glans
                                 ;
                                 
                                 //Testa först genom att temperatur mäta eller kolla om LED:arna reagerar på den ström du ställer in.
                                 //1. Konfigurera eventuellt ATmega328p för interrupt sensing Data_Ready från MAX30105
                                 //2. Fungerar det att läsa I2C Data som i main eller bör tre bytes läsas i en och samma transaction (ett sample i detta fall)?
                                 //3. Konfigurera LCD_write metoden för att skriva ut FIFO Data på LCD-displayen (behövs kanske ej. tillägg 2019-11-10 cirka kl. 7:00 bör vara konfigurerat nu). 
                                 //4. Konfigurera eventuellt MAX30105 för PROX_INT_EN proximity interrupt.
                                 
                                 
                                 .dseg
000100                           DUMMY_PAGE_1: .BYTE 1 ; reserve 1 byte to DUMMY_PAGE_1
                                 .cseg
                                 
                                 
                                 //---------System Clock init----------------
                                   #define F_CPU 20000000 //
                                  //---------System Clock init----------------
                                  
                                 	
                                 	//---------------I2C definitions and init----------------------
                                 	//-------------------------------------------------------------
                                 		.def COMMAND = r19
                                 		.def DATA = r20
                                 		.def DATA1 = r21 //Particle sensing mode MAX30105 1 channel tot 3 bytes. LED1 RED only. Byte LED1[23:16]
                                 		.def DATA2 = r22 //Particle sensing mode MAX30105 1 channel tot 3 bytes. LED1 RED only. Byte LED1[15:8]
                                 		.def DATA3 = r23 //Particle sensing mode MAX30105 1 channel tot 3 bytes. LED1 RED only. Byte LED1[7:0]
                                 		.equ SLA_W = 0xAE //0xAE slave adress, 0x57 and R/W=0
                                 		.equ SLA_R = 0xAF //0xAF slave adress, 0x57 and R/W=1 
                                 		.equ START = 0x08
                                 		.equ R_START = 0x10
                                 		.equ MT_SLA_ACK = 0x18
                                 		.equ MR_SLA_ACK = 0x40
                                 		.equ MT_DATA_ACK = 0x28
                                 		.equ MR_DATA_ACK = 0x50
                                 		.equ MT_DATA_NOACK = 0x30
                                 		.equ MR_DATA_NOACK = 0x58
                                 
000000 e604                      		ldi r16, 100
000001 d060                      		rcall	WaitMiliseconds //wait .1s
                                 
                                 		// deactivate internal pullups for twi.
000002 e000                      		ldi r16, (0<<PC4)|(0<<PC5)
000003 9300 0007                 		sts DDRC, r16
                                 
                                 		//------------SCL speed 50kHz @ 20MHz ATmega328p-----------
000005 ec00                      		ldi r16, 0xC0
000006 9300 00b8                 		sts TWBR, r16 //50kHz TWI (400 kHz max in MAX30105)
000008 e000                      		ldi r16, (0<<TWPS1)|(0<<TWPS0) //Prescaler 1
000009 9300 00b9                 		sts TWSR, r16
                                 		 //--------------------------------------------
                                 	
                                 		// enable twi module, acks, and twi interrupt
00000b e405                      		ldi r16, (1<<TWEN) | (1<<TWIE) | (1<<TWEA)
00000c 9300 00bc                 		sts TWCR, r16
                                 	//---------------I2C definitions and init----------------------
                                 	//-------------------------------------------------------------
                                 
                                 
                                 
                                 //---------------init of MAX30105------------------------------------
                                 //-----------------------------------------------------------------
00000e d00c                      rcall MAX30105_settings
00000f ec08                      		ldi r16, 200
000010 d051                      		rcall	WaitMiliseconds //wait 200ms
                                 //---------------init of MAX30105------------------------------------
                                 //-----------------------------------------------------------------
                                  
000011 d1e1                       rcall LCD
                                 
                                 
                                 
                                 
                                 ; Replace with your application code
                                 main:
                                 
                                 	
                                 
                                 
000012 e001                      		ldi r16, 1
000013 d04e                      		rcall	WaitMiliseconds //wait
000014 e037                      				ldi COMMAND, 0x07 //read FIFO Data 
000015 d184                      				rcall MAX30105Read ;output in DATA
000016 2f54                      				mov DATA1, DATA
                                 				/*lldi COMMAND, 0x07 //read FIFO Data 
                                 				rcall MAX30105Read ;output in DATA
                                 				mov DATA2, DATA
                                 				di COMMAND, 0x07 //read FIFO Data 
                                 				rcall MAX30105Read ;output in DATA
                                 				mov DATA3, DATA*/
000017 d055                      			rcall LCDwrite
000018 e001                      		ldi r16, 1
000019 d048                      		rcall	WaitMiliseconds //wait
00001a cff7                      rjmp main
                                 
                                 
                                 
                                 
                                 
                                 MAX30105_settings:
                                 
00001b e604                      		ldi r16, 100
00001c d045                      		rcall	WaitMiliseconds //wait
                                 
00001d e032                      ldi COMMAND, 0x02 //Interrupt Enable 1 reg
00001e e040                      ldi DATA, 0b00000000 //DATA_RDY_EN=1.
00001f d13c                      rcall MAX30105Write ;
                                 
000020 e604                      		ldi r16, 100
000021 d040                      		rcall	WaitMiliseconds //wait	
                                 
000022 e034                      ldi COMMAND, 0x04 //FIFO Write Pointer reg
000023 e040                      ldi DATA, 0b00000000 //reset the pointer
000024 d137                      rcall MAX30105Write ;
                                 
000025 e604                      		ldi r16, 100
000026 d03b                      		rcall	WaitMiliseconds //wait	
                                 
000027 e035                      ldi COMMAND, 0x05 //Over Flow Counter
000028 e040                      ldi DATA, 0b00000000 //reset the counter
000029 d132                      rcall MAX30105Write ;
                                 
00002a e604                      		ldi r16, 100
00002b d036                      		rcall	WaitMiliseconds //wait	
                                 
00002c e036                      ldi COMMAND, 0x06 //FIFO Read Pointer
00002d e040                      ldi DATA, 0b00000000 //reset the pointer
00002e d12d                      rcall MAX30105Write ;
                                 
00002f e604                      		ldi r16, 100
000030 d031                      		rcall	WaitMiliseconds //wait	
                                 
000031 e038                      ldi COMMAND, 0x08 //FIFO Configuration
000032 e140                      ldi DATA, 0b00010000 //SMP_AVE[2:0]=101:32samples averaged per fifo sample.FIFO_ROLLOVER_EN=1: FIFO Address roll over enabled.
000033 d128                      rcall MAX30105Write 
                                 
000034 e604                      		ldi r16, 100
000035 d02c                      		rcall	WaitMiliseconds //wait	
                                 
000036 e039                      ldi COMMAND, 0x09 //Mode Configuration
000037 e042                      ldi DATA, 0b00000010 //MODE[2:0]=010:Particle-sensing mode using 1 LED Red only
000038 d123                      rcall MAX30105Write ;
                                 
000039 e604                      		ldi r16, 100
00003a d027                      		rcall	WaitMiliseconds //wait	
                                 
00003b e03a                      ldi COMMAND, 0x0A //SpO2 Particle-Sensing Configuration
00003c e040                      ldi DATA, 0b00000000 //SR[2:0]=000:Sampling rate 50samples/second, LED_PW[1:0]=00:69us pulse width, ADC resolution 15 bits
00003d d11e                      rcall MAX30105Write 
                                 
00003e e604                      		ldi r16, 100
00003f d022                      		rcall	WaitMiliseconds //wait
                                 
000040 e03c                      ldi COMMAND, 0x0C //LED1 Pulse Amplitude
000041 ef4f                      ldi DATA, 0b11111111 //LED1_PA[7:0]=0xFF 50mA
000042 d119                      rcall MAX30105Write 
                                 
000043 e604                      		ldi r16, 100
000044 d01d                      		rcall	WaitMiliseconds //wait
                                 
000045 e03d                      ldi COMMAND, 0x0D //LED2 Pulse Amplitude
000046 ef4f                      ldi DATA, 0b11111111 //LED2_PA[7:0]=0xFF 50mA
000047 d114                      rcall MAX30105Write 
                                 
000048 e604                      		ldi r16, 100
000049 d018                      		rcall	WaitMiliseconds //wait
                                 
00004a e03e                      ldi COMMAND, 0x0E //LED3 Pulse Amplitude
00004b ef4f                      ldi DATA, 0b11111111 //LED3_PA[7:0]=0xFF 50mA
00004c d10f                      rcall MAX30105Write 
                                 
00004d e604                      		ldi r16, 100
00004e d013                      		rcall	WaitMiliseconds //wait
                                 
00004f e130                      ldi COMMAND, 0x10 //Proximity Mode LED Pulse Amplitude
000050 ef4f                      ldi DATA, 0b11111111 //PILOT_PA[7:0]=0xFF 50mA
000051 d10a                      rcall MAX30105Write 
                                 
                                 
000052 e604                      		ldi r16, 100
000053 d00e                      		rcall	WaitMiliseconds //wait
                                 
                                 /*
                                 ldi COMMAND, 0x11 //Multi-LED Mode Control Registers
                                 ldi DATA, 0b00100011 //SLOTx[2:0] Setting:LED2(IR),LED3(GREEN)
                                 rcall MAX30105Write 
                                 
                                 
                                 		ldi r16, 100
                                 		rcall	WaitMiliseconds //wait
                                 
                                 ldi COMMAND, 0x12 //Multi-LED Mode Control Registers
                                 ldi DATA, 0b00010011 //SLOTx[2:0] Setting:LED1(RED),LED3(GREEN)
                                 rcall MAX30105Write 
                                 
                                 
                                 		ldi r16, 100
                                 		rcall	WaitMiliseconds //wait
                                 */		
                                 
000054 e231                      ldi COMMAND, 0x21 //Die Temperature Config
000055 e041                      ldi DATA, 0b00000001 //TEMP_EN=1.
000056 d105                      rcall MAX30105Write 
                                 
                                 
000057 e604                      		ldi r16, 100
000058 d009                      		rcall	WaitMiliseconds //wait
                                 
000059 e330                      ldi COMMAND, 0x30 //Proximity Interrupt Threshold
00005a e041                      ldi DATA, 0b00000001 //PROX_INT_THRESH[7:0]=0x01 ADC value of >=1023 triggers an interrupt.
00005b d100                      rcall MAX30105Write 
                                 
00005c e604                      		ldi r16, 100
00005d d004                      		rcall	WaitMiliseconds //wait	
                                 
00005e 9508                      ret
                                 
                                 
                                 
                                 
                                 #include "wait.asm" ; AVR Assembler v.2
                                 
                                  * wait.asm
                                  *
                                  *  Created: 2015-01-01 18:40:21
                                  *   Author: Mikael
                                  */ 
                                 
                                 
                                 ;------------------------------------------------------------------------------
                                 ; Busy-wait loops utilities module
                                 ; For F_CPU >= 4MHz
                                 ; http://avr-mcu.dxp.pl
                                 ; (c) Radoslaw Kwiecien, 2008
                                 ;------------------------------------------------------------------------------
                                 
                                 #ifndef F_CPU
                                 #endif
                                 
                                 #if F_CPU < 4000000
                                 #endif
                                 
                                 #define CYCLES_PER_US (F_CPU/1000000)
                                 #define C4PUS (CYCLES_PER_US/4)
                                 #define DVUS(x) (C4PUS*x)
                                 
                                 ;------------------------------------------------------------------------------
                                 ; Input : XH:XL - number of CPU cycles to wait (divided by four)
                                 ;------------------------------------------------------------------------------
                                 Wait4xCycles:
00005f 9711                        sbiw	  XH:XL, 1
000060 f7f1                        brne	  Wait4xCycles
000061 9508                        ret
                                 ;------------------------------------------------------------------------------
                                 ; Input : r16 - number of miliseconds to wait
                                 ;------------------------------------------------------------------------------
                                 WaitMiliseconds:
000062 930f                        push	r16
                                 WaitMsLoop: 
000063 e0b9                        ldi	   XH,HIGH(DVUS(500))
000064 eca4                        ldi	   XL,LOW(DVUS(500))
000065 dff9                        rcall	 Wait4xCycles
000066 e0b9                        ldi	   XH,HIGH(DVUS(500))
000067 eca4                        ldi	   XL,LOW(DVUS(500))
000068 dff6                        rcall	 Wait4xCycles
000069 950a                        dec	   r16
00006a f7c1                        brne	  WaitMsLoop
00006b 910f                        pop	   r16
00006c 9508                        ret
                                 ;------------------------------------------------------------------------------
                                 ; End of file
                                 
