                                     //if ((TWSR & 0xF8) !=
                                     //MT_DATA_ACK)
                                     //ERROR();
0001bf 9100 00b9                 	lds r16,TWSR
0001c1 7f08                      	andi r16, 0xF8
0001c2 3208                      	cpi r16, MT_DATA_ACK
0001c3 f6a9                      	brne ERROR2
                                 	//---------------------
                                 
                                 	
                                 	  
                                       //TWCR = (1<<TWINT)|(1<<TWSTA)|
                                       //(1<<TWEN); //Repeated Start Condition 
0001c4 ea04                            ldi r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
0001c5 9300 00bc                 	  sts TWCR, r16
                                 	  
                                 	  
                                       //while (!(TWCR & (1<<TWINT)))
                                       //;
                                       wait10:
0001c7 9100 00bc                 	  lds r16,TWCR
0001c9 ff07                      	  sbrs r16,TWINT
0001ca cffc                      	  rjmp wait10
                                 
                                 	  
                                       //if ((TWSR & 0xF8) != R_START)
                                       //ERROR();
0001cb 9100 00b9                 	  lds r16,TWSR
0001cd 7f08                      	  andi r16, 0xF8
0001ce 3100                      	  cpi r16, R_START
0001cf f511                      	  brne ERROR3
                                 
                                 
                                 
                                       
                                       
                                       //TWDR = SLA_R;
                                       //TWCR = (1<<TWINT) |
                                       //(1<<TWEN);
0001d0 ea0f                            ldi r16, SLA_R
0001d1 9300 00bb                 	  sts TWDR, r16
0001d3 e804                      	  ldi r16, (1<<TWINT)|(1<<TWEN)
0001d4 9300 00bc                 	  sts TWCR, r16
                                 
                                 	  
                                       //while (!(TWCR & (1<<TWINT)))
                                       //;
                                 	  wait11:
0001d6 9100 00bc                 	  lds r16,TWCR
0001d8 ff07                      	  sbrs r16,TWINT
0001d9 cffc                      	  rjmp wait11
                                       
                                 	 
                                       //if ((TWSR & 0xF8) !=
                                       //MR_SLA_ACK)
                                       //ERROR();
0001da 9100 00b9                 	  lds r16,TWSR
0001dc 7f08                      	  andi r16, 0xF8
0001dd 3400                      	  cpi r16, MR_SLA_ACK
0001de f499                      	  brne ERROR3
                                 
                                       
                                 
                                 
                                 
                                 	  /*
                                 
                                 	  //TWCR = (1<<TWINT) |
                                       //(1<<TWEA)|(1<<TWEN); //Data byte will be received and 
                                                             //ACK TWEA=1 will be returned
                                       ldi r16, (1<<TWINT)|(1<<TWEA)|(1<<TWEN)
                                 	  sts TWCR, r16
                                 	  
                                 	  
                                       //while (!(TWCR & (1<<TWINT)))
                                       //;
                                 	  wait12a:
                                 	  lds r16,TWCR
                                 	  sbrs r16,TWINT
                                 	  rjmp wait12a
                                       
                                 	  
                                       //if ((TWSR & 0xF8) !=
                                       //MR_DATA_ACK)
                                       //ERROR();
                                 	  lds r16,TWSR
                                 	  andi r16, 0xF8
                                 	  cpi r16, MR_DATA_ACK//MR_DATA_ACK
                                 	  brne ERROR3
                                       
                                      
                                       //data = TWDR; //read data byte
                                       lds r16,TWDR
                                 	  mov DATA,r16
                                 */
                                 
                                 
                                 
                                 
                                 
                                 
                                       //TWCR = (1<<TWINT) |
                                       //(0<<TWEA)|(1<<TWEN); //Data byte will be received and 
                                                             //NOT ACK TWEA=0 will be returned
0001df e804                            ldi r16, (1<<TWINT)|(0<<TWEA)|(1<<TWEN)
0001e0 9300 00bc                 	  sts TWCR, r16
                                 	  
                                 	  
                                       //while (!(TWCR & (1<<TWINT)))
                                       //;
                                 	  wait12:
0001e2 9100 00bc                 	  lds r16,TWCR
0001e4 ff07                      	  sbrs r16,TWINT
0001e5 cffc                      	  rjmp wait12
                                       
                                 	  
                                       //if ((TWSR & 0xF8) !=
                                       //MR_DATA_NOACK)
                                       //ERROR();
0001e6 9100 00b9                 	  lds r16,TWSR
0001e8 7f08                      	  andi r16, 0xF8
0001e9 3508                      	  cpi r16, MR_DATA_NOACK//MR_DATA_NOACK
0001ea f439                      	  brne ERROR3
                                       
                                      
                                       //data = TWDR; //read data byte
0001eb 9100 00bb                       lds r16,TWDR
0001ed 2f40                      	  mov DATA,r16
                                 
                                       
                                       //TWCR = (1<<TWINT)|(1<<TWEN)|
                                       //(1<<TWSTO); // Send a Stop Condition
0001ee e904                            ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
0001ef 9300 00bc                 	  sts TWCR, r16
                                 
                                 	  
                                       //return data;
                                 
0001f1 9508                      ret
                                 
