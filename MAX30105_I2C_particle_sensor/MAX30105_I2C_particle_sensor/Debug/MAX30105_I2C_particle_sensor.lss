0001a6 ea0e                      	  ldi r16, SLA_W
0001a7 9300 00bb                 	  sts TWDR, r16
0001a9 e804                      	  ldi r16, (1<<TWINT)|(1<<TWEN)
0001aa 9300 00bc                 	  sts TWCR, r16
                                       
                                 	  
                                       //while (!(TWCR & (1<<TWINT)))
                                       //;
                                       wait7:
0001ac 9100 00bc                 	  lds r16,TWCR
0001ae ff07                      	  sbrs r16,TWINT
0001af cffc                      	  rjmp wait7
                                 
                                 	 
                                       //if ((TWSR & 0xF8) !=
                                       //MT_SLA_ACK)
                                       //ERROR();
0001b0 9100 00b9                 	  lds r16,TWSR
0001b2 7f08                      	  andi r16, 0xF8
0001b3 3108                      	  cpi r16, MT_SLA_ACK
0001b4 f721                      	  brne ERROR2
                                       
                                 	  //---------------------
                                     //TWDR = command; //
                                     //TWCR = (1<<TWINT) |
                                     //(1<<TWEN);
0001b5 2f03                          mov r16, COMMAND //ex. COMMAND
0001b6 9300 00bb                 	sts TWDR, r16
0001b8 e804                      	ldi r16, (1<<TWINT)|(1<<TWEN)
0001b9 9300 00bc                 	sts TWCR, r16
                                 
                                 	
                                     //while (!(TWCR & (1<<TWINT)))
                                     //;
                                 	wait8:
0001bb 9100 00bc                 	lds r16,TWCR
0001bd ff07                      	sbrs r16,TWINT
