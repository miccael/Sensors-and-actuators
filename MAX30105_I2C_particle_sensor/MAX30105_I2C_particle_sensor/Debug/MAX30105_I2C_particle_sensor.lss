                                 ;------------------------------------------------------------------------------
                                 OWWriteByte:
000309 931f                      	push	OWCount
00030a e010                      	ldi		OWCount,0
                                 OWWriteLoop:	
00030b 9507                      	ror		r16
00030c dfef                      	rcall	OWWriteBit	
00030d 9513                      	inc		OWCount
00030e 3018                      	cpi		OWCount,8
00030f f7d9                      	brne	OWWriteLoop
000310 911f                      	pop		OWCount		
000311 9508                      	ret
