                                 DAC:
                                 
                                  //---------------------1-wire init Vcc powered device Overdrive Mode---------------
000288 d063                      	rcall OWReset
000289 e30c                      	ldi r16, 0x3C     //Overdrive skip ROM
00028a d07e                      	rcall OWWriteByte
00028b ec0c                      	ldi r16, 0xCC     //Write Conditional Search Register command
00028c d03b                      	rcall OWWriteByteOD
00028d e80d                      	ldi r16, 0x8D     //TA1 beginning adress
00028e d039                      	rcall OWWriteByteOD
00028f e000                      	ldi r16, 0x00     //TA2 adress 008Dh
000290 d037                      	rcall OWWriteByteOD
000291 e801                      	ldi r16, 0x81     //data byte adress 008Dh
000292 d035                      	rcall OWWriteByteOD
                                 	//---------------------1-wire init Vcc powered device Overdrive Mode---------------
                                 
000293 d017                      	rcall OWResetOD
000294 e30c                      	ldi r16, 0x3C     //Overdrive skip ROM
000295 d032                      	rcall OWWriteByteOD
000296 ef00                      	ldi r16, 0xF0     //Read PIO Registers command
000297 d030                      	rcall OWWriteByteOD
000298 e80d                      	ldi r16, 0x8D     //TA1 beginning adress
000299 d02e                      	rcall OWWriteByteOD
00029a e000                      	ldi r16, 0x00     //TA2 adress 008Dh
00029b d02c                      	rcall OWWriteByteOD
00029c d046                      	rcall OWReadByteOD //Read Control/Status Register and verify
                                 
00029d d00d                      	rcall OWResetOD
00029e e30c                      	ldi r16, 0x3C     //Overdrive skip ROM
00029f d028                      	rcall OWWriteByteOD
0002a0 e50a                      	ldi r16, 0x5A     //Channel-access Write command
0002a1 d026                      	rcall OWWriteByteOD
0002a2 2f02                      	mov r16, r18     //Write byte to PIO
0002a3 d024                      	rcall OWWriteByteOD
0002a4 2f02                      	mov r16, r18     //
0002a5 9500                      	com r16           //
                                 	//ldi r16, 0xFF     //Write inverted byte to PIO
0002a6 d021                      	rcall OWWriteByteOD
0002a7 d03b                      	rcall OWReadByteOD //Read for verification (AAh = success)
0002a8 d03a                      	rcall OWReadByteOD //Read PIO pin status
0002a9 d001                      	rcall OWResetOD
                                 	
0002aa 9508                      ret
                                 
                                 
                                 
                                 ;-------------------Overdrive Mode Start---------------------------------------
                                 ;------------------------------------------------------------------------------
                                 
                                 ;------------------------------------------------------------------------------
                                 ; Output : T - presence bit
                                 ;------------------------------------------------------------------------------
                                 OWResetOD:
0002ab 985c                      	cbi		OW_PORT,OW_DQ
0002ac 9a54                      	sbi		OW_DDR,OW_DQ
                                 
0002ad e0b1                      	ldi		XH, HIGH(DVUS(55))
0002ae e1a3                      	ldi		XL, LOW(DVUS(55))
0002af ddaf                      	rcall	Wait4xCycles
                                 	
0002b0 9854                      	cbi		OW_DDR,OW_DQ
                                 
0002b1 e0b0                      	ldi		XH, HIGH(DVUS(8))
0002b2 e2a8                      	ldi		XL, LOW(DVUS(8))
0002b3 ddab                      	rcall	Wait4xCycles
                                 
0002b4 9468                      	set
0002b5 9b4c                      	sbis	OW_PIN,OW_DQ
0002b6 94e8                      	clt
                                 
0002b7 e0b0                      	ldi		XH, HIGH(DVUS(48))
0002b8 efa0                      	ldi		XL, LOW(DVUS(48))
0002b9 dda5                      	rcall	Wait4xCycles
                                 
0002ba 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Input : C - bit to write
                                 ;------------------------------------------------------------------------------
                                 OWWriteBitOD:
0002bb f418                      	brcc	OWWriteZeroOD
0002bc e0b0                      	ldi		XH, HIGH(DVUS(1))//Måste Kalibreras
0002bd e0a5                      	ldi		XL, LOW(DVUS(1))//Måste Kalibreras
0002be c002                      	rjmp	OWWriteOneOD
                                 OWWriteZeroOD:	
0002bf e0b0                      	ldi		XH, HIGH(DVUS(10)) 
0002c0 e3a2                      	ldi		XL, LOW(DVUS(10)) 
                                 OWWriteOneOD:
0002c1 9a54                      	sbi		OW_DDR, OW_DQ
0002c2 dd9c                      	rcall	Wait4xCycles
0002c3 9854                      	cbi		OW_DDR, OW_DQ
                                 	
0002c4 e0b0                      	ldi		XH, HIGH(DVUS(10))
0002c5 e3a2                      	ldi		XL, LOW(DVUS(10))
0002c6 dd98                      	rcall	Wait4xCycles
0002c7 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Input : r16 - byte to write
                                 ;------------------------------------------------------------------------------
                                 OWWriteByteOD:
0002c8 931f                      	push	OWCount
0002c9 e010                      	ldi		OWCount,0
                                 OWWriteLoopOD:	
0002ca 9507                      	ror		r16
0002cb dfef                      	rcall	OWWriteBitOD	
0002cc 9513                      	inc		OWCount
0002cd 3018                      	cpi		OWCount,8
0002ce f7d9                      	brne	OWWriteLoopOD
0002cf 911f                      	pop		OWCount		
0002d0 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Output : C - bit from slave
                                 ;------------------------------------------------------------------------------
                                 OWReadBitOD:
0002d1 e0b0                      	ldi		XH, HIGH(DVUS(1)) //Måste kalibreras
0002d2 e0a5                      	ldi		XL, LOW(DVUS(1)) //Måste kalibreras
0002d3 9a54                      	sbi		OW_DDR, OW_DQ
0002d4 dd8a                      	rcall	Wait4xCycles
0002d5 9854                      	cbi		OW_DDR, OW_DQ
0002d6 e0b0                      	ldi		XH, HIGH(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent, 1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
0002d7 e0a5                      	ldi		XL, LOW(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent,  1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
0002d8 dd86                      	rcall	Wait4xCycles
0002d9 94e8                      	clt
0002da 994c                      	sbic	OW_PIN,OW_DQ
0002db 9468                      	set
0002dc e0b0                      	ldi		XH, HIGH(DVUS(10))
0002dd e3a2                      	ldi		XL, LOW(DVUS(10))
0002de dd80                      	rcall	Wait4xCycles
0002df 9408                      	sec
0002e0 f00e                      	brts	OWReadBitEndOD
0002e1 9488                      	clc
                                 OWReadBitEndOD:
0002e2 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Output : r16 - byte from slave
                                 ;------------------------------------------------------------------------------
                                 OWReadByteOD:
0002e3 931f                      	push	OWCount
0002e4 e010                      	ldi		OWCount,0
                                 OWReadLoopOD:
0002e5 dfeb                      	rcall	OWReadBitOD
0002e6 9507                      	ror		r16
0002e7 9513                      	inc		OWCount
0002e8 3018                      	cpi		OWCount,8
0002e9 f7d9                      	brne	OWReadLoopOD
0002ea 911f                      	pop		OWCount
0002eb 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ;
                                 ;------------------------------------------------------------------------------
                                 
                                 ;-------------------Overdrive Mode End-----------------------------------------
                                 ;------------------------------------------------------------------------------
                                 
                                 
                                 
                                 ;-------------------Standard Mode Start-----------------------------------------
                                 ;------------------------------------------------------------------------------
                                 
                                 ;------------------------------------------------------------------------------
                                 ; Output : T - presence bit
                                 ;------------------------------------------------------------------------------
                                 OWReset:
0002ec 985c                      	cbi		OW_PORT,OW_DQ
0002ed 9a54                      	sbi		OW_DDR,OW_DQ
                                 
0002ee e0b9                      	ldi		XH, HIGH(DVUS(470))
0002ef e2ae                      	ldi		XL, LOW(DVUS(470))
0002f0 dd6e                      	rcall	Wait4xCycles
                                 	
0002f1 9854                      	cbi		OW_DDR,OW_DQ
                                 
