                                 DAC:
                                 
                                  //---------------------1-wire init Vcc powered device Overdrive Mode---------------
000250 d063                      	rcall OWReset
000251 e30c                      	ldi r16, 0x3C     //Overdrive skip ROM
000252 d07e                      	rcall OWWriteByte
000253 ec0c                      	ldi r16, 0xCC     //Write Conditional Search Register command
000254 d03b                      	rcall OWWriteByteOD
000255 e80d                      	ldi r16, 0x8D     //TA1 beginning adress
000256 d039                      	rcall OWWriteByteOD
000257 e000                      	ldi r16, 0x00     //TA2 adress 008Dh
000258 d037                      	rcall OWWriteByteOD
000259 e801                      	ldi r16, 0x81     //data byte adress 008Dh
00025a d035                      	rcall OWWriteByteOD
                                 	//---------------------1-wire init Vcc powered device Overdrive Mode---------------
                                 
00025b d017                      	rcall OWResetOD
00025c e30c                      	ldi r16, 0x3C     //Overdrive skip ROM
00025d d032                      	rcall OWWriteByteOD
00025e ef00                      	ldi r16, 0xF0     //Read PIO Registers command
00025f d030                      	rcall OWWriteByteOD
000260 e80d                      	ldi r16, 0x8D     //TA1 beginning adress
000261 d02e                      	rcall OWWriteByteOD
000262 e000                      	ldi r16, 0x00     //TA2 adress 008Dh
000263 d02c                      	rcall OWWriteByteOD
000264 d046                      	rcall OWReadByteOD //Read Control/Status Register and verify
                                 
000265 d00d                      	rcall OWResetOD
000266 e30c                      	ldi r16, 0x3C     //Overdrive skip ROM
000267 d028                      	rcall OWWriteByteOD
000268 e50a                      	ldi r16, 0x5A     //Channel-access Write command
000269 d026                      	rcall OWWriteByteOD
00026a 2f02                      	mov r16, r18     //Write byte to PIO
00026b d024                      	rcall OWWriteByteOD
00026c 2f02                      	mov r16, r18     //
00026d 9500                      	com r16           //
                                 	//ldi r16, 0xFF     //Write inverted byte to PIO
00026e d021                      	rcall OWWriteByteOD
00026f d03b                      	rcall OWReadByteOD //Read for verification (AAh = success)
000270 d03a                      	rcall OWReadByteOD //Read PIO pin status
000271 d001                      	rcall OWResetOD
                                 	
000272 9508                      ret
                                 
                                 
                                 
                                 ;-------------------Overdrive Mode Start---------------------------------------
                                 ;------------------------------------------------------------------------------
                                 
                                 ;------------------------------------------------------------------------------
                                 ; Output : T - presence bit
                                 ;------------------------------------------------------------------------------
                                 OWResetOD:
000273 985c                      	cbi		OW_PORT,OW_DQ
000274 9a54                      	sbi		OW_DDR,OW_DQ
                                 
000275 e0b1                      	ldi		XH, HIGH(DVUS(55))
000276 e1a3                      	ldi		XL, LOW(DVUS(55))
000277 de2b                      	rcall	Wait4xCycles
                                 	
000278 9854                      	cbi		OW_DDR,OW_DQ
                                 
000279 e0b0                      	ldi		XH, HIGH(DVUS(8))
00027a e2a8                      	ldi		XL, LOW(DVUS(8))
00027b de27                      	rcall	Wait4xCycles
                                 
00027c 9468                      	set
00027d 9b4c                      	sbis	OW_PIN,OW_DQ
00027e 94e8                      	clt
                                 
00027f e0b0                      	ldi		XH, HIGH(DVUS(48))
000280 efa0                      	ldi		XL, LOW(DVUS(48))
000281 de21                      	rcall	Wait4xCycles
                                 
000282 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Input : C - bit to write
                                 ;------------------------------------------------------------------------------
                                 OWWriteBitOD:
000283 f418                      	brcc	OWWriteZeroOD
000284 e0b0                      	ldi		XH, HIGH(DVUS(1))//M?ste Kalibreras
000285 e0a5                      	ldi		XL, LOW(DVUS(1))//M?ste Kalibreras
000286 c002                      	rjmp	OWWriteOneOD
                                 OWWriteZeroOD:	
000287 e0b0                      	ldi		XH, HIGH(DVUS(10)) 
000288 e3a2                      	ldi		XL, LOW(DVUS(10)) 
                                 OWWriteOneOD:
000289 9a54                      	sbi		OW_DDR, OW_DQ
00028a de18                      	rcall	Wait4xCycles
00028b 9854                      	cbi		OW_DDR, OW_DQ
                                 	
00028c e0b0                      	ldi		XH, HIGH(DVUS(10))
00028d e3a2                      	ldi		XL, LOW(DVUS(10))
00028e de14                      	rcall	Wait4xCycles
00028f 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Input : r16 - byte to write
                                 ;------------------------------------------------------------------------------
                                 OWWriteByteOD:
000290 931f                      	push	OWCount
000291 e010                      	ldi		OWCount,0
                                 OWWriteLoopOD:	
000292 9507                      	ror		r16
000293 dfef                      	rcall	OWWriteBitOD	
000294 9513                      	inc		OWCount
000295 3018                      	cpi		OWCount,8
000296 f7d9                      	brne	OWWriteLoopOD
000297 911f                      	pop		OWCount		
000298 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Output : C - bit from slave
                                 ;------------------------------------------------------------------------------
                                 OWReadBitOD:
000299 e0b0                      	ldi		XH, HIGH(DVUS(1)) //M?ste kalibreras
00029a e0a5                      	ldi		XL, LOW(DVUS(1)) //M?ste kalibreras
00029b 9a54                      	sbi		OW_DDR, OW_DQ
00029c de06                      	rcall	Wait4xCycles
00029d 9854                      	cbi		OW_DDR, OW_DQ
00029e e0b0                      	ldi		XH, HIGH(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera s? att sampling inte sker f?rsent, 1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
00029f e0a5                      	ldi		XL, LOW(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera s? att sampling inte sker f?rsent,  1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
0002a0 de02                      	rcall	Wait4xCycles
0002a1 94e8                      	clt
0002a2 994c                      	sbic	OW_PIN,OW_DQ
0002a3 9468                      	set
0002a4 e0b0                      	ldi		XH, HIGH(DVUS(10))
0002a5 e3a2                      	ldi		XL, LOW(DVUS(10))
0002a6 ddfc                      	rcall	Wait4xCycles
0002a7 9408                      	sec
0002a8 f00e                      	brts	OWReadBitEndOD
0002a9 9488                      	clc
                                 OWReadBitEndOD:
0002aa 9508                      	ret
                                 ;------------------------------------------------------------------------------
