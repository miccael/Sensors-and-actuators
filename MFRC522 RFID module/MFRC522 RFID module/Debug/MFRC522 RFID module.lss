                                 ;writes two bytes with the selected start register
                                 MFRC522Write://(byte command, byte data){
00019f 982a                       cbi PORTB, PB2 //clear ~SS
                                   //Obs!
0001a0 0f33                      	lsl COMMAND
0001a1 6030                      	ori COMMAND, 0b00000000 //MSB=0 write, LSB=0 always
0001a2 2f03                          mov r16, COMMAND //ex. COMMAND
0001a3 bd0e                      	out SPDR, r16
                                 
                                 	//while (!(SPSR & (1<<SPIF)))
                                     ;
                                     wait1:
0001a4 b50d                      	in r16,SPSR
0001a5 ff07                      	sbrs r16,SPIF
0001a6 cffd                      	rjmp wait1
                                 
0001a7 2f04                      	mov r16, DATA //ex. DATA
0001a8 bd0e                      	out SPDR, r16
                                     
                                     //while (!(SPSR & (1<<SPIF)))
                                     ;
                                     wait2:
0001a9 b50d                      	in r16,SPSR
0001aa ff07                      	sbrs r16,SPIF
0001ab cffd                      	rjmp wait2
0001ac 9a2a                       sbi PORTB, PB2 //set ~SS
0001ad 9508                      ret
                                 
                                 
                                 
                                 
                                 ;reads two bytes with the selected start register
                                 MFRC522Read://(byte command){
0001ae 982a                       cbi PORTB, PB2 //clear ~SS
0001af 2f83                      	mov ADDR0,COMMAND
0001b0 0f88                      	lsl ADDR0
0001b1 6880                      	ori ADDR0, 0b10000000 //MSB=1 read, LSB=0 always
0001b2 2f08                      	mov r16, ADDR0 //ex. COMMAND or address 1
0001b3 bd0e                      	out SPDR, r16
                                 
                                 	//while (!(SPSR & (1<<SPIF)))
                                     ;
                                 	
                                 	
                                     wait3:
0001b4 b50d                      	in r16,SPSR
0001b5 ff07                      	sbrs r16,SPIF
0001b6 cffd                      	rjmp wait3
                                 	
                                 	
                                 
0001b7 b50e                      	in r16, SPDR //ex. dummy DATA or X don´t care read
0001b8 01a8                      	movw DATA, r16
                                 
                                 	/*
                                 	
                                 	 //Obs!
                                 	mov r16, COMMAND //ex. COMMAND or address 1
                                 	out SPDR, r16
                                 
                                 	//while (!(SPSR & (1<<SPIF)))
                                     ;
                                 	
                                     wait4:
                                 	in r16,SPSR
                                 	sbrs r16,SPIF
                                 	rjmp wait4
                                 	
                                 
                                 	in r16, SPDR //ex. DATA or data 0 read
                                 	mov DATA, r16
                                 
                                 	*/
                                 
                                 
                                 
                                 	//or is a read like this?? slave config
                                 	/*
                                 	mov r16, COMMAND //ex. COMMAND or address 
                                 	sts SPDR, r16
                                 
                                 	
                                     wait5:
                                 	lds r16,SPSR
                                 	sbrs r16,SPIF
                                 	rjmp wait5
                                 
                                 
                                 	ldi r16, 0b00010000 //only PB4 [MISO] output SPI Slave
                                 	sts DDRB, r16
                                 
                                 	ldi r16, (1<<SPE)|(0<<MSTR) //init Slave SPI mode
                                 	sts SPCR, r16
                                 
                                 	 wait6:
                                 	lds r16,SPSR
                                 	sbrs r16,SPIF
                                 	rjmp wait6
                                 
                                 	lds r16, SPDR
                                 	mov DATA, r16
                                 	*/
0001b9 9a2a                       sbi PORTB, PB2 //set ~SS
0001ba 9508                      ret
                                 
                                 
                                 
                                 
                                 
                                 
                                 
