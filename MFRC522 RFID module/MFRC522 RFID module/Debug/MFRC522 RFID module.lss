                                 .equ	RWW_START_ADDR	= 0x0
                                 .equ	RWW_STOP_ADDR	= 0x37ff
                                 .equ	PAGESIZE	= 64
                                 .equ	FIRSTBOOTSTART	= 0x3f00
                                 .equ	SECONDBOOTSTART	= 0x3e00
                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; MFRC522 RFID module.asm
                                 ;
                                 ; Created: 2019-11-23 12:07:08
                                 ; Author : Mikael Glans
                                 ;
                                 
                                 
                                 /*
                                 Programmera och PoC testa mfrc522 rfid module. 
                                 1.Testa skriv 12 Bytes till FIFO, testa kommando MFAuthent=1110, 
                                 Testa läs MFCrypto1On bit=1 om kommandot lyckades. 
                                 2. Testa läs VersionReg register (37h) och Version[7:0]. 
                                 3. Testa eventuellt kommando Transceive=1100; 
                                 efter kommandot skriv till StartSend bit i BitFramingReg 
                                 för att starta transmission. 
                                 4. Prova eventuellt fler kommandon 
                                 ++++Stödjande exempelkod finns Example code 1 och 
                                 Example code 2 på electrokits hemsida++++
                                 */
                                 
                                 
                                 .dseg
000100                           DUMMY_PAGE_1: .BYTE 1 ; reserve 1 byte to DUMMY_PAGE_1
000101                           SERIAL0: .BYTE 1
000102                           SERIAL1: .BYTE 1
000103                           SERIAL2: .BYTE 1
000104                           SERIAL3: .BYTE 1
000105                           CHECKBYTE4: .BYTE 1
000106                           CRC_H: .BYTE 1
000107                           CRC_L: .BYTE 1
                                 .cseg
                                 
                                 
                                 //---------System Clock init----------------
                                   #define F_CPU 20000000 //
                                  //---------System Clock init----------------
                                  
                                 
                                 
                                 		.def COMMAND = r19
                                 		.def DATA = r20
                                 		.def DATA1 = r21 //
                                 		.def DATA2 = r22 //
                                 		.def DATA3 = r23 //
                                 		.def ADDR0 = r24
                                 
                                 		
                                 
                                 		
                                 		/*
                                 		//------------SCL speed 50kHz @ 20MHz ATmega328p-----------
                                 		ldi r16, 0xC0
                                 		sts TWBR, r16 //50kHz TWI (400 kHz max in MAX30105)
                                 		ldi r16, (0<<TWPS1)|(0<<TWPS0) //Prescaler 1
                                 		sts TWSR, r16
                                 		 //--------------------------------------------
                                 	*/
                                 
                                 		//********************SPI init*********************************************
                                 	
                                 	//clock division factor 256
000000 e008                      	ldi r16, (1<<CLKPS3)|(0<<CLKPS2)|(0<<CLKPS1)|(0<<CLKPS0)
000001 9300 0061                 	sts CLKPR, r16
000003 e20c                      	ldi r16, 0b00101100 //PB5 [SCK], PB3 [MOSI], PB2 [~SS] output, PB4 [MISO] input
000004 b904                      	out DDRB, r16
                                  
000005 e200                      	ldi r16, 0b00100000 //[SCK] high to begin with
000006 b905                      	out PORTB, r16
                                 
                                 	/* Enable SPI, MSB first, Master, CPOL=0 sck low idle, set clock rate fck/128 */
000007 e503                      	ldi r16, (1<<SPE)|(0<<DORD)|(1<<MSTR)|(0<<CPOL)|(0<<CPHA)|(1<<SPR1)|(1<<SPR0)
000008 bd0c                      	out SPCR, r16
000009 e000                      	ldi r16, (0<<SPI2X)
00000a bd0d                      	out SPSR, r16
                                 	
                                 	//*******************End of SPI init******************************************
                                 
                                 
                                 
                                 //---------------init of MFRC522------------------------------------
                                 //-----------------------------------------------------------------
00000b d082                      		rcall MFRC522_settings
00000c ec08                      		ldi r16, 200
00000d d098                      		rcall	WaitMiliseconds //wait 200ms
                                 //---------------init of MFRC522------------------------------------
                                 //-----------------------------------------------------------------
                                  
00000e d1ac                       rcall LCD
                                 
                                 
