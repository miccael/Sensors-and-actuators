                  * NOKIA6100.asm
                  *
                  *  Created: 2015-10-01 18:12:17
                  *   Author: Mikael
                  */ 
                 
                 
                 
                 
                  //---------System Clock init----------------
                   #define F_CPU 20000000
                 
                  //ldi r16, 0xFF
                  //out OSCCAL, r16
                 
                 /* ldi r16,(1<<CLKPS3)|(0<<CLKPS2)|(0<<CLKPS1)|(0<<CLKPS0)
                  out CLKPR, r16 //prescaler 256*/
                  //---------System Clock init----------------
                 
                  .def	rami1 = r22
000000 e060       ldi rami1, 0x00
                  .def	rami2 = r23
000001 e070       ldi rami2, 0x00
                 
                  
                  //-------------------SPI init------------------------------------------------------------------------------
000002 e005        ldi r16, (1<<DDC2)|(1<<DDC0) ;PC2 CS [25], PC0 RESET [23]
000003 b907        out DDRC, r16
000004 e20c        ldi r16, (1<<DDB2)|(1<<DDB3)|(1<<DDB5) ;PB2 |SS [16], PB3 MOSI [17], PB5 SCK [19]
000005 b904        out DDRB, r16 ;
                 
000006 e000        ldi r16, (0<<PB5)|(0<<PB3) ;SCK and MOSI (DATA) is low to begin with
000007 b905        out PORTB, r16
                 
000008 e000        ldi r16, (0<<PRSPI)
000009 9300 0064   sts PRR, r16 //Power Reduction Serial Peripheral Interface bit disabled
                 
                   ; Disable SPI, MSB first, sample (rising) setup (falling), Master, set clock rate fck/128
00000b e103      ldi r16, (0<<SPIE)|(0<<SPE)|(0<<DORD)|(0<<CPOL)|(0<<CPHA)|(1<<MSTR)|(1<<SPR1)|(1<<SPR0)
00000c bd0c      out SPCR,r16
                   ; Double SPI Speed Bit not set
00000d e000      ldi r16, (0<<SPI2X)
00000e bd0d      out SPSR,r16
                 //------------------SPI init-------------------------------------------------------------------------------
                  
00000f 9a42       sbi PORTC, LCD_CS // disable device CS on NOKIA6100
                  
000010 d0c8       rcall LCD
000011 d00f       rcall NOKIA_LCD_init
                  /*
                  cbi PORTC, LCD_CS // enable device CS
                 	
                 	
                 	ldi r20, 0b00000000 //command
                 	ldi r21, 0x75 //PASET
                 	rcall SendLcd
                 	ldi r20, 0b11111111 //data
                 	ldi r21, 0x04 //
                 	rcall SendLcd
                 	ldi r20, 0b11111111 //data
                 	ldi r21, 0x80 //
                 	rcall SendLcd
                 
                 	
                 	ldi r20, 0b00000000 //command
                 	ldi r21, 0x15 //CASET
                 	rcall SendLcd
                 	ldi r20, 0b11111111 //data
                 	ldi r21, 0x04 //
                 	rcall SendLcd
                 	ldi r20, 0b11111111 //data
                 	ldi r21, 0x80 //
                 	rcall SendLcd
                 
                 	ldi r20, 0b00000000 //command
                 	ldi r21, 0x5C //RAMWR
                 	rcall SendLcd
                 	loop:
                 	ldi r20, 0b11111111 //data
                 	ldi r21, 0xff //
                 	rcall SendLcd
                 	inc rami
                 	cpi		rami,0xFF
                 	brne	loop
                 	
                  
                 	
                 	sbi PORTC, LCD_CS // disable device CS
                 	*/
                  Main:
                 
                 
                 
                 
                  
                 
000012 cfff      	rjmp Main
                 
                 
                  #include "wait.asm" ; AVR Assembler v.2
                 
                  * wait.asm
                  *
                  *  Created: 2015-01-01 18:40:21
                  *   Author: Mikael
                  */ 
                 
                 
                 ;------------------------------------------------------------------------------
                 ; Busy-wait loops utilities module
                 ; For F_CPU >= 4MHz
                 ; http://avr-mcu.dxp.pl
                 ; (c) Radoslaw Kwiecien, 2008
                 ;------------------------------------------------------------------------------
                 
                 #ifndef F_CPU
                 #endif
                 
                 #if F_CPU < 4000000
                 #endif
                 
                 #define CYCLES_PER_US (F_CPU/1000000)
                 #define C4PUS (CYCLES_PER_US/4)
                 #define DVUS(x) (C4PUS*x)
                 
                 ;------------------------------------------------------------------------------
                 ; Input : XH:XL - number of CPU cycles to wait (divided by four)
                 ;------------------------------------------------------------------------------
                 Wait4xCycles:
000013 9711        sbiw	  XH:XL, 1
000014 f7f1        brne	  Wait4xCycles
000015 9508        ret
                 ;------------------------------------------------------------------------------
                 ; Input : r16 - number of miliseconds to wait
                 ;------------------------------------------------------------------------------
                 WaitMiliseconds:
000016 930f        push	r16
                 WaitMsLoop: 
000017 e0b9        ldi	   XH,HIGH(DVUS(500))
000018 eca4        ldi	   XL,LOW(DVUS(500))
000019 dff9        rcall	 Wait4xCycles
00001a e0b9        ldi	   XH,HIGH(DVUS(500))
00001b eca4        ldi	   XL,LOW(DVUS(500))
00001c dff6        rcall	 Wait4xCycles
00001d 950a        dec	   r16
00001e f7c1        brne	  WaitMsLoop
00001f 910f        pop	   r16
000020 9508        ret
                 ;------------------------------------------------------------------------------
                 ; End of file
                  ;------------------------------------------------------------------------------
                 ; 1-wire definitions
                 ;------------------------------------------------------------------------------
                 .equ	OW_PORT	= PORTD
                 .equ	OW_PIN	= PIND
                 .equ	OW_DDR	= DDRD
                 .equ	OW_DQ	= PD1
                 
                 .def	OWCount = r17
                 ;------------------------------------------------------------------------------
                 ; 1-wire definitions
                 ;------------------------------------------------------------------------------
                 
                  ;------------------------------------------------------------------------------
                 ; NOKIA6100 definitions
                 ;------------------------------------------------------------------------------
                 .equ LCD_CS = PC2 
                 //.equ LCD_CLK = PB7 
                 .equ LCD_DATA = PB3 
                 .equ LCD_RESET = PC0
                 .equ SPI_PORT = PORTB
                 .equ SPI_SCK = PB5
                  ;------------------------------------------------------------------------------
                 ; NOKIA6100 definitions
                 ;------------------------------------------------------------------------------
                 
                 .cseg
                 
                 
                 NOKIA_LCD_init:
                 
000021 9a42      sbi PORTC, LCD_CS // disable device CS
                 
000022 9840      		cbi PORTC, LCD_RESET
000023 ec08      	ldi r16, 200
000024 dff1      	rcall	WaitMiliseconds
000025 9a40      		sbi PORTC, LCD_RESET
000026 ec08      	ldi r16, 200
000027 dfee      	rcall	WaitMiliseconds
                 	
000028 9842      cbi PORTC, LCD_CS // enable device CS
000029 e0b0      	ldi		XH, HIGH(DVUS(4))
00002a e1a4      	ldi		XL, LOW(DVUS(4))
00002b dfe7      	rcall	Wait4xCycles
                 
                 	
                 
