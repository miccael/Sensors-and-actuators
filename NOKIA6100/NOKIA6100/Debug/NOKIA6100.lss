                 ;------------------------------------------------------------------------------
                 ; Output : r16 - byte from slave
                 ;------------------------------------------------------------------------------
                 DAC:
                 
                  //---------------------1-wire init Vcc powered device Overdrive Mode---------------
000276 d063      	rcall OWReset
000277 e30c      	ldi r16, 0x3C     //Overdrive skip ROM
000278 d07e      	rcall OWWriteByte
000279 ec0c      	ldi r16, 0xCC     //Write Conditional Search Register command
00027a d03b      	rcall OWWriteByteOD
00027b e80d      	ldi r16, 0x8D     //TA1 beginning adress
00027c d039      	rcall OWWriteByteOD
00027d e000      	ldi r16, 0x00     //TA2 adress 008Dh
00027e d037      	rcall OWWriteByteOD
00027f e801      	ldi r16, 0x81     //data byte adress 008Dh
000280 d035      	rcall OWWriteByteOD
                 	//---------------------1-wire init Vcc powered device Overdrive Mode---------------
                 
000281 d017      	rcall OWResetOD
000282 e30c      	ldi r16, 0x3C     //Overdrive skip ROM
000283 d032      	rcall OWWriteByteOD
000284 ef00      	ldi r16, 0xF0     //Read PIO Registers command
000285 d030      	rcall OWWriteByteOD
000286 e80d      	ldi r16, 0x8D     //TA1 beginning adress
000287 d02e      	rcall OWWriteByteOD
000288 e000      	ldi r16, 0x00     //TA2 adress 008Dh
000289 d02c      	rcall OWWriteByteOD
00028a d046      	rcall OWReadByteOD //Read Control/Status Register and verify
                 
00028b d00d      	rcall OWResetOD
00028c e30c      	ldi r16, 0x3C     //Overdrive skip ROM
00028d d028      	rcall OWWriteByteOD
00028e e50a      	ldi r16, 0x5A     //Channel-access Write command
00028f d026      	rcall OWWriteByteOD
000290 2f02      	mov r16, r18     //Write byte to PIO
000291 d024      	rcall OWWriteByteOD
000292 2f02      	mov r16, r18     //
000293 9500      	com r16           //
                 	//ldi r16, 0xFF     //Write inverted byte to PIO
000294 d021      	rcall OWWriteByteOD
000295 d03b      	rcall OWReadByteOD //Read for verification (AAh = success)
000296 d03a      	rcall OWReadByteOD //Read PIO pin status
000297 d001      	rcall OWResetOD
                 	
000298 9508      ret
                 
                 
                 
                 ;-------------------Overdrive Mode Start---------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 ;------------------------------------------------------------------------------
                 ; Output : T - presence bit
                 ;------------------------------------------------------------------------------
                 OWResetOD:
000299 9859      	cbi		OW_PORT,OW_DQ
00029a 9a51      	sbi		OW_DDR,OW_DQ
                 
00029b e0b1      	ldi		XH, HIGH(DVUS(55))
00029c e1a3      	ldi		XL, LOW(DVUS(55))
00029d dd75      	rcall	Wait4xCycles
                 	
00029e 9851      	cbi		OW_DDR,OW_DQ
                 
00029f e0b0      	ldi		XH, HIGH(DVUS(8))
0002a0 e2a8      	ldi		XL, LOW(DVUS(8))
0002a1 dd71      	rcall	Wait4xCycles
                 
0002a2 9468      	set
0002a3 9b49      	sbis	OW_PIN,OW_DQ
0002a4 94e8      	clt
                 
0002a5 e0b0      	ldi		XH, HIGH(DVUS(48))
0002a6 efa0      	ldi		XL, LOW(DVUS(48))
0002a7 dd6b      	rcall	Wait4xCycles
                 
0002a8 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : C - bit to write
                 ;------------------------------------------------------------------------------
                 OWWriteBitOD:
0002a9 f418      	brcc	OWWriteZeroOD
0002aa e0b0      	ldi		XH, HIGH(DVUS(1))//Måste Kalibreras
0002ab e0a5      	ldi		XL, LOW(DVUS(1))//Måste Kalibreras
0002ac c002      	rjmp	OWWriteOneOD
                 OWWriteZeroOD:	
0002ad e0b0      	ldi		XH, HIGH(DVUS(10)) 
0002ae e3a2      	ldi		XL, LOW(DVUS(10)) 
                 OWWriteOneOD:
0002af 9a51      	sbi		OW_DDR, OW_DQ
0002b0 dd62      	rcall	Wait4xCycles
0002b1 9851      	cbi		OW_DDR, OW_DQ
                 	
0002b2 e0b0      	ldi		XH, HIGH(DVUS(10))
0002b3 e3a2      	ldi		XL, LOW(DVUS(10))
0002b4 dd5e      	rcall	Wait4xCycles
0002b5 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : r16 - byte to write
                 ;------------------------------------------------------------------------------
                 OWWriteByteOD:
0002b6 931f      	push	OWCount
0002b7 e010      	ldi		OWCount,0
                 OWWriteLoopOD:	
0002b8 9507      	ror		r16
0002b9 dfef      	rcall	OWWriteBitOD	
0002ba 9513      	inc		OWCount
0002bb 3018      	cpi		OWCount,8
