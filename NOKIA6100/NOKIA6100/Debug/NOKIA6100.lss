0000bb e0b0      		ldi		XH, HIGH(DVUS(4))
0000bc e1a4      		ldi		XL, LOW(DVUS(4))
0000bd df55      		rcall	Wait4xCycles
                 // set up first bit as command or data 
0000be fd40      sbrc r20,0
0000bf 9a2b      sbi SPI_PORT, LCD_DATA
0000c0 ff40      sbrs r20,0
0000c1 982b      cbi SPI_PORT, LCD_DATA
                 	
                 
