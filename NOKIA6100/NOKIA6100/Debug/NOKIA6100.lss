0000c2 e0b0      		ldi		XH, HIGH(DVUS(2))
0000c3 e0aa      		ldi		XL, LOW(DVUS(2))
0000c4 df4e      		rcall	Wait4xCycles
0000c5 9a2d       sbi SPI_PORT, SPI_SCK // Pull Clock HIGH 
0000c6 e0b0      	ldi		XH, HIGH(DVUS(4))
0000c7 e1a4      	ldi		XL, LOW(DVUS(4))
0000c8 df4a      	rcall	Wait4xCycles
0000c9 982d       cbi SPI_PORT, SPI_SCK // Pull Clock LOW 
