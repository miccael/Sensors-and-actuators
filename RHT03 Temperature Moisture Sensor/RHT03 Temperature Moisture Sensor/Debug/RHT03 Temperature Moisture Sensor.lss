                                 reset:
                                 ;; init the stack 
000014 ef0f                      ldi r16, low(RAMEND) 
000015 bf0d                      out SPL, r16
000016 e008                      ldi r16, high(RAMEND) 
000017 bf0e                      out SPH, r16 
                                 
                                 ;------------------------------------------------------------------------------
                                 ; 1-wire definitions
                                 ;------------------------------------------------------------------------------
                                 .equ	OW_PORT	= PORTD
                                 .equ	OW_PIN	= PIND
                                 .equ	OW_DDR	= DDRD
                                 .equ	OW_DQ	= PD4
                                 .def	OWCount = r17
                                 ;------------------------------------------------------------------------------
                                 ; 1-wire definitions
                                 ;------------------------------------------------------------------------------
                                  
                                 	//---------------RHT03 definitions and init--------------------
                                 	//-------------------------------------------------------------
                                 	.equ	RHT03_PORT	= PORTD
                                 	.equ	RHT03_PIN	= PIND
                                 	.equ	RHT03_DDR	= DDRD
                                 	.equ	RHT03_DQ	= PD3
                                 	.def RHT03_DATA = r23
                                 	.def RHT03_COUNT = r24
                                 
                                 	;cli
000018 9853                      	cbi		RHT03_DDR,RHT03_DQ
000019 2788                      	clr		RHT03_COUNT
                                 
00001a 9843                      	cbi		PORTC, PC3
00001b 9a3b                      	sbi		DDRC, PC3
                                 
                                 			//---------------Timer0 definitions and init: instead of using Timer0 maybe use the wait routine!!!!-------------------
                                 			//-------------------------------------------------------------
                                 			;ldi r16, (0<<COM0A1)|(0<<COM0A0)|(0<<COM0B1)|(0<<COM0B0)|(1<<WGM01)|(0<<WGM00)
                                 			;sts TCCR0A, r16
                                 			;ldi r16, (0<<WGM02)|(1<<CS02)|(0<<CS01)|(0<<CS00) //CTC mode, clkI/O/256 (From prescaler)
                                 			;sts TCCR0B, r16
                                 			;ldi r16, 0x80 //Calibrate to 30us
                                 			;sts OCR0A, r16
                                 			//---------------Timer0 definitions and init-------------------
                                 			//-------------------------------------------------------------
                                 
                                 			//---------------External interrupt definitions and init-------
                                 			//-------------------------------------------------------------
00001c e00c                      			ldi r16, (1<<ISC11)|(1<<ISC10)|(0<<ISC01)|(0<<ISC00) //The rising edge of INT1 generates an interrupt request.
00001d 9300 0069                 			sts EICRA, r16
00001f b30d                      			in r16, EIMSK  
000020 6002                       			ori r16, (1<<INT1)|(0<<INT0)   
000021 bb0d                       			out EIMSK, r16
                                 			//---------------External interrupt definitions and init-------
                                 			//-------------------------------------------------------------
                                 
                                 	//---------------RHT03 definitions and init--------------------
                                 	//-------------------------------------------------------------
                                 	
000022 d131                      	 rcall LCD
                                 
                                 	
                                 
                                 ; Replace with your application code
                                 main:
                                 
000023 ec08                      		ldi r16, 200
000024 dfe4                      		rcall	WaitMiliseconds //wait at least 1 s before starting to read from sensor
000025 ec08                      		ldi r16, 200
000026 dfe2                      		rcall	WaitMiliseconds
000027 ec08                      		ldi r16, 200
000028 dfe0                      		rcall	WaitMiliseconds //
000029 ec08                      		ldi r16, 200
00002a dfde                      		rcall	WaitMiliseconds
00002b ec08                      		ldi r16, 200
00002c dfdc                      		rcall	WaitMiliseconds
                                 
00002d d00e                      		rcall RHT03
                                 
                                 		count:
00002e 3288                      		cpi RHT03_COUNT, 40
00002f f3f0                      		brlo count
000030 2788                      		clr RHT03_COUNT		//clear the RHT03_COUNT data bit counter
000031 94f8                      		cli                         //disable Global interrupt
                                 		
000032 d046                      		rcall LCDwrite
                                 
000033 ec08                      		ldi r16, 200
000034 dfd4                      		rcall	WaitMiliseconds //wait
000035 ec08                      		ldi r16, 200
000036 dfd2                      		rcall	WaitMiliseconds
000037 ec08                      		ldi r16, 200
000038 dfd0                      		rcall	WaitMiliseconds //
000039 ec08                      		ldi r16, 200
00003a dfce                      		rcall	WaitMiliseconds
                                 
00003b cfe7                          rjmp main
                                 
                                 
                                 RHT03: //receive 40 bits
00003c 94f8                      	cli
00003d 985b                      	cbi		RHT03_PORT,RHT03_DQ
00003e 9a53                      	sbi		RHT03_DDR,RHT03_DQ
00003f e001                      	ldi r16, 1
000040 dfc8                      	rcall	WaitMiliseconds    //pull low 1 ms (1 ms is minimum)
000041 9853                      	cbi		RHT03_DDR,RHT03_DQ //important to change RHT03_DQ to a input for reading (use pull up resistor! OBS! Is pull up gonna work?)
000042 e0b4                      	ldi		XH, HIGH(DVUS(240)) //Wait 200 us (need to expand time a little bit?)
000043 eba0                      	ldi		XL, LOW(DVUS(240))
000044 dfc1                      	rcall	Wait4xCycles
000045 9478                      	sei							//enable Global interrupt
000046 9508                      ret
                                 
                                  
                                 EXT_INT1:
000047 930f                      		push r16 ; save a register to stack
000048 b70f                      		in r16,SREG ; read status register
000049 930f                      		push r16 ; and put on stack
                                 					;ldi r16, (0<<OCIE0B)|(1<<OCIE0A)|(0<<TOIE0) //Timer/Counter0 Output Compare Match A Interrupt Enable
                                 					;sts TIMSK0, r16
                                 			
                                 			
00004a e0b0                      			ldi		XH, HIGH(DVUS(35)) //Wait 35 us 
00004b eaaf                      			ldi		XL, LOW(DVUS(35))
00004c dfb9                      			rcall	Wait4xCycles
                                 
00004d 9583                      			inc RHT03_COUNT
                                 
                                 			RHT03ReadBit:
00004e 94e8                      				clt
00004f 994b                      				sbic	RHT03_PIN,RHT03_DQ
000050 9468                      				set
000051 9408                      				sec
000052 f00e                      				brts	RHT03ReadBitEnd
000053 9488                      				clc
                                 			RHT03ReadBitEnd:
000054 1f77                      				rol RHT03_DATA         //if MSB first on the bus "rol" command else if LSB is first "ror" command
                                 
                                 			    Store0:
000055 3288                      				cpi		RHT03_COUNT,40
000056 f419                      				brne	Store1
000057 9370 0104                 				sts RHT03BYTE5, RHT03_DATA
000059 2777                      				clr RHT03_DATA       //clear the RHT03_DATA data holder register
                                 				Store1:
00005a 3280                      				cpi		RHT03_COUNT,32
00005b f419                      				brne	Store2
00005c 9370 0103                 				sts RHT03BYTE4, RHT03_DATA
00005e 2777                      				clr RHT03_DATA      //clear the RHT03_DATA data holder register
                                 				Store2:
00005f 3188                      				cpi		RHT03_COUNT,24
000060 f419                      				brne	Store3
000061 9370 0102                 				sts RHT03BYTE3, RHT03_DATA
000063 2777                      				clr RHT03_DATA      //clear the RHT03_DATA data holder register
                                 				Store3:
000064 3180                      				cpi		RHT03_COUNT,16
000065 f419                      				brne	Store4
000066 9370 0101                 				sts RHT03BYTE2, RHT03_DATA
000068 2777                      				clr RHT03_DATA      //clear the RHT03_DATA data holder register
                                 				Store4:
000069 3088                      				cpi		RHT03_COUNT,8
00006a f451                      				brne	Store5
                                 
                                 				
00006b 9a43                      				sbi		PORTC, PC3
00006c 9a3b                      				sbi		DDRC, PC3
00006d e0b0                      				ldi		XH, HIGH(DVUS(2)) //Wait 2 us
00006e e0aa                      				ldi		XL, LOW(DVUS(2))
00006f df96                      				rcall	Wait4xCycles
000070 9843                      				cbi		PORTC, PC3
000071 9a3b                      				sbi		DDRC, PC3
                                 
                                 
000072 9370 0100                 				sts RHT03BYTE1, RHT03_DATA
000074 2777                      				clr RHT03_DATA       //clear the RHT03_DATA data holder register
                                 				Store5:
                                 				
000075 910f                      		pop r16 ; get previous flag register from stack
000076 bf0f                      		out SREG,r16 ; restore old status
000077 910f                      		pop r16 ; get previous content of R16 from the stack
000078 9518                      	reti
                                 
