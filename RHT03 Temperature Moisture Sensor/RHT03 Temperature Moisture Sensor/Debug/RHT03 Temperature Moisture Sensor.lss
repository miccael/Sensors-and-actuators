                                 DAC:
                                 
                                  //---------------------1-wire init Vcc powered device Overdrive Mode---------------
0001e9 d063                      	rcall OWReset
0001ea e30c                      	ldi r16, 0x3C     //Overdrive skip ROM
0001eb d07e                      	rcall OWWriteByte
0001ec ec0c                      	ldi r16, 0xCC     //Write Conditional Search Register command
0001ed d03b                      	rcall OWWriteByteOD
0001ee e80d                      	ldi r16, 0x8D     //TA1 beginning adress
0001ef d039                      	rcall OWWriteByteOD
0001f0 e000                      	ldi r16, 0x00     //TA2 adress 008Dh
0001f1 d037                      	rcall OWWriteByteOD
0001f2 e801                      	ldi r16, 0x81     //data byte adress 008Dh
0001f3 d035                      	rcall OWWriteByteOD
                                 	//---------------------1-wire init Vcc powered device Overdrive Mode---------------
                                 
0001f4 d017                      	rcall OWResetOD
0001f5 e30c                      	ldi r16, 0x3C     //Overdrive skip ROM
0001f6 d032                      	rcall OWWriteByteOD
0001f7 ef00                      	ldi r16, 0xF0     //Read PIO Registers command
0001f8 d030                      	rcall OWWriteByteOD
0001f9 e80d                      	ldi r16, 0x8D     //TA1 beginning adress
0001fa d02e                      	rcall OWWriteByteOD
0001fb e000                      	ldi r16, 0x00     //TA2 adress 008Dh
0001fc d02c                      	rcall OWWriteByteOD
0001fd d046                      	rcall OWReadByteOD //Read Control/Status Register and verify
                                 
0001fe d00d                      	rcall OWResetOD
0001ff e30c                      	ldi r16, 0x3C     //Overdrive skip ROM
000200 d028                      	rcall OWWriteByteOD
000201 e50a                      	ldi r16, 0x5A     //Channel-access Write command
000202 d026                      	rcall OWWriteByteOD
000203 2f02                      	mov r16, r18     //Write byte to PIO
000204 d024                      	rcall OWWriteByteOD
000205 2f02                      	mov r16, r18     //
000206 9500                      	com r16           //
                                 	//ldi r16, 0xFF     //Write inverted byte to PIO
000207 d021                      	rcall OWWriteByteOD
000208 d03b                      	rcall OWReadByteOD //Read for verification (AAh = success)
000209 d03a                      	rcall OWReadByteOD //Read PIO pin status
00020a d001                      	rcall OWResetOD
                                 	
00020b 9508                      ret
                                 
                                 
                                 
                                 ;-------------------Overdrive Mode Start---------------------------------------
                                 ;------------------------------------------------------------------------------
                                 
                                 ;------------------------------------------------------------------------------
                                 ; Output : T - presence bit
                                 ;------------------------------------------------------------------------------
                                 OWResetOD:
00020c 985c                      	cbi		OW_PORT,OW_DQ
00020d 9a54                      	sbi		OW_DDR,OW_DQ
                                 
00020e e0b1                      	ldi		XH, HIGH(DVUS(55))
00020f e1a3                      	ldi		XL, LOW(DVUS(55))
000210 ddf5                      	rcall	Wait4xCycles
                                 	
000211 9854                      	cbi		OW_DDR,OW_DQ
                                 
000212 e0b0                      	ldi		XH, HIGH(DVUS(8))
000213 e2a8                      	ldi		XL, LOW(DVUS(8))
000214 ddf1                      	rcall	Wait4xCycles
                                 
000215 9468                      	set
000216 9b4c                      	sbis	OW_PIN,OW_DQ
000217 94e8                      	clt
                                 
000218 e0b0                      	ldi		XH, HIGH(DVUS(48))
000219 efa0                      	ldi		XL, LOW(DVUS(48))
00021a ddeb                      	rcall	Wait4xCycles
                                 
00021b 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Input : C - bit to write
                                 ;------------------------------------------------------------------------------
                                 OWWriteBitOD:
00021c f418                      	brcc	OWWriteZeroOD
00021d e0b0                      	ldi		XH, HIGH(DVUS(1))//Måste Kalibreras
00021e e0a5                      	ldi		XL, LOW(DVUS(1))//Måste Kalibreras
00021f c002                      	rjmp	OWWriteOneOD
                                 OWWriteZeroOD:	
000220 e0b0                      	ldi		XH, HIGH(DVUS(10)) 
000221 e3a2                      	ldi		XL, LOW(DVUS(10)) 
                                 OWWriteOneOD:
000222 9a54                      	sbi		OW_DDR, OW_DQ
000223 dde2                      	rcall	Wait4xCycles
000224 9854                      	cbi		OW_DDR, OW_DQ
                                 	
000225 e0b0                      	ldi		XH, HIGH(DVUS(10))
000226 e3a2                      	ldi		XL, LOW(DVUS(10))
000227 ddde                      	rcall	Wait4xCycles
000228 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Input : r16 - byte to write
                                 ;------------------------------------------------------------------------------
                                 OWWriteByteOD:
000229 931f                      	push	OWCount
00022a e010                      	ldi		OWCount,0
                                 OWWriteLoopOD:	
00022b 9507                      	ror		r16
00022c dfef                      	rcall	OWWriteBitOD	
00022d 9513                      	inc		OWCount
00022e 3018                      	cpi		OWCount,8
00022f f7d9                      	brne	OWWriteLoopOD
000230 911f                      	pop		OWCount		
000231 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Output : C - bit from slave
                                 ;------------------------------------------------------------------------------
                                 OWReadBitOD:
000232 e0b0                      	ldi		XH, HIGH(DVUS(1)) //Måste kalibreras
000233 e0a5                      	ldi		XL, LOW(DVUS(1)) //Måste kalibreras
000234 9a54                      	sbi		OW_DDR, OW_DQ
000235 ddd0                      	rcall	Wait4xCycles
000236 9854                      	cbi		OW_DDR, OW_DQ
000237 e0b0                      	ldi		XH, HIGH(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent, 1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
000238 e0a5                      	ldi		XL, LOW(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent,  1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
000239 ddcc                      	rcall	Wait4xCycles
00023a 94e8                      	clt
00023b 994c                      	sbic	OW_PIN,OW_DQ
00023c 9468                      	set
00023d e0b0                      	ldi		XH, HIGH(DVUS(10))
00023e e3a2                      	ldi		XL, LOW(DVUS(10))
00023f ddc6                      	rcall	Wait4xCycles
000240 9408                      	sec
000241 f00e                      	brts	OWReadBitEndOD
000242 9488                      	clc
                                 OWReadBitEndOD:
000243 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Output : r16 - byte from slave
                                 ;------------------------------------------------------------------------------
                                 OWReadByteOD:
000244 931f                      	push	OWCount
000245 e010                      	ldi		OWCount,0
                                 OWReadLoopOD:
000246 dfeb                      	rcall	OWReadBitOD
000247 9507                      	ror		r16
000248 9513                      	inc		OWCount
000249 3018                      	cpi		OWCount,8
00024a f7d9                      	brne	OWReadLoopOD
00024b 911f                      	pop		OWCount
00024c 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ;
                                 ;------------------------------------------------------------------------------
                                 
                                 ;-------------------Overdrive Mode End-----------------------------------------
                                 ;------------------------------------------------------------------------------
                                 
                                 
                                 
                                 ;-------------------Standard Mode Start-----------------------------------------
                                 ;------------------------------------------------------------------------------
                                 
                                 ;------------------------------------------------------------------------------
                                 ; Output : T - presence bit
                                 ;------------------------------------------------------------------------------
                                 OWReset:
00024d 985c                      	cbi		OW_PORT,OW_DQ
00024e 9a54                      	sbi		OW_DDR,OW_DQ
                                 
00024f e0b9                      	ldi		XH, HIGH(DVUS(470))
000250 e2ae                      	ldi		XL, LOW(DVUS(470))
