000167 d017      	rcall OWResetOD
000168 e30c      	ldi r16, 0x3C     //Overdrive skip ROM
000169 d032      	rcall OWWriteByteOD
00016a ef00      	ldi r16, 0xF0     //Read PIO Registers command
00016b d030      	rcall OWWriteByteOD
00016c e80d      	ldi r16, 0x8D     //TA1 beginning adress
00016d d02e      	rcall OWWriteByteOD
00016e e000      	ldi r16, 0x00     //TA2 adress 008Dh
00016f d02c      	rcall OWWriteByteOD
000170 d046      	rcall OWReadByteOD //Read Control/Status Register and verify
                 
000171 d00d      	rcall OWResetOD
000172 e30c      	ldi r16, 0x3C     //Overdrive skip ROM
000173 d028      	rcall OWWriteByteOD
000174 e50a      	ldi r16, 0x5A     //Channel-access Write command
000175 d026      	rcall OWWriteByteOD
000176 2f02      	mov r16, r18     //Write byte to PIO
000177 d024      	rcall OWWriteByteOD
000178 2f02      	mov r16, r18     //
000179 9500      	com r16           //
                 	//ldi r16, 0xFF     //Write inverted byte to PIO
00017a d021      	rcall OWWriteByteOD
00017b d03b      	rcall OWReadByteOD //Read for verification (AAh = success)
00017c d03a      	rcall OWReadByteOD //Read PIO pin status
00017d d001      	rcall OWResetOD
                 	
00017e 9508      ret
                 
                 
                 
                 ;-------------------Overdrive Mode Start---------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 ;------------------------------------------------------------------------------
                 ; Output : T - presence bit
                 ;------------------------------------------------------------------------------
                 OWResetOD:
00017f 985a      	cbi		OW_PORT,OW_DQ
000180 9a52      	sbi		OW_DDR,OW_DQ
                 
000181 e0b1      	ldi		XH, HIGH(DVUS(55))
000182 e1a3      	ldi		XL, LOW(DVUS(55))
000183 dec2      	rcall	Wait4xCycles
                 	
000184 9852      	cbi		OW_DDR,OW_DQ
                 
000185 e0b0      	ldi		XH, HIGH(DVUS(8))
000186 e2a8      	ldi		XL, LOW(DVUS(8))
000187 debe      	rcall	Wait4xCycles
                 
000188 9468      	set
000189 9b4a      	sbis	OW_PIN,OW_DQ
00018a 94e8      	clt
                 
00018b e0b0      	ldi		XH, HIGH(DVUS(48))
00018c efa0      	ldi		XL, LOW(DVUS(48))
00018d deb8      	rcall	Wait4xCycles
                 
00018e 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : C - bit to write
                 ;------------------------------------------------------------------------------
                 OWWriteBitOD:
00018f f418      	brcc	OWWriteZeroOD
000190 e0b0      	ldi		XH, HIGH(DVUS(1))//Måste Kalibreras
000191 e0a5      	ldi		XL, LOW(DVUS(1))//Måste Kalibreras
000192 c002      	rjmp	OWWriteOneOD
                 OWWriteZeroOD:	
000193 e0b0      	ldi		XH, HIGH(DVUS(10)) 
000194 e3a2      	ldi		XL, LOW(DVUS(10)) 
                 OWWriteOneOD:
000195 9a52      	sbi		OW_DDR, OW_DQ
000196 deaf      	rcall	Wait4xCycles
000197 9852      	cbi		OW_DDR, OW_DQ
                 	
000198 e0b0      	ldi		XH, HIGH(DVUS(10))
000199 e3a2      	ldi		XL, LOW(DVUS(10))
00019a deab      	rcall	Wait4xCycles
00019b 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : r16 - byte to write
                 ;------------------------------------------------------------------------------
                 OWWriteByteOD:
00019c 931f      	push	OWCount
00019d e010      	ldi		OWCount,0
                 OWWriteLoopOD:	
00019e 9507      	ror		r16
00019f dfef      	rcall	OWWriteBitOD	
0001a0 9513      	inc		OWCount
0001a1 3018      	cpi		OWCount,8
0001a2 f7d9      	brne	OWWriteLoopOD
0001a3 911f      	pop		OWCount		
0001a4 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Output : C - bit from slave
                 ;------------------------------------------------------------------------------
                 OWReadBitOD:
0001a5 e0b0      	ldi		XH, HIGH(DVUS(1)) //Måste kalibreras
0001a6 e0a5      	ldi		XL, LOW(DVUS(1)) //Måste kalibreras
0001a7 9a52      	sbi		OW_DDR, OW_DQ
0001a8 de9d      	rcall	Wait4xCycles
0001a9 9852      	cbi		OW_DDR, OW_DQ
0001aa e0b0      	ldi		XH, HIGH(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent, 1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
0001ab e0a5      	ldi		XL, LOW(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent,  1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
0001ac de99      	rcall	Wait4xCycles
0001ad 94e8      	clt
0001ae 994a      	sbic	OW_PIN,OW_DQ
0001af 9468      	set
0001b0 e0b0      	ldi		XH, HIGH(DVUS(10))
0001b1 e3a2      	ldi		XL, LOW(DVUS(10))
0001b2 de93      	rcall	Wait4xCycles
0001b3 9408      	sec
0001b4 f00e      	brts	OWReadBitEndOD
0001b5 9488      	clc
                 OWReadBitEndOD:
0001b6 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Output : r16 - byte from slave
                 ;------------------------------------------------------------------------------
                 OWReadByteOD:
0001b7 931f      	push	OWCount
0001b8 e010      	ldi		OWCount,0
                 OWReadLoopOD:
0001b9 dfeb      	rcall	OWReadBitOD
0001ba 9507      	ror		r16
0001bb 9513      	inc		OWCount
0001bc 3018      	cpi		OWCount,8
0001bd f7d9      	brne	OWReadLoopOD
0001be 911f      	pop		OWCount
0001bf 9508      	ret
                 ;------------------------------------------------------------------------------
                 ;
                 ;------------------------------------------------------------------------------
                 
                 
                 
                 ;-------------------Overdrive Mode End-----------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 
                 ;-------------------Standard Mode Start-----------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 ;------------------------------------------------------------------------------
                 ; Output : T - presence bit
                 ;------------------------------------------------------------------------------
                 OWReset:
0001c0 985a      	cbi		OW_PORT,OW_DQ
0001c1 9a52      	sbi		OW_DDR,OW_DQ
                 
0001c2 e0b9      	ldi		XH, HIGH(DVUS(470))
0001c3 e2ae      	ldi		XL, LOW(DVUS(470))
0001c4 de81      	rcall	Wait4xCycles
                 	
0001c5 9852      	cbi		OW_DDR,OW_DQ
                 
0001c6 e0b1      	ldi		XH, HIGH(DVUS(70))
0001c7 e5ae      	ldi		XL, LOW(DVUS(70))
0001c8 de7d      	rcall	Wait4xCycles
                 
0001c9 9468      	set
0001ca 9b4a      	sbis	OW_PIN,OW_DQ
0001cb 94e8      	clt
                 
0001cc e0b4      	ldi		XH, HIGH(DVUS(240))
0001cd eba0      	ldi		XL, LOW(DVUS(240))
0001ce de77      	rcall	Wait4xCycles
                 
0001cf 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : C - bit to write
                 ;------------------------------------------------------------------------------
                 OWWriteBit:
0001d0 f418      	brcc	OWWriteZero
0001d1 e0b0      	ldi		XH, HIGH(DVUS(1))
0001d2 e0a5      	ldi		XL, LOW(DVUS(1))
0001d3 c002      	rjmp	OWWriteOne
                 OWWriteZero:	
0001d4 e0b1      	ldi		XH, HIGH(DVUS(70)) //Changed from 120
0001d5 e5ae      	ldi		XL, LOW(DVUS(70)) //Changed from 120
                 OWWriteOne:
0001d6 9a52      	sbi		OW_DDR, OW_DQ
0001d7 de6e      	rcall	Wait4xCycles
0001d8 9852      	cbi		OW_DDR, OW_DQ
                 	
0001d9 e0b1      	ldi		XH, HIGH(DVUS(60))
0001da e2ac      	ldi		XL, LOW(DVUS(60))
0001db de6a      	rcall	Wait4xCycles
0001dc 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : r16 - byte to write
                 ;------------------------------------------------------------------------------
                 OWWriteByte:
0001dd 931f      	push	OWCount
0001de e010      	ldi		OWCount,0
                 OWWriteLoop:	
0001df 9507      	ror		r16
0001e0 dfef      	rcall	OWWriteBit	
0001e1 9513      	inc		OWCount
0001e2 3018      	cpi		OWCount,8
0001e3 f7d9      	brne	OWWriteLoop
0001e4 911f      	pop		OWCount		
0001e5 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Output : C - bit from slave
                 ;------------------------------------------------------------------------------
                 OWReadBit:
0001e6 e0b0      	ldi		XH, HIGH(DVUS(1))
0001e7 e0a5      	ldi		XL, LOW(DVUS(1))
