0001e9 de5c      	rcall	Wait4xCycles
0001ea 9852      	cbi		OW_DDR, OW_DQ
0001eb e0b0      	ldi		XH, HIGH(DVUS(8)) //Kolla så att sampling inte sker försent, max 15us tRD - READ VALID, pga oexakta tider, oscilloskop!
0001ec e2a8      	ldi		XL, LOW(DVUS(8)) //Kolla så att sampling inte sker försent, max 15us tRD - READ VALID, pga oexakta tider, oscilloskop!
0001ed de58      	rcall	Wait4xCycles
0001ee 94e8      	clt
0001ef 994a      	sbic	OW_PIN,OW_DQ
0001f0 9468      	set
0001f1 e0b0      	ldi		XH, HIGH(DVUS(50))
0001f2 efaa      	ldi		XL, LOW(DVUS(50))
0001f3 de52      	rcall	Wait4xCycles
0001f4 9408      	sec
0001f5 f00e      	brts	OWReadBitEnd
0001f6 9488      	clc
                 OWReadBitEnd:
0001f7 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Output : r16 - byte from slave
                 ;------------------------------------------------------------------------------
                 OWReadByte:
0001f8 931f      	push	OWCount
0001f9 e010      	ldi		OWCount,0
                 OWReadLoop:
0001fa dfeb      	rcall	OWReadBit
0001fb 9507      	ror		r16
0001fc 9513      	inc		OWCount
0001fd 3018      	cpi		OWCount,8
0001fe f7d9      	brne	OWReadLoop
0001ff 911f      	pop		OWCount
000200 9508      	ret
