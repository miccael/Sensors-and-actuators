                  #include "wait.asm" ; AVR Assembler v.2
                 
                  * wait.asm
                  *
                  *  Created: 2015-01-01 18:40:21
                  *   Author: Mikael
                  */ 
                 
                 
                 ;------------------------------------------------------------------------------
                 ; Busy-wait loops utilities module
                 ; For F_CPU >= 4MHz
                 ; http://avr-mcu.dxp.pl
                 ; (c) Radoslaw Kwiecien, 2008
                 ;------------------------------------------------------------------------------
                 
                 #ifndef F_CPU
                 #endif
                 
                 #if F_CPU < 4000000
                 #endif
                 
                 #define CYCLES_PER_US (F_CPU/1000000)
                 #define C4PUS (CYCLES_PER_US/4)
                 #define DVUS(x) (C4PUS*x)
                 
                 ;------------------------------------------------------------------------------
                 ; Input : XH:XL - number of CPU cycles to wait (divided by four)
                 ;------------------------------------------------------------------------------
                 Wait4xCycles:
000046 9711        sbiw	  XH:XL, 1
000047 f7f1        brne	  Wait4xCycles
000048 9508        ret
                 ;------------------------------------------------------------------------------
                 ; Input : r16 - number of miliseconds to wait
                 ;------------------------------------------------------------------------------
                 WaitMiliseconds:
000049 930f        push	r16
                 WaitMsLoop: 
00004a e0b9        ldi	   XH,HIGH(DVUS(500))
00004b eca4        ldi	   XL,LOW(DVUS(500))
00004c dff9        rcall	 Wait4xCycles
00004d e0b9        ldi	   XH,HIGH(DVUS(500))
00004e eca4        ldi	   XL,LOW(DVUS(500))
00004f dff6        rcall	 Wait4xCycles
000050 950a        dec	   r16
000051 f7c1        brne	  WaitMsLoop
000052 910f        pop	   r16
000053 9508        ret
                 ;------------------------------------------------------------------------------
                 ; End of file
                  ;------------------------------------------------------------------------------
                 ; 1-wire definitions
                 ;------------------------------------------------------------------------------
                 .equ	OW_PORT	= PORTD
                 .equ	OW_PIN	= PIND
                 .equ	OW_DDR	= DDRD
                 .equ	OW_DQ	= PD2
                 
                 .def	OWCount = r17
                 ;------------------------------------------------------------------------------
                 ; 1-wire definitions
                 ;------------------------------------------------------------------------------
                 
                 
                 
                 .cseg
                 
                 SRF01Break:
                 	/*setting up for baud 4800 @ 20MHz fosc*/
                 	/* IMPORTANT: The Baud Rate must be set after the transmitter is enabled
                 	*/
                 	
000054 e001      	ldi r16, 0b00000001
000055 9300 00c5 	sts UBRR0H, r16
000057 e003      	ldi r16, 0b00000011
000058 9300 00c4 	sts UBRR0L, r16
                 
                 	/* Wait for empty transmit buffer */
                 	//while ( !( UCSR0A & (1<<UDRE0)) );
                     waitETB_Break:
00005a 9100 00c0 	lds r16,UCSR0A
00005c ff05      	sbrs r16,UDRE0
00005d cffc      	rjmp waitETB_Break
                 	/* Put data into buffer, sends the data */
00005e e000      	ldi r16, 0b00000000
00005f 9300 00c6 	sts UDR0, r16
000061 9508      ret
                 
                 SRF01Transmit:
                 	/*setting up for baud 9600 @ 20MHz fosc*/
                 	/* IMPORTANT: The Baud Rate must be set after the transmitter is enabled
                 	*/
                 	
000062 e000      	ldi r16, 0b00000000
000063 9300 00c5 	sts UBRR0H, r16
000065 e800      	ldi r16, 0b10000000
000066 9300 00c4 	sts UBRR0L, r16
                 
                 	/* Wait for empty transmit buffer */
                 	//while ( !( UCSR0A & (1<<UDRE0)) );
                     waitETB_Transmit:
000068 9100 00c0 	lds r16,UCSR0A
00006a ff05      	sbrs r16,UDRE0
00006b cffc      	rjmp waitETB_Transmit
                 	/* Put data into buffer, sends the data */
00006c 2f08      	mov r16, tDATA
00006d 9300 00c6 	sts UDR0, r16
00006f 9508      ret
                 
                 SRF01Receive:
                 	/*setting up for baud 9600 @ 20MHz fosc*/
                 	/* IMPORTANT: The Baud Rate must be set after the transmitter is enabled
                 	*/
                 	
                 	//ldi r16, 0b00000000
                 	//sts UBRR0H, r16
                 	//ldi r16, 0b10000000
                 	//sts UBRR0L, r16
                 
                 	; Wait for data to be received
                 	wait_Receive:
000070 9100 00c0 	lds r16, UCSR0A
000072 ff07      	sbrs r16, RXC0
000073 cffc      	rjmp wait_Receive
                 	; Get and return received data from buffer
000074 9100 00c6 	lds r16, UDR0
000076 2f70      	mov rDATA, r16
                 
                 	
                 	
000077 9508      ret
                 
