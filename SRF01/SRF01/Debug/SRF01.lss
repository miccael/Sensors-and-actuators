00001c d02c      	rcall	WaitMiliseconds	
00001d e001      ldi r16, 0x01 //adress
00001e 2f80      mov tDATA, r16
00001f d042      rcall SRF01Transmit
000020 e00f      	ldi r16, 15 ;wait
000021 d027      	 rcall	WaitMiliseconds
000022 e602      ldi r16, 0x62 //98, range down to zero (factory default)
000023 2f80      mov tDATA, r16
000024 d03d      rcall SRF01Transmit
                 
000025 e00f      	 ldi r16, 15 ;wait
000026 d022      	 rcall	WaitMiliseconds
000027 d02c      rcall SRF01Break
000028 e00f      	ldi r16, 15 ;wait
000029 d01f      	rcall	WaitMiliseconds	
