                 DAC:
                 
                  //---------------------1-wire init Vcc powered device Overdrive Mode---------------
00015c d063      	rcall OWReset
00015d e30c      	ldi r16, 0x3C     //Overdrive skip ROM
00015e d07e      	rcall OWWriteByte
00015f ec0c      	ldi r16, 0xCC     //Write Conditional Search Register command
000160 d03b      	rcall OWWriteByteOD
000161 e80d      	ldi r16, 0x8D     //TA1 beginning adress
000162 d039      	rcall OWWriteByteOD
000163 e000      	ldi r16, 0x00     //TA2 adress 008Dh
000164 d037      	rcall OWWriteByteOD
000165 e801      	ldi r16, 0x81     //data byte adress 008Dh
000166 d035      	rcall OWWriteByteOD
