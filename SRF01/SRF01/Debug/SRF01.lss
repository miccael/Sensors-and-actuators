00002b 2f80      mov tDATA, r16
00002c d035      rcall SRF01Transmit
00002d e00f      	ldi r16, 15 ;wait
00002e d01a      	 rcall	WaitMiliseconds
00002f e501      ldi r16, 0x51 //81, Real Ranging Mode - Result in centimeters
000030 2f80      mov tDATA, r16
000031 d030      rcall SRF01Transmit
000032 e906      	 ldi r16, 150 ;wait at least 70 mS.
000033 d015      	 rcall	WaitMiliseconds
000034 d01f      rcall SRF01Break	
000035 e00f      	 ldi r16, 15 ;wait
000036 d012      	 rcall	WaitMiliseconds
000037 e001      ldi r16, 0x01 //adress
000038 2f80      mov tDATA, r16
000039 d028      rcall SRF01Transmit
00003a e00f      	 ldi r16, 15 ;wait
00003b d00d      	 rcall	WaitMiliseconds
00003c e50e      ldi r16, 0x5E //94, Get Range, returns two bytes (high byte first) from the most recent ranging.
00003d 2f80      mov tDATA, r16
00003e d023      rcall SRF01Transmit
00003f e00f      	 ldi r16, 15 ;wait
000040 d008      	 rcall	WaitMiliseconds
000041 d02e      rcall SRF01Receive
000042 e00f      	ldi r16, 15 ;wait
