                 SRF02Write://(byte adress, byte data){
                   
                  
                     //TWCR = (1<<TWINT)|(1<<TWSTA)|
                     //(1<<TWEN);
000097 ea04      	ldi r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
000098 9300 00bc 	sts TWCR, r16
                     
                     //while (!(TWCR & (1<<TWINT)))
                     ;
                     wait1:
00009a 9100 00bc 	lds r16,TWCR
00009c ff07      	sbrs r16,TWINT
00009d cffc      	rjmp wait1
                 
                     //if ((TWSR & 0xF8) != START)
                     //ERROR();
00009e 9100 00b9     lds r16,TWSR
0000a0 7f08      	andi r16, 0xF8
0000a1 3008      	cpi r16, START
0000a2 f791      	brne ERROR1
                 
                 	
                     //TWDR = SLA_W;
                     //TWCR = (1<<TWINT) |
                     //(1<<TWEN);
0000a3 ee00      	ldi r16, SLA_W
0000a4 9300 00bb 	sts TWDR, r16
0000a6 e804      	ldi r16, (1<<TWINT)|(1<<TWEN)
0000a7 9300 00bc 	sts TWCR, r16
                     
                 	
                     //while (!(TWCR & (1<<TWINT)))
                     //;
                 	wait2:
0000a9 9100 00bc 	lds r16,TWCR
0000ab ff07      	sbrs r16,TWINT
0000ac cffc      	rjmp wait2
                 
                     
                     //if ((TWSR & 0xF8) !=
                     //MT_SLA_ACK)
                     //ERROR();
0000ad 9100 00b9 	lds r16,TWSR
0000af 7f08      	andi r16, 0xF8
0000b0 3108      	cpi r16, MT_SLA_ACK
0000b1 f719      	brne ERROR1
                 
                     
                 	
                 
                     //---------------------
                     //TWDR = adress; //
                     //TWCR = (1<<TWINT) |
                     //(1<<TWEN);
0000b2 2f04          mov r16, ADRESS //ex. ADRESS
0000b3 9300 00bb 	sts TWDR, r16
0000b5 e804      	ldi r16, (1<<TWINT)|(1<<TWEN)
0000b6 9300 00bc 	sts TWCR, r16
                 
                 	
                     //while (!(TWCR & (1<<TWINT)))
                     //;
                 	wait3:
0000b8 9100 00bc 	lds r16,TWCR
0000ba ff07      	sbrs r16,TWINT
0000bb cffc      	rjmp wait3
                     
                 	
                     //if ((TWSR & 0xF8) !=
                     //MT_DATA_ACK)
                     //ERROR();
0000bc 9100 00b9 	lds r16,TWSR
0000be 7f08      	andi r16, 0xF8
0000bf 3208      	cpi r16, MT_DATA_ACK
0000c0 f6a1      	brne ERROR1
                 	//---------------------
                 
                    
                     //---------------------
                     //TWDR = data; //
                     //TWCR = (1<<TWINT) |
                     //(1<<TWEN);
0000c1 2f05          mov r16, DATA //ex. DATA
0000c2 9300 00bb 	sts TWDR, r16
0000c4 e804      	ldi r16, (1<<TWINT)|(1<<TWEN)
0000c5 9300 00bc 	sts TWCR, r16
                 
                 	
                     //while (!(TWCR & (1<<TWINT)))
                     //;
                 	wait4:
0000c7 9100 00bc 	lds r16,TWCR
0000c9 ff07      	sbrs r16,TWINT
0000ca cffc      	rjmp wait4
                     
                 	
                     //if ((TWSR & 0xF8) !=
                     //MT_DATA_ACK)
                     //ERROR();
0000cb 9100 00b9 	lds r16,TWSR
0000cd 7f08      	andi r16, 0xF8
0000ce 3208      	cpi r16, MT_DATA_ACK
0000cf f629      	brne ERROR1
                 	//---------------------
                     
                     
                     //TWCR = (1<<TWINT)|(1<<TWEN)|
                     //(1<<TWSTO);
0000d0 e904      	ldi r16,(1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
0000d1 9300 00bc 	sts TWCR, r16
                 
0000d3 9508      ret
                 
                 
                 ERROR2: 
0000d4 dfa6      rcall signal2
0000d5 9508      ret
                 
                 SRF02Read://(byte adress){
                 
                 
                       //byte data;  
                        
                       //TWCR = (1<<TWINT)|(1<<TWSTA)|
                       //(1<<TWEN); //Start Condition
0000d6 ea04      	  ldi r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
0000d7 9300 00bc 	  sts TWCR, r16
                       
                       //while (!(TWCR & (1<<TWINT)))
                       //;
                 	  wait5:
0000d9 9100 00bc 	  lds r16,TWCR
0000db ff07      	  sbrs r16,TWINT
0000dc cffc      	  rjmp wait5
                 
                       
                       //if ((TWSR & 0xF8) != START)
                       //ERROR();
0000dd 9100 00b9 	  lds r16,TWSR
0000df 7f08      	  andi r16, 0xF8
0000e0 3008      	  cpi r16, START
0000e1 f791      	  brne ERROR2
                       
                 
                 	  
                       //TWDR = SLA_W;
                       //TWCR = (1<<TWINT) |
                       //(1<<TWEN);
0000e2 ee00      	  ldi r16, SLA_W
0000e3 9300 00bb 	  sts TWDR, r16
0000e5 e804      	  ldi r16, (1<<TWINT)|(1<<TWEN)
0000e6 9300 00bc 	  sts TWCR, r16
                       
                 	  
                       //while (!(TWCR & (1<<TWINT)))
                       //;
                       wait6:
0000e8 9100 00bc 	  lds r16,TWCR
0000ea ff07      	  sbrs r16,TWINT
0000eb cffc      	  rjmp wait6
                 
                 	 
                       //if ((TWSR & 0xF8) !=
                       //MT_SLA_ACK)
                       //ERROR();
0000ec 9100 00b9 	  lds r16,TWSR
0000ee 7f08      	  andi r16, 0xF8
0000ef 3108      	  cpi r16, MT_SLA_ACK
0000f0 f719      	  brne ERROR2
                       
                 	  //---------------------
                     //TWDR = adress; //
                     //TWCR = (1<<TWINT) |
                     //(1<<TWEN);
0000f1 2f04          mov r16, ADRESS //ex. ADRESS
0000f2 9300 00bb 	sts TWDR, r16
0000f4 e804      	ldi r16, (1<<TWINT)|(1<<TWEN)
0000f5 9300 00bc 	sts TWCR, r16
                 
                 	
                     //while (!(TWCR & (1<<TWINT)))
                     //;
                 	wait7:
0000f7 9100 00bc 	lds r16,TWCR
0000f9 ff07      	sbrs r16,TWINT
0000fa cffc      	rjmp wait7
                     
                 	
                     //if ((TWSR & 0xF8) !=
                     //MT_DATA_ACK)
                     //ERROR();
0000fb 9100 00b9 	lds r16,TWSR
0000fd 7f08      	andi r16, 0xF8
0000fe 3208      	cpi r16, MT_DATA_ACK
0000ff f571      	brne ERROR3
                 	//---------------------
                 
                      
                 	 
                       //TWCR = (1<<TWINT)|(1<<TWSTA)|
                       //(1<<TWEN); //Repeated Start Condition
000100 ea04            ldi r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
000101 9300 00bc 	  sts TWCR, r16
                 	  
                 	  
                       //while (!(TWCR & (1<<TWINT)))
                       //;
                       wait8:
000103 9100 00bc 	  lds r16,TWCR
000105 ff07      	  sbrs r16,TWINT
000106 cffc      	  rjmp wait8
                 
                 	  
                       //if ((TWSR & 0xF8) != R_START)
                       //ERROR();
000107 9100 00b9 	  lds r16,TWSR
000109 7f08      	  andi r16, 0xF8
00010a 3100      	  cpi r16, R_START
00010b f511      	  brne ERROR3
                       
                       
                       //TWDR = SLA_R;
                       //TWCR = (1<<TWINT) |
                       //(1<<TWEN);
00010c ee01            ldi r16, SLA_R
00010d 9300 00bb 	  sts TWDR, r16
00010f e804      	  ldi r16, (1<<TWINT)|(1<<TWEN)
000110 9300 00bc 	  sts TWCR, r16
                 
                 	  
                       //while (!(TWCR & (1<<TWINT)))
                       //;
                 	  wait9:
000112 9100 00bc 	  lds r16,TWCR
000114 ff07      	  sbrs r16,TWINT
000115 cffc      	  rjmp wait9
                       
                 	 
                       //if ((TWSR & 0xF8) !=
                       //MR_SLA_ACK)
                       //ERROR();
000116 9100 00b9 	  lds r16,TWSR
000118 7f08      	  andi r16, 0xF8
000119 3400      	  cpi r16, MR_SLA_ACK
00011a f499      	  brne ERROR3
                       
                       
                       //TWCR = (1<<TWINT) |
                       //(0<<TWEA)|(1<<TWEN); //Data byte will be received and 
                                             //NOT ACK TWEA=0 will be returned
00011b e804            ldi r16, (1<<TWINT)|(0<<TWEA)|(1<<TWEN)
00011c 9300 00bc 	  sts TWCR, r16
                 	  
                 	  
                       //while (!(TWCR & (1<<TWINT)))
                       //;
                 	  wait10:
00011e 9100 00bc 	  lds r16,TWCR
000120 ff07      	  sbrs r16,TWINT
000121 cffc      	  rjmp wait10
                       
                 	  
                       //if ((TWSR & 0xF8) !=
                       //MR_DATA_NOACK)
                       //ERROR();
000122 9100 00b9 	  lds r16,TWSR
000124 7f08      	  andi r16, 0xF8
000125 3508      	  cpi r16, MR_DATA_NOACK
000126 f439      	  brne ERROR3
                       
                      
                       //data = TWDR; //read data byte
000127 9100 00bb       lds r16,TWDR
000129 2f50      	  mov DATA,r16
                 
                       
                       //TWCR = (1<<TWINT)|(1<<TWEN)|
                       //(1<<TWSTO); // Send a Stop Condition
00012a e904            ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
00012b 9300 00bc 	  sts TWCR, r16
                 
                 	  
                       //return data;
                 
00012d 9508      ret
                 
                 ERROR3:
00012e df59      rcall signal3 
00012f 9508      ret
                 
