                  //---------System Clock init----------------
                   #define F_CPU 20000000 //
                 
                  //ldi r16, 0xFF
                  //out OSCCAL, r16
                 
                 /* ldi r16,(1<<CLKPS3)|(0<<CLKPS2)|(0<<CLKPS1)|(0<<CLKPS0)
                  out CLKPR, r16 //prescaler 256*/
                  //---------System Clock init----------------
                  
                 
                 
000000 e008        ldi r16, (1<<DDD3)
000001 b90a        out DDRD, r16
                   
                  
000002 d12d       rcall LCD
                 
                 	
                 
                 	
                 	//---------------I2C definitions and init----------------------
                 	//-------------------------------------------------------------
                 	.def Count = r22
                 	.def ADRESS = r20
                 	.def DATA = r21
                 	.equ SLA_W = 0xE0; //0xE0 slave adress, 0x70 and W=0
                 	.equ SLA_R = 0xE1; //0xE1 slave adress, 0x70 and W=1
                 	.equ START = 0x08;
                 	.equ R_START = 0x10;
                 	.equ MT_SLA_ACK = 0x18;
                 	.equ MR_SLA_ACK = 0x40;
                 	.equ MT_DATA_ACK = 0x28;
                 	.equ MR_DATA_ACK = 0x50;
                 	.equ MR_DATA_NOACK = 0x58;
                 
                 
                 	
                 	//------------SCL speed-----------
000003 ef0f      	ldi r16, 0xFF
000004 9300 00b8 	sts TWBR, r16
000006 e003      	ldi r16, (1<<TWPS1)|(1<<TWPS0) //Prescaler 64
000007 9300 00b9 	sts TWSR, r16
                 	 //--------------------------------
                 
                 	 //Must be written to enable 2-wire serial interface
000009 e000      	 ldi r16, (0<<PRTWI)
00000a 9300 0064 	 sts PRR, r16
                 	 //---------------------------
                 
00000c e000      	 ldi r16, (0<<DDC4) //PC4 SDA [27] input
00000d b907      	 out DDRC, r16		//PC4 SDA [27] input
                 	 //---------------I2C definitions and init-----------------------
                 	 //--------------------------------------------------------------
                 	
00000e d2e2      	rcall OWResetWS2811
00000f e001      	ldi r16, 1
000010 d019      	rcall	WaitMiliseconds
000011 e000      	ldi r16, 0x00
000012 d2ba      	rcall WS2811
000013 e000      	ldi r16, 0x00
000014 d2b8      	rcall WS2811
000015 e000      	ldi r16, 0x00
000016 d2b6      	rcall WS2811
000017 d2d9      	rcall OWResetWS2811
000018 e001      	ldi r16, 1
000019 d010      	rcall	WaitMiliseconds
                 
                 
                 	
                 
                  Main:
                 
00001a ec08      		ldi r16, 200
00001b d00e      		rcall	WaitMiliseconds
                  //--------------------I2C SRF02---------------
                  
00001c e040       ldi ADRESS, 0x00 //Command register
00001d e551       ldi DATA, 0x51 //0x51 Real Ranging Mode - Result in centimeters (0x60 Autotune force)
00001e d078       rcall SRF02Write
                 
00001f e406      		ldi r16, 70
000020 d009      		rcall	WaitMiliseconds
                 
000021 e043       ldi ADRESS, 0x03 //Range Low byte 16cm to 255 cm, 256 cm require the range high byte
000022 d0b3       rcall SRF02Read
                  //mov r16, DATA //result in DATA
                  //--------------------------------------------
000023 ec08      		ldi r16, 200
000024 d005      		rcall	WaitMiliseconds
                 
000025 d00f      rcall LCDwrite
