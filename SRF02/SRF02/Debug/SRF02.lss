                  #include "wait.asm" ; AVR Assembler v.2
                 
                  * wait.asm
                  *
                  *  Created: 2015-01-01 18:40:21
                  *   Author: Mikael
                  */ 
                 
                 
                 ;------------------------------------------------------------------------------
                 ; Busy-wait loops utilities module
                 ; For F_CPU >= 4MHz
                 ; http://avr-mcu.dxp.pl
                 ; (c) Radoslaw Kwiecien, 2008
                 ;------------------------------------------------------------------------------
                 
                 #ifndef F_CPU
                 #endif
                 
                 #if F_CPU < 4000000
                 #endif
                 
                 #define CYCLES_PER_US (F_CPU/1000000)
                 #define C4PUS (CYCLES_PER_US/4)
                 #define DVUS(x) (C4PUS*x)
                 
                 ;------------------------------------------------------------------------------
                 ; Input : XH:XL - number of CPU cycles to wait (divided by four)
                 ;------------------------------------------------------------------------------
                 Wait4xCycles:
000027 9711        sbiw	  XH:XL, 1
000028 f7f1        brne	  Wait4xCycles
000029 9508        ret
                 ;------------------------------------------------------------------------------
                 ; Input : r16 - number of miliseconds to wait
                 ;------------------------------------------------------------------------------
                 WaitMiliseconds:
00002a 930f        push	r16
                 WaitMsLoop: 
00002b e0b9        ldi	   XH,HIGH(DVUS(500))
00002c eca4        ldi	   XL,LOW(DVUS(500))
00002d dff9        rcall	 Wait4xCycles
00002e e0b9        ldi	   XH,HIGH(DVUS(500))
00002f eca4        ldi	   XL,LOW(DVUS(500))
000030 dff6        rcall	 Wait4xCycles
000031 950a        dec	   r16
000032 f7c1        brne	  WaitMsLoop
000033 910f        pop	   r16
000034 9508        ret
                 ;------------------------------------------------------------------------------
                 ; End of file
                  ;------------------------------------------------------------------------------
                 ; 1-wire definitions
                 ;------------------------------------------------------------------------------
                 .equ	OW_PORT	= PORTD
                 .equ	OW_PIN	= PIND
                 .equ	OW_DDR	= DDRD
                 .equ	OW_DQ	= PD1
                 
                 .def	OWCount = r17
                 ;------------------------------------------------------------------------------
                 ; 1-wire definitions
                 ;------------------------------------------------------------------------------
                 
                 
                 
                 .cseg
                 
