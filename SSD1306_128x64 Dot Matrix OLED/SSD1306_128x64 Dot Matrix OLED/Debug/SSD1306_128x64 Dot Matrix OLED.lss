                                 ;writes two bytes with the selected start register
                                 SSD1306Write://(byte command, byte data){
                                   
                                  
                                     //TWCR = (1<<TWINT)|(1<<TWSTA)|
                                     //(1<<TWEN);
0001ad ea04                      	ldi r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
0001ae 9300 00bc                 	sts TWCR, r16
                                     
                                     //while (!(TWCR & (1<<TWINT)))
                                     ;
                                     wait1:
0001b0 9100 00bc                 	lds r16,TWCR
0001b2 ff07                      	sbrs r16,TWINT
0001b3 cffc                      	rjmp wait1
                                 
                                     //if ((TWSR & 0xF8) != START)
                                     //ERROR();
0001b4 9100 00b9                     lds r16,TWSR
0001b6 7f08                      	andi r16, 0xF8
0001b7 3008                      	cpi r16, START
0001b8 f799                      	brne ERROR1
                                 
                                 	
                                     //TWDR = SLA_W;
                                     //TWCR = (1<<TWINT) |
                                     //(1<<TWEN);
0001b9 e708                      	ldi r16, SLA_W
0001ba 9300 00bb                 	sts TWDR, r16
0001bc e804                      	ldi r16, (1<<TWINT)|(1<<TWEN)
0001bd 9300 00bc                 	sts TWCR, r16
                                     
                                 	
                                     //while (!(TWCR & (1<<TWINT)))
                                     //;
                                 	wait2:
0001bf 9100 00bc                 	lds r16,TWCR
0001c1 ff07                      	sbrs r16,TWINT
0001c2 cffc                      	rjmp wait2
                                 
                                     
                                     //if ((TWSR & 0xF8) !=
                                     //MT_SLA_ACK)
                                     //ERROR();
0001c3 9100 00b9                 	lds r16,TWSR
0001c5 7f08                      	andi r16, 0xF8
0001c6 3108                      	cpi r16, MT_SLA_ACK
0001c7 f721                      	brne ERROR1
                                 
                                     
                                 	
                                 
                                     //---------------------
                                     //TWDR = command; //
                                     //TWCR = (1<<TWINT) |
                                     //(1<<TWEN);
0001c8 2f03                          mov r16, COMMAND //ex. COMMAND
0001c9 9300 00bb                 	sts TWDR, r16
0001cb e804                      	ldi r16, (1<<TWINT)|(1<<TWEN)
0001cc 9300 00bc                 	sts TWCR, r16
                                 
                                 	
                                     //while (!(TWCR & (1<<TWINT)))
                                     //;
                                 	wait3:
0001ce 9100 00bc                 	lds r16,TWCR
0001d0 ff07                      	sbrs r16,TWINT
0001d1 cffc                      	rjmp wait3
                                     
                                 	
                                     //if ((TWSR & 0xF8) !=
                                     //MT_DATA_ACK)
                                     //ERROR();
0001d2 9100 00b9                 	lds r16,TWSR
0001d4 7f08                      	andi r16, 0xF8
0001d5 3208                      	cpi r16, MT_DATA_ACK
0001d6 f499                      	brne ERROR2
                                 	//---------------------
                                 
                                     //---------------------
                                     //TWDR = data_msb; //
                                     //TWCR = (1<<TWINT) |
                                     //(1<<TWEN);
0001d7 2f04                          mov r16, DATA //ex. DATA
0001d8 9300 00bb                 	sts TWDR, r16
0001da e804                      	ldi r16, (1<<TWINT)|(1<<TWEN)
0001db 9300 00bc                 	sts TWCR, r16
                                 
                                 	
                                     //while (!(TWCR & (1<<TWINT)))
                                     //;
                                 	wait4:
0001dd 9100 00bc                 	lds r16,TWCR
0001df ff07                      	sbrs r16,TWINT
0001e0 cffc                      	rjmp wait4
                                     
                                 	
                                     //if ((TWSR & 0xF8) !=
                                     //MT_DATA_ACK)
                                     //ERROR();
0001e1 9100 00b9                 	lds r16,TWSR
0001e3 7f08                      	andi r16, 0xF8
0001e4 3208                      	cpi r16, MT_DATA_ACK
0001e5 f421                      	brne ERROR2
                                 	//---------------------
                                 
                                 
                                     //TWCR = (1<<TWINT)|(1<<TWEN)|
                                     //(1<<TWSTO);
0001e6 e904                      	ldi r16,(1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
0001e7 9300 00bc                 	sts TWCR, r16
                                 
0001e9 9508                      ret
                                 
                                 
                                 ERROR2: 
                                 ;rcall LCD
0001ea 9508                      ret
                                 
                                 ;reads two bytes with the selected start register
                                 SSD1306Read://(byte command){
                                 
                                 
                                       //byte data;  
                                        
                                       //TWCR = (1<<TWINT)|(1<<TWSTA)|
                                       //(1<<TWEN); //Start Condition
0001eb ea04                      	  ldi r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
0001ec 9300 00bc                 	  sts TWCR, r16
                                       
                                       //while (!(TWCR & (1<<TWINT)))
                                       //;
                                 	  wait6:
0001ee 9100 00bc                 	  lds r16,TWCR
0001f0 ff07                      	  sbrs r16,TWINT
0001f1 cffc                      	  rjmp wait6
                                 
                                       
                                       //if ((TWSR & 0xF8) != START)
                                       //ERROR();
0001f2 9100 00b9                 	  lds r16,TWSR
0001f4 7f08                      	  andi r16, 0xF8
0001f5 3008                      	  cpi r16, START
0001f6 f799                      	  brne ERROR2
                                       
                                 
                                 	  
                                       //TWDR = SLA_W;
                                       //TWCR = (1<<TWINT) |
                                       //(1<<TWEN);
0001f7 e708                      	  ldi r16, SLA_W
0001f8 9300 00bb                 	  sts TWDR, r16
0001fa e804                      	  ldi r16, (1<<TWINT)|(1<<TWEN)
0001fb 9300 00bc                 	  sts TWCR, r16
                                       
                                 	  
                                       //while (!(TWCR & (1<<TWINT)))
                                       //;
                                       wait7:
0001fd 9100 00bc                 	  lds r16,TWCR
0001ff ff07                      	  sbrs r16,TWINT
000200 cffc                      	  rjmp wait7
                                 
                                 	 
                                       //if ((TWSR & 0xF8) !=
                                       //MT_SLA_ACK)
                                       //ERROR();
000201 9100 00b9                 	  lds r16,TWSR
000203 7f08                      	  andi r16, 0xF8
000204 3108                      	  cpi r16, MT_SLA_ACK
000205 f721                      	  brne ERROR2
                                       
                                 	  //---------------------
                                     //TWDR = command; //
                                     //TWCR = (1<<TWINT) |
                                     //(1<<TWEN);
000206 2f03                          mov r16, COMMAND //ex. COMMAND
000207 9300 00bb                 	sts TWDR, r16
000209 e804                      	ldi r16, (1<<TWINT)|(1<<TWEN)
00020a 9300 00bc                 	sts TWCR, r16
                                 
                                 	
                                     //while (!(TWCR & (1<<TWINT)))
                                     //;
                                 	wait8:
00020c 9100 00bc                 	lds r16,TWCR
00020e ff07                      	sbrs r16,TWINT
00020f cffc                      	rjmp wait8
                                     
                                 	
                                     //if ((TWSR & 0xF8) !=
                                     //MT_DATA_ACK)
                                     //ERROR();
000210 9100 00b9                 	lds r16,TWSR
000212 7f08                      	andi r16, 0xF8
000213 3208                      	cpi r16, MT_DATA_ACK
000214 f6a9                      	brne ERROR2
                                 	//---------------------
                                 
                                      
                                 	 
                                       //TWCR = (1<<TWINT)|(1<<TWSTA)|
                                       //(1<<TWEN); //Repeated Start Condition
000215 ea04                            ldi r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
000216 9300 00bc                 	  sts TWCR, r16
                                 	  
                                 	  
                                       //while (!(TWCR & (1<<TWINT)))
                                       //;
                                       wait9:
000218 9100 00bc                 	  lds r16,TWCR
00021a ff07                      	  sbrs r16,TWINT
00021b cffc                      	  rjmp wait9
                                 
                                 	  
                                       //if ((TWSR & 0xF8) != R_START)
                                       //ERROR();
00021c 9100 00b9                 	  lds r16,TWSR
00021e 7f08                      	  andi r16, 0xF8
00021f 3100                      	  cpi r16, R_START
000220 f589                      	  brne ERROR3
                                       
                                       
                                       //TWDR = SLA_R;
                                       //TWCR = (1<<TWINT) |
                                       //(1<<TWEN);
000221 e709                            ldi r16, SLA_R
000222 9300 00bb                 	  sts TWDR, r16
000224 e804                      	  ldi r16, (1<<TWINT)|(1<<TWEN)
000225 9300 00bc                 	  sts TWCR, r16
                                 
                                 	  
                                       //while (!(TWCR & (1<<TWINT)))
                                       //;
                                 	  wait10:
000227 9100 00bc                 	  lds r16,TWCR
000229 ff07                      	  sbrs r16,TWINT
00022a cffc                      	  rjmp wait10
                                       
                                 	 
                                       //if ((TWSR & 0xF8) !=
                                       //MR_SLA_ACK)
                                       //ERROR();
00022b 9100 00b9                 	  lds r16,TWSR
00022d 7f08                      	  andi r16, 0xF8
00022e 3400                      	  cpi r16, MR_SLA_ACK
00022f f511                      	  brne ERROR3
                                       
                                 
                                 
                                 	   //TWCR = (1<<TWINT) |
                                       //(1<<TWEA)|(1<<TWEN); //Data byte will be received and 
                                                             //ACK TWEA=1 will be returned
000230 ec04                            ldi r16, (1<<TWINT)|(1<<TWEA)|(1<<TWEN)
000231 9300 00bc                 	  sts TWCR, r16
                                 	  
                                 	  
                                       //while (!(TWCR & (1<<TWINT)))
                                       //;
                                 	  wait11:
000233 9100 00bc                 	  lds r16,TWCR
000235 ff07                      	  sbrs r16,TWINT
000236 cffc                      	  rjmp wait11
                                       
                                 	  
                                       //if ((TWSR & 0xF8) !=
                                       //MR_DATA_NOACK)
                                       //ERROR();
000237 9100 00b9                 	  lds r16,TWSR
000239 7f08                      	  andi r16, 0xF8
00023a 3500                      	  cpi r16, MR_DATA_ACK
00023b f4b1                      	  brne ERROR3
                                       
                                      
                                       //data_msb = TWDR; //read data byte
00023c 9100 00bb                       lds r16,TWDR
00023e 2f60                      	  mov DATA_LSB,r16
                                 
                                 
                                 
                                       
                                       //TWCR = (1<<TWINT) |
                                       //(0<<TWEA)|(1<<TWEN); //Data byte will be received and 
                                                             //NOT ACK TWEA=0 will be returned
00023f e804                            ldi r16, (1<<TWINT)|(0<<TWEA)|(1<<TWEN)
000240 9300 00bc                 	  sts TWCR, r16
                                 	  
                                 	  
                                       //while (!(TWCR & (1<<TWINT)))
                                       //;
                                 	  wait12:
000242 9100 00bc                 	  lds r16,TWCR
000244 ff07                      	  sbrs r16,TWINT
000245 cffc                      	  rjmp wait12
                                       
                                 	  
                                       //if ((TWSR & 0xF8) !=
                                       //MR_DATA_NOACK)
                                       //ERROR();
000246 9100 00b9                 	  lds r16,TWSR
000248 7f08                      	  andi r16, 0xF8
000249 3508                      	  cpi r16, MR_DATA_NOACK
00024a f439                      	  brne ERROR3
                                       
                                      
                                       //data_lsb = TWDR; //read data byte
00024b 9100 00bb                       lds r16,TWDR
00024d 2f50                      	  mov DATA_MSB,r16
                                 
                                       
                                       //TWCR = (1<<TWINT)|(1<<TWEN)|
                                       //(1<<TWSTO); // Send a Stop Condition
00024e e904                            ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
00024f 9300 00bc                 	  sts TWCR, r16
                                 
                                 	  
                                       //return data;
                                 
000251 9508                      ret
                                 
