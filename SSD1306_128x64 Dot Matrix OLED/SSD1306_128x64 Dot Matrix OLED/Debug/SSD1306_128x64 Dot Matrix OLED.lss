000255 e02c                      ldi r18, 0b00001100 //format RS:E:D7:D6:D5:D4:N/A:N/A Control Sequence 8-bit interface
000256 d091                      rcall DAC
000257 e104                      	ldi r16, 20
000258 de9f                      	rcall	WaitMiliseconds
000259 e42c                      ldi r18, 0b01001100 //format RS:E:D7:D6:D5:D4:N/A:N/A
00025a d08d                      rcall DAC
