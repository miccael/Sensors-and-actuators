                                 #include "wait.asm" ; AVR Assembler v.2
                                 
                                  * wait.asm
                                  *
                                  *  Created: 2015-01-01 18:40:21
                                  *   Author: Mikael
                                  */ 
                                 
                                 
                                 ;------------------------------------------------------------------------------
                                 ; Busy-wait loops utilities module
                                 ; For F_CPU >= 4MHz
                                 ; http://avr-mcu.dxp.pl
                                 ; (c) Radoslaw Kwiecien, 2008
                                 ;------------------------------------------------------------------------------
                                 
                                 #ifndef F_CPU
                                 #endif
                                 
                                 #if F_CPU < 4000000
                                 #endif
                                 
                                 #define CYCLES_PER_US (F_CPU/1000000)
                                 #define C4PUS (CYCLES_PER_US/4)
                                 #define DVUS(x) (C4PUS*x)
                                 
                                 ;------------------------------------------------------------------------------
                                 ; Input : XH:XL - number of CPU cycles to wait (divided by four)
                                 ;------------------------------------------------------------------------------
                                 Wait4xCycles:
0000f5 9711                        sbiw	  XH:XL, 1
0000f6 f7f1                        brne	  Wait4xCycles
0000f7 9508                        ret
                                 ;------------------------------------------------------------------------------
                                 ; Input : r16 - number of miliseconds to wait
                                 ;------------------------------------------------------------------------------
                                 WaitMiliseconds:
0000f8 930f                        push	r16
                                 WaitMsLoop: 
0000f9 e0b9                        ldi	   XH,HIGH(DVUS(500))
0000fa eca4                        ldi	   XL,LOW(DVUS(500))
0000fb dff9                        rcall	 Wait4xCycles
0000fc e0b9                        ldi	   XH,HIGH(DVUS(500))
0000fd eca4                        ldi	   XL,LOW(DVUS(500))
0000fe dff6                        rcall	 Wait4xCycles
0000ff 950a                        dec	   r16
000100 f7c1                        brne	  WaitMsLoop
000101 910f                        pop	   r16
000102 9508                        ret
