                                 .dseg
000100                           PAGE_START_OLED: .BYTE 1 ; reserve 1 byte to PAGE_START_OLED
000101                           PAGE_END_OLED: .BYTE 1 ; reserve 1 byte to PAGE_START_OLED
000102                           COLUMN_START_OLED: .BYTE 1 ; reserve 1 byte to COLUMN_START_OLED 
000103                           COLUMN_END_OLED: .BYTE 1 ; reserve 1 byte to COLUMN_START_OLED 
                                 
                                 .cseg
                                 
                                 
                                 //---------System Clock init----------------
                                   #define F_CPU 20000000 //
