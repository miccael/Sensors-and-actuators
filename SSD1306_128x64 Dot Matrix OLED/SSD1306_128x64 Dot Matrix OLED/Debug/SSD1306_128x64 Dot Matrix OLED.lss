                                 DAC:
                                 
                                  //---------------------1-wire init Vcc powered device Overdrive Mode---------------
0002e8 d063                      	rcall OWReset
0002e9 e30c                      	ldi r16, 0x3C     //Overdrive skip ROM
0002ea d07e                      	rcall OWWriteByte
0002eb ec0c                      	ldi r16, 0xCC     //Write Conditional Search Register command
0002ec d03b                      	rcall OWWriteByteOD
0002ed e80d                      	ldi r16, 0x8D     //TA1 beginning adress
0002ee d039                      	rcall OWWriteByteOD
0002ef e000                      	ldi r16, 0x00     //TA2 adress 008Dh
0002f0 d037                      	rcall OWWriteByteOD
0002f1 e801                      	ldi r16, 0x81     //data byte adress 008Dh
0002f2 d035                      	rcall OWWriteByteOD
                                 	//---------------------1-wire init Vcc powered device Overdrive Mode---------------
                                 
0002f3 d017                      	rcall OWResetOD
0002f4 e30c                      	ldi r16, 0x3C     //Overdrive skip ROM
0002f5 d032                      	rcall OWWriteByteOD
0002f6 ef00                      	ldi r16, 0xF0     //Read PIO Registers command
0002f7 d030                      	rcall OWWriteByteOD
0002f8 e80d                      	ldi r16, 0x8D     //TA1 beginning adress
0002f9 d02e                      	rcall OWWriteByteOD
0002fa e000                      	ldi r16, 0x00     //TA2 adress 008Dh
0002fb d02c                      	rcall OWWriteByteOD
0002fc d046                      	rcall OWReadByteOD //Read Control/Status Register and verify
                                 
0002fd d00d                      	rcall OWResetOD
0002fe e30c                      	ldi r16, 0x3C     //Overdrive skip ROM
0002ff d028                      	rcall OWWriteByteOD
000300 e50a                      	ldi r16, 0x5A     //Channel-access Write command
000301 d026                      	rcall OWWriteByteOD
000302 2f02                      	mov r16, r18     //Write byte to PIO
000303 d024                      	rcall OWWriteByteOD
000304 2f02                      	mov r16, r18     //
000305 9500                      	com r16           //
                                 	//ldi r16, 0xFF     //Write inverted byte to PIO
000306 d021                      	rcall OWWriteByteOD
000307 d03b                      	rcall OWReadByteOD //Read for verification (AAh = success)
000308 d03a                      	rcall OWReadByteOD //Read PIO pin status
000309 d001                      	rcall OWResetOD
                                 	
00030a 9508                      ret
                                 
                                 
                                 
                                 ;-------------------Overdrive Mode Start---------------------------------------
                                 ;------------------------------------------------------------------------------
                                 
                                 ;------------------------------------------------------------------------------
                                 ; Output : T - presence bit
                                 ;------------------------------------------------------------------------------
                                 OWResetOD:
00030b 985c                      	cbi		OW_PORT,OW_DQ
00030c 9a54                      	sbi		OW_DDR,OW_DQ
                                 
00030d e0b1                      	ldi		XH, HIGH(DVUS(55))
00030e e1a3                      	ldi		XL, LOW(DVUS(55))
00030f dde5                      	rcall	Wait4xCycles
                                 	
000310 9854                      	cbi		OW_DDR,OW_DQ
                                 
000311 e0b0                      	ldi		XH, HIGH(DVUS(8))
000312 e2a8                      	ldi		XL, LOW(DVUS(8))
000313 dde1                      	rcall	Wait4xCycles
                                 
000314 9468                      	set
000315 9b4c                      	sbis	OW_PIN,OW_DQ
000316 94e8                      	clt
                                 
000317 e0b0                      	ldi		XH, HIGH(DVUS(48))
000318 efa0                      	ldi		XL, LOW(DVUS(48))
000319 dddb                      	rcall	Wait4xCycles
                                 
00031a 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Input : C - bit to write
                                 ;------------------------------------------------------------------------------
                                 OWWriteBitOD:
00031b f418                      	brcc	OWWriteZeroOD
00031c e0b0                      	ldi		XH, HIGH(DVUS(1))//Måste Kalibreras
00031d e0a5                      	ldi		XL, LOW(DVUS(1))//Måste Kalibreras
00031e c002                      	rjmp	OWWriteOneOD
                                 OWWriteZeroOD:	
00031f e0b0                      	ldi		XH, HIGH(DVUS(10)) 
000320 e3a2                      	ldi		XL, LOW(DVUS(10)) 
                                 OWWriteOneOD:
000321 9a54                      	sbi		OW_DDR, OW_DQ
000322 ddd2                      	rcall	Wait4xCycles
000323 9854                      	cbi		OW_DDR, OW_DQ
                                 	
000324 e0b0                      	ldi		XH, HIGH(DVUS(10))
000325 e3a2                      	ldi		XL, LOW(DVUS(10))
000326 ddce                      	rcall	Wait4xCycles
000327 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Input : r16 - byte to write
                                 ;------------------------------------------------------------------------------
                                 OWWriteByteOD:
000328 931f                      	push	OWCount
000329 e010                      	ldi		OWCount,0
                                 OWWriteLoopOD:	
00032a 9507                      	ror		r16
00032b dfef                      	rcall	OWWriteBitOD	
00032c 9513                      	inc		OWCount
00032d 3018                      	cpi		OWCount,8
00032e f7d9                      	brne	OWWriteLoopOD
00032f 911f                      	pop		OWCount		
000330 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Output : C - bit from slave
                                 ;------------------------------------------------------------------------------
                                 OWReadBitOD:
000331 e0b0                      	ldi		XH, HIGH(DVUS(1)) //Måste kalibreras
000332 e0a5                      	ldi		XL, LOW(DVUS(1)) //Måste kalibreras
000333 9a54                      	sbi		OW_DDR, OW_DQ
000334 ddc0                      	rcall	Wait4xCycles
000335 9854                      	cbi		OW_DDR, OW_DQ
000336 e0b0                      	ldi		XH, HIGH(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent, 1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
000337 e0a5                      	ldi		XL, LOW(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent,  1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
000338 ddbc                      	rcall	Wait4xCycles
000339 94e8                      	clt
00033a 994c                      	sbic	OW_PIN,OW_DQ
00033b 9468                      	set
00033c e0b0                      	ldi		XH, HIGH(DVUS(10))
00033d e3a2                      	ldi		XL, LOW(DVUS(10))
00033e ddb6                      	rcall	Wait4xCycles
00033f 9408                      	sec
000340 f00e                      	brts	OWReadBitEndOD
000341 9488                      	clc
                                 OWReadBitEndOD:
000342 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Output : r16 - byte from slave
                                 ;------------------------------------------------------------------------------
                                 OWReadByteOD:
000343 931f                      	push	OWCount
000344 e010                      	ldi		OWCount,0
                                 OWReadLoopOD:
000345 dfeb                      	rcall	OWReadBitOD
000346 9507                      	ror		r16
000347 9513                      	inc		OWCount
000348 3018                      	cpi		OWCount,8
000349 f7d9                      	brne	OWReadLoopOD
00034a 911f                      	pop		OWCount
00034b 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ;
                                 ;------------------------------------------------------------------------------
                                 
                                 ;-------------------Overdrive Mode End-----------------------------------------
                                 ;------------------------------------------------------------------------------
                                 
                                 
                                 
                                 ;-------------------Standard Mode Start-----------------------------------------
                                 ;------------------------------------------------------------------------------
                                 
                                 ;------------------------------------------------------------------------------
                                 ; Output : T - presence bit
                                 ;------------------------------------------------------------------------------
                                 OWReset:
00034c 985c                      	cbi		OW_PORT,OW_DQ
00034d 9a54                      	sbi		OW_DDR,OW_DQ
                                 
00034e e0b9                      	ldi		XH, HIGH(DVUS(470))
00034f e2ae                      	ldi		XL, LOW(DVUS(470))
000350 dda4                      	rcall	Wait4xCycles
                                 	
000351 9854                      	cbi		OW_DDR,OW_DQ
                                 
000352 e0b1                      	ldi		XH, HIGH(DVUS(70))
000353 e5ae                      	ldi		XL, LOW(DVUS(70))
000354 dda0                      	rcall	Wait4xCycles
                                 
000355 9468                      	set
000356 9b4c                      	sbis	OW_PIN,OW_DQ
000357 94e8                      	clt
                                 
000358 e0b4                      	ldi		XH, HIGH(DVUS(240))
000359 eba0                      	ldi		XL, LOW(DVUS(240))
00035a dd9a                      	rcall	Wait4xCycles
                                 
00035b 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Input : C - bit to write
                                 ;------------------------------------------------------------------------------
                                 OWWriteBit:
00035c f418                      	brcc	OWWriteZero
00035d e0b0                      	ldi		XH, HIGH(DVUS(1))
00035e e0a5                      	ldi		XL, LOW(DVUS(1))
00035f c002                      	rjmp	OWWriteOne
                                 OWWriteZero:	
000360 e0b1                      	ldi		XH, HIGH(DVUS(70)) //Changed from 120
000361 e5ae                      	ldi		XL, LOW(DVUS(70)) //Changed from 120
                                 OWWriteOne:
000362 9a54                      	sbi		OW_DDR, OW_DQ
000363 dd91                      	rcall	Wait4xCycles
000364 9854                      	cbi		OW_DDR, OW_DQ
                                 	
000365 e0b1                      	ldi		XH, HIGH(DVUS(60))
000366 e2ac                      	ldi		XL, LOW(DVUS(60))
000367 dd8d                      	rcall	Wait4xCycles
000368 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Input : r16 - byte to write
                                 ;------------------------------------------------------------------------------
                                 OWWriteByte:
000369 931f                      	push	OWCount
00036a e010                      	ldi		OWCount,0
                                 OWWriteLoop:	
00036b 9507                      	ror		r16
00036c dfef                      	rcall	OWWriteBit	
00036d 9513                      	inc		OWCount
00036e 3018                      	cpi		OWCount,8
00036f f7d9                      	brne	OWWriteLoop
000370 911f                      	pop		OWCount		
000371 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Output : C - bit from slave
                                 ;------------------------------------------------------------------------------
                                 OWReadBit:
000372 e0b0                      	ldi		XH, HIGH(DVUS(1))
000373 e0a5                      	ldi		XL, LOW(DVUS(1))
000374 9a54                      	sbi		OW_DDR, OW_DQ
000375 dd7f                      	rcall	Wait4xCycles
000376 9854                      	cbi		OW_DDR, OW_DQ
000377 e0b0                      	ldi		XH, HIGH(DVUS(8)) //Kolla så att sampling inte sker försent, max 15us tRD - READ VALID, pga oexakta tider, oscilloskop!
000378 e2a8                      	ldi		XL, LOW(DVUS(8)) //Kolla så att sampling inte sker försent, max 15us tRD - READ VALID, pga oexakta tider, oscilloskop!
000379 dd7b                      	rcall	Wait4xCycles
00037a 94e8                      	clt
00037b 994c                      	sbic	OW_PIN,OW_DQ
00037c 9468                      	set
00037d e0b0                      	ldi		XH, HIGH(DVUS(50))
00037e efaa                      	ldi		XL, LOW(DVUS(50))
00037f dd75                      	rcall	Wait4xCycles
000380 9408                      	sec
000381 f00e                      	brts	OWReadBitEnd
000382 9488                      	clc
                                 OWReadBitEnd:
000383 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Output : r16 - byte from slave
                                 ;------------------------------------------------------------------------------
                                 OWReadByte:
000384 931f                      	push	OWCount
000385 e010                      	ldi		OWCount,0
                                 OWReadLoop:
000386 dfeb                      	rcall	OWReadBit
000387 9507                      	ror		r16
000388 9513                      	inc		OWCount
000389 3018                      	cpi		OWCount,8
00038a f7d9                      	brne	OWReadLoop
00038b 911f                      	pop		OWCount
00038c 9508                      	ret
                                 ;------------------------------------------------------------------------------
