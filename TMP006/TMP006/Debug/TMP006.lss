                 ;------------------------------------------------------------------------------
                 
                 
                 
                 ;-------------------Overdrive Mode End-----------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 
                 ;-------------------Standard Mode Start-----------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 ;------------------------------------------------------------------------------
                 ; Output : T - presence bit
                 ;------------------------------------------------------------------------------
                 OWReset:
00035d 9859      	cbi		OW_PORT,OW_DQ
00035e 9a51      	sbi		OW_DDR,OW_DQ
                 
00035f e0b9      	ldi		XH, HIGH(DVUS(470))
000360 e2ae      	ldi		XL, LOW(DVUS(470))
000361 dcfa      	rcall	Wait4xCycles
                 	
