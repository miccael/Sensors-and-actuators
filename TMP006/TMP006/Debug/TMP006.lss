                 //---------System Clock init----------------
                   #define F_CPU 20000000 //
                  //---------System Clock init----------------
                  
                 
                 
                   ;ldi r16, (1<<DDD3)
                   ;out DDRD, r16
                   
                  
000000 d15b       rcall LCD
                 
                 	
                 
                 	
                 	//---------------I2C definitions and init----------------------
                 	//-------------------------------------------------------------
                 	
                 	.def ADRESS = r19
                 	.def DATA_MSB = r20
                 	.def DATA_LSB = r21
                 	.def VOLT_MSB = r22
                 	.def VOLT_LSB = r23
                 	.def TEMP_MSB = r24
                 	.def TEMP_LSB = r25
                 	.equ SLA_W = 0x80; //0x80 slave adress, 0x40 and R/W=0, ADR1 = ADR0 = 0
                 	.equ SLA_R = 0x81; //0x81 slave adress, 0x40 and R/W=1, ADR1 = ADR0 = 0
                 	.equ START = 0x08;
                 	.equ R_START = 0x10;
                 	.equ MT_SLA_ACK = 0x18;
                 	.equ MR_SLA_ACK = 0x40;
                 	.equ MT_DATA_ACK = 0x28;
                 	.equ MR_DATA_ACK = 0x50;
                 	.equ MR_DATA_NOACK = 0x58;
                 
                 
                 	
                 	//------------SCL speed-----------
000001 ef0f      	ldi r16, 0xFF
000002 9300 00b8 	sts TWBR, r16
000004 e003      	ldi r16, (1<<TWPS1)|(1<<TWPS0) //Prescaler 64
000005 9300 00b9 	sts TWSR, r16
                 	 //--------------------------------
                 
                 	 //Must be written to enable 2-wire serial interface
000007 e000      	 ldi r16, (0<<PRTWI)
000008 9300 0064 	 sts PRR, r16
                 	 //---------------------------
                 
00000a e000      	 ldi r16, (0<<DDC4) //PC4 SDA [27] input
00000b b907      	 out DDRC, r16		//PC4 SDA [27] input
