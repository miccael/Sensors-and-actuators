                 	 //--------------------------------------------------------------
                 	
                 	
00000c e032       ldi ADRESS, 0x02 //Configuration register
00000d e744       ldi DATA_MSB, 0b01110100 //RST=0, MOD[2:0]=111, CR[2:0]=010 1 conv/sec, EN=0 !DRDY pin disabled
00000e e050       ldi DATA_LSB, 0b00000000 //!DRDY=0
00000f d095       rcall TMP006Write
                 	
