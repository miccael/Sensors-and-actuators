                 TMP006Write://(byte adress, byte data_msb, byte data_lsb){
                   
                  
                     //TWCR = (1<<TWINT)|(1<<TWSTA)|
                     //(1<<TWEN);
0000a5 ea04      	ldi r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
0000a6 9300 00bc 	sts TWCR, r16
                     
                     //while (!(TWCR & (1<<TWINT)))
                     ;
                     wait1:
0000a8 9100 00bc 	lds r16,TWCR
0000aa ff07      	sbrs r16,TWINT
0000ab cffc      	rjmp wait1
                 
                     //if ((TWSR & 0xF8) != START)
                     //ERROR();
0000ac 9100 00b9     lds r16,TWSR
0000ae 7f08      	andi r16, 0xF8
0000af 3008      	cpi r16, START
0000b0 f791      	brne ERROR1
                 
                 	
                     //TWDR = SLA_W;
                     //TWCR = (1<<TWINT) |
                     //(1<<TWEN);
0000b1 e800      	ldi r16, SLA_W
0000b2 9300 00bb 	sts TWDR, r16
0000b4 e804      	ldi r16, (1<<TWINT)|(1<<TWEN)
0000b5 9300 00bc 	sts TWCR, r16
                     
                 	
                     //while (!(TWCR & (1<<TWINT)))
                     //;
                 	wait2:
0000b7 9100 00bc 	lds r16,TWCR
0000b9 ff07      	sbrs r16,TWINT
0000ba cffc      	rjmp wait2
                 
                     
                     //if ((TWSR & 0xF8) !=
                     //MT_SLA_ACK)
                     //ERROR();
0000bb 9100 00b9 	lds r16,TWSR
0000bd 7f08      	andi r16, 0xF8
0000be 3108      	cpi r16, MT_SLA_ACK
0000bf f719      	brne ERROR1
                 
                     
                 	
                 
                     //---------------------
                     //TWDR = adress; //
                     //TWCR = (1<<TWINT) |
                     //(1<<TWEN);
0000c0 2f03          mov r16, ADRESS //ex. ADRESS
0000c1 9300 00bb 	sts TWDR, r16
0000c3 e804      	ldi r16, (1<<TWINT)|(1<<TWEN)
0000c4 9300 00bc 	sts TWCR, r16
                 
                 	
                     //while (!(TWCR & (1<<TWINT)))
                     //;
                 	wait3:
0000c6 9100 00bc 	lds r16,TWCR
0000c8 ff07      	sbrs r16,TWINT
0000c9 cffc      	rjmp wait3
                     
                 	
                     //if ((TWSR & 0xF8) !=
                     //MT_DATA_ACK)
                     //ERROR();
0000ca 9100 00b9 	lds r16,TWSR
0000cc 7f08      	andi r16, 0xF8
0000cd 3208      	cpi r16, MT_DATA_ACK
0000ce f511      	brne ERROR2
                 	//---------------------
                 
                    //----------------------------------------------------------------------------------------
                     //---------------------
                     //TWDR = data_msb; //
                     //TWCR = (1<<TWINT) |
                     //(1<<TWEN);
0000cf 2f04          mov r16, DATA_MSB //ex. DATA_MSB
0000d0 9300 00bb 	sts TWDR, r16
0000d2 e804      	ldi r16, (1<<TWINT)|(1<<TWEN)
0000d3 9300 00bc 	sts TWCR, r16
                 
                 	
                     //while (!(TWCR & (1<<TWINT)))
                     //;
                 	wait4:
0000d5 9100 00bc 	lds r16,TWCR
0000d7 ff07      	sbrs r16,TWINT
0000d8 cffc      	rjmp wait4
                     
                 	
                     //if ((TWSR & 0xF8) !=
                     //MT_DATA_ACK)
                     //ERROR();
0000d9 9100 00b9 	lds r16,TWSR
0000db 7f08      	andi r16, 0xF8
0000dc 3208      	cpi r16, MT_DATA_ACK
0000dd f499      	brne ERROR2
                 	//---------------------
                 
                 
                 	 //---------------------
                     //TWDR = data_lsb; //
                     //TWCR = (1<<TWINT) |
                     //(1<<TWEN);
0000de 2f05          mov r16, DATA_LSB //ex. DATA_LSB
0000df 9300 00bb 	sts TWDR, r16
0000e1 e804      	ldi r16, (1<<TWINT)|(1<<TWEN)
0000e2 9300 00bc 	sts TWCR, r16
                 
                 	
                     //while (!(TWCR & (1<<TWINT)))
                     //;
                 	wait5:
0000e4 9100 00bc 	lds r16,TWCR
0000e6 ff07      	sbrs r16,TWINT
0000e7 cffc      	rjmp wait5
                     
                 	
                     //if ((TWSR & 0xF8) !=
                     //MT_DATA_ACK)
                     //ERROR();
0000e8 9100 00b9 	lds r16,TWSR
0000ea 7f08      	andi r16, 0xF8
0000eb 3208      	cpi r16, MT_DATA_ACK
0000ec f421      	brne ERROR2
                 	//---------------------
                     
                     
                     //TWCR = (1<<TWINT)|(1<<TWEN)|
                     //(1<<TWSTO);
0000ed e904      	ldi r16,(1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
0000ee 9300 00bc 	sts TWCR, r16
                 
0000f0 9508      ret
                 
                 
                 ERROR2: 
0000f1 d06a      rcall LCD
0000f2 9508      ret
                 
                 TMP006Read://(byte adress){
                 
                 
                       //byte data;  
                        
                       //TWCR = (1<<TWINT)|(1<<TWSTA)|
                       //(1<<TWEN); //Start Condition
0000f3 ea04      	  ldi r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
0000f4 9300 00bc 	  sts TWCR, r16
                       
                       //while (!(TWCR & (1<<TWINT)))
                       //;
                 	  wait6:
0000f6 9100 00bc 	  lds r16,TWCR
0000f8 ff07      	  sbrs r16,TWINT
0000f9 cffc      	  rjmp wait6
                 
                       
                       //if ((TWSR & 0xF8) != START)
                       //ERROR();
0000fa 9100 00b9 	  lds r16,TWSR
0000fc 7f08      	  andi r16, 0xF8
0000fd 3008      	  cpi r16, START
0000fe f791      	  brne ERROR2
                       
                 
                 	  
                       //TWDR = SLA_W;
                       //TWCR = (1<<TWINT) |
                       //(1<<TWEN);
0000ff e800      	  ldi r16, SLA_W
000100 9300 00bb 	  sts TWDR, r16
000102 e804      	  ldi r16, (1<<TWINT)|(1<<TWEN)
000103 9300 00bc 	  sts TWCR, r16
                       
                 	  
                       //while (!(TWCR & (1<<TWINT)))
                       //;
                       wait7:
000105 9100 00bc 	  lds r16,TWCR
000107 ff07      	  sbrs r16,TWINT
000108 cffc      	  rjmp wait7
                 
                 	 
                       //if ((TWSR & 0xF8) !=
                       //MT_SLA_ACK)
                       //ERROR();
000109 9100 00b9 	  lds r16,TWSR
00010b 7f08      	  andi r16, 0xF8
00010c 3108      	  cpi r16, MT_SLA_ACK
00010d f719      	  brne ERROR2
                       
                 	  //---------------------
                     //TWDR = adress; //
                     //TWCR = (1<<TWINT) |
                     //(1<<TWEN);
00010e 2f03          mov r16, ADRESS //ex. ADRESS
00010f 9300 00bb 	sts TWDR, r16
000111 e804      	ldi r16, (1<<TWINT)|(1<<TWEN)
000112 9300 00bc 	sts TWCR, r16
                 
                 	
                     //while (!(TWCR & (1<<TWINT)))
                     //;
                 	wait8:
000114 9100 00bc 	lds r16,TWCR
000116 ff07      	sbrs r16,TWINT
000117 cffc      	rjmp wait8
                     
                 	
                     //if ((TWSR & 0xF8) !=
                     //MT_DATA_ACK)
                     //ERROR();
000118 9100 00b9 	lds r16,TWSR
00011a 7f08      	andi r16, 0xF8
00011b 3208      	cpi r16, MT_DATA_ACK
00011c f6a1      	brne ERROR2
                 	//---------------------
                 
                      
                 	 
                       //TWCR = (1<<TWINT)|(1<<TWSTA)|
                       //(1<<TWEN); //Repeated Start Condition
00011d ea04            ldi r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
00011e 9300 00bc 	  sts TWCR, r16
                 	  
                 	  
                       //while (!(TWCR & (1<<TWINT)))
                       //;
                       wait9:
000120 9100 00bc 	  lds r16,TWCR
000122 ff07      	  sbrs r16,TWINT
000123 cffc      	  rjmp wait9
                 
                 	  
                       //if ((TWSR & 0xF8) != R_START)
                       //ERROR();
000124 9100 00b9 	  lds r16,TWSR
000126 7f08      	  andi r16, 0xF8
000127 3100      	  cpi r16, R_START
000128 f589      	  brne ERROR3
                       
                       
                       //TWDR = SLA_R;
                       //TWCR = (1<<TWINT) |
                       //(1<<TWEN);
000129 e801            ldi r16, SLA_R
00012a 9300 00bb 	  sts TWDR, r16
00012c e804      	  ldi r16, (1<<TWINT)|(1<<TWEN)
00012d 9300 00bc 	  sts TWCR, r16
                 
                 	  
                       //while (!(TWCR & (1<<TWINT)))
                       //;
                 	  wait10:
00012f 9100 00bc 	  lds r16,TWCR
000131 ff07      	  sbrs r16,TWINT
000132 cffc      	  rjmp wait10
                       
                 	 
                       //if ((TWSR & 0xF8) !=
                       //MR_SLA_ACK)
                       //ERROR();
000133 9100 00b9 	  lds r16,TWSR
000135 7f08      	  andi r16, 0xF8
000136 3400      	  cpi r16, MR_SLA_ACK
000137 f511      	  brne ERROR3
                       
                       
                       //TWCR = (1<<TWINT) |
                       //(0<<TWEA)|(1<<TWEN); //Data byte will be received and 
                                             //ACK TWEA=1 will be returned
000138 ec04            ldi r16, (1<<TWINT)|(1<<TWEA)|(1<<TWEN)
000139 9300 00bc 	  sts TWCR, r16
                 	  
                 	  
                       //while (!(TWCR & (1<<TWINT)))
                       //;
                 	  wait11:
00013b 9100 00bc 	  lds r16,TWCR
00013d ff07      	  sbrs r16,TWINT
00013e cffc      	  rjmp wait11
                       
                 	  
                       //if ((TWSR & 0xF8) !=
                       //MR_DATA_ACK)
                       //ERROR();
00013f 9100 00b9 	  lds r16,TWSR
000141 7f08      	  andi r16, 0xF8
000142 3500      	  cpi r16, MR_DATA_ACK
000143 f4b1      	  brne ERROR3
                       
                      
                       //data_msb = TWDR; //read data byte
000144 9100 00bb       lds r16,TWDR
000146 2f40      	  mov DATA_MSB,r16
                 
                 
                 	  //TWCR = (1<<TWINT) |
                       //(0<<TWEA)|(1<<TWEN); //Data byte will be received and 
                                             //NOT ACK TWEA=0 will be returned
000147 e804            ldi r16, (1<<TWINT)|(0<<TWEA)|(1<<TWEN)
000148 9300 00bc 	  sts TWCR, r16
                 	  
                 	  
                       //while (!(TWCR & (1<<TWINT)))
                       //;
                 	  wait12:
00014a 9100 00bc 	  lds r16,TWCR
00014c ff07      	  sbrs r16,TWINT
00014d cffc      	  rjmp wait12
                       
                 	  
                       //if ((TWSR & 0xF8) !=
                       //MR_DATA_NOACK)
                       //ERROR();
00014e 9100 00b9 	  lds r16,TWSR
000150 7f08      	  andi r16, 0xF8
000151 3508      	  cpi r16, MR_DATA_NOACK
000152 f439      	  brne ERROR3
                       
                      
                       //data_lsb = TWDR; //read data byte
000153 9100 00bb       lds r16,TWDR
000155 2f50      	  mov DATA_LSB,r16
                 
                       
                       //TWCR = (1<<TWINT)|(1<<TWEN)|
                       //(1<<TWSTO); // Send a Stop Condition
000156 e904            ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
000157 9300 00bc 	  sts TWCR, r16
                 
                 	  
                       //return data;
                 
000159 9508      ret
                 
