0002f6 ec08      	ldi r16, 200
0002f7 dd67      	rcall	WaitMiliseconds
0002f8 9508      ret
                 
                 
                 
                 DAC:
                 
                  //---------------------1-wire init Vcc powered device Overdrive Mode---------------
0002f9 d063      	rcall OWReset
0002fa e30c      	ldi r16, 0x3C     //Overdrive skip ROM
0002fb d07e      	rcall OWWriteByte
0002fc ec0c      	ldi r16, 0xCC     //Write Conditional Search Register command
0002fd d03b      	rcall OWWriteByteOD
0002fe e80d      	ldi r16, 0x8D     //TA1 beginning adress
0002ff d039      	rcall OWWriteByteOD
000300 e000      	ldi r16, 0x00     //TA2 adress 008Dh
000301 d037      	rcall OWWriteByteOD
000302 e801      	ldi r16, 0x81     //data byte adress 008Dh
000303 d035      	rcall OWWriteByteOD
                 	//---------------------1-wire init Vcc powered device Overdrive Mode---------------
                 
000304 d017      	rcall OWResetOD
000305 e30c      	ldi r16, 0x3C     //Overdrive skip ROM
000306 d032      	rcall OWWriteByteOD
000307 ef00      	ldi r16, 0xF0     //Read PIO Registers command
000308 d030      	rcall OWWriteByteOD
000309 e80d      	ldi r16, 0x8D     //TA1 beginning adress
00030a d02e      	rcall OWWriteByteOD
00030b e000      	ldi r16, 0x00     //TA2 adress 008Dh
00030c d02c      	rcall OWWriteByteOD
00030d d046      	rcall OWReadByteOD //Read Control/Status Register and verify
                 
00030e d00d      	rcall OWResetOD
00030f e30c      	ldi r16, 0x3C     //Overdrive skip ROM
000310 d028      	rcall OWWriteByteOD
000311 e50a      	ldi r16, 0x5A     //Channel-access Write command
000312 d026      	rcall OWWriteByteOD
000313 2f02      	mov r16, r18     //Write byte to PIO
000314 d024      	rcall OWWriteByteOD
000315 2f02      	mov r16, r18     //
000316 9500      	com r16           //
                 	//ldi r16, 0xFF     //Write inverted byte to PIO
000317 d021      	rcall OWWriteByteOD
000318 d03b      	rcall OWReadByteOD //Read for verification (AAh = success)
000319 d03a      	rcall OWReadByteOD //Read PIO pin status
00031a d001      	rcall OWResetOD
                 	
00031b 9508      ret
                 
                 
                 
                 ;-------------------Overdrive Mode Start---------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 ;------------------------------------------------------------------------------
                 ; Output : T - presence bit
                 ;------------------------------------------------------------------------------
                 OWResetOD:
00031c 9859      	cbi		OW_PORT,OW_DQ
00031d 9a51      	sbi		OW_DDR,OW_DQ
                 
00031e e0b1      	ldi		XH, HIGH(DVUS(55))
00031f e1a3      	ldi		XL, LOW(DVUS(55))
000320 dd3b      	rcall	Wait4xCycles
                 	
000321 9851      	cbi		OW_DDR,OW_DQ
                 
000322 e0b0      	ldi		XH, HIGH(DVUS(8))
000323 e2a8      	ldi		XL, LOW(DVUS(8))
000324 dd37      	rcall	Wait4xCycles
                 
000325 9468      	set
000326 9b49      	sbis	OW_PIN,OW_DQ
000327 94e8      	clt
                 
000328 e0b0      	ldi		XH, HIGH(DVUS(48))
000329 efa0      	ldi		XL, LOW(DVUS(48))
00032a dd31      	rcall	Wait4xCycles
                 
00032b 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : C - bit to write
                 ;------------------------------------------------------------------------------
                 OWWriteBitOD:
00032c f418      	brcc	OWWriteZeroOD
00032d e0b0      	ldi		XH, HIGH(DVUS(1))//Måste Kalibreras
00032e e0a5      	ldi		XL, LOW(DVUS(1))//Måste Kalibreras
00032f c002      	rjmp	OWWriteOneOD
                 OWWriteZeroOD:	
000330 e0b0      	ldi		XH, HIGH(DVUS(10)) 
000331 e3a2      	ldi		XL, LOW(DVUS(10)) 
                 OWWriteOneOD:
000332 9a51      	sbi		OW_DDR, OW_DQ
000333 dd28      	rcall	Wait4xCycles
000334 9851      	cbi		OW_DDR, OW_DQ
                 	
000335 e0b0      	ldi		XH, HIGH(DVUS(10))
000336 e3a2      	ldi		XL, LOW(DVUS(10))
000337 dd24      	rcall	Wait4xCycles
000338 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : r16 - byte to write
                 ;------------------------------------------------------------------------------
                 OWWriteByteOD:
000339 931f      	push	OWCount
00033a e010      	ldi		OWCount,0
                 OWWriteLoopOD:	
00033b 9507      	ror		r16
00033c dfef      	rcall	OWWriteBitOD	
00033d 9513      	inc		OWCount
00033e 3018      	cpi		OWCount,8
00033f f7d9      	brne	OWWriteLoopOD
000340 911f      	pop		OWCount		
000341 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Output : C - bit from slave
                 ;------------------------------------------------------------------------------
                 OWReadBitOD:
000342 e0b0      	ldi		XH, HIGH(DVUS(1)) //Måste kalibreras
000343 e0a5      	ldi		XL, LOW(DVUS(1)) //Måste kalibreras
000344 9a51      	sbi		OW_DDR, OW_DQ
000345 dd16      	rcall	Wait4xCycles
000346 9851      	cbi		OW_DDR, OW_DQ
000347 e0b0      	ldi		XH, HIGH(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent, 1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
000348 e0a5      	ldi		XL, LOW(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent,  1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
000349 dd12      	rcall	Wait4xCycles
00034a 94e8      	clt
00034b 9949      	sbic	OW_PIN,OW_DQ
00034c 9468      	set
00034d e0b0      	ldi		XH, HIGH(DVUS(10))
00034e e3a2      	ldi		XL, LOW(DVUS(10))
00034f dd0c      	rcall	Wait4xCycles
000350 9408      	sec
000351 f00e      	brts	OWReadBitEndOD
000352 9488      	clc
                 OWReadBitEndOD:
000353 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Output : r16 - byte from slave
                 ;------------------------------------------------------------------------------
                 OWReadByteOD:
000354 931f      	push	OWCount
000355 e010      	ldi		OWCount,0
                 OWReadLoopOD:
000356 dfeb      	rcall	OWReadBitOD
000357 9507      	ror		r16
000358 9513      	inc		OWCount
000359 3018      	cpi		OWCount,8
00035a f7d9      	brne	OWReadLoopOD
00035b 911f      	pop		OWCount
00035c 9508      	ret
                 ;------------------------------------------------------------------------------
