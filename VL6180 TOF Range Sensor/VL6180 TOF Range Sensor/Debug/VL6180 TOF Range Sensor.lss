                                 DAC:
                                 
                                  //---------------------1-wire init Vcc powered device Overdrive Mode---------------
00035a d063                      	rcall OWReset
00035b e30c                      	ldi r16, 0x3C     //Overdrive skip ROM
00035c d07e                      	rcall OWWriteByte
00035d ec0c                      	ldi r16, 0xCC     //Write Conditional Search Register command
00035e d03b                      	rcall OWWriteByteOD
00035f e80d                      	ldi r16, 0x8D     //TA1 beginning adress
000360 d039                      	rcall OWWriteByteOD
000361 e000                      	ldi r16, 0x00     //TA2 adress 008Dh
000362 d037                      	rcall OWWriteByteOD
000363 e801                      	ldi r16, 0x81     //data byte adress 008Dh
000364 d035                      	rcall OWWriteByteOD
                                 	//---------------------1-wire init Vcc powered device Overdrive Mode---------------
                                 
000365 d017                      	rcall OWResetOD
000366 e30c                      	ldi r16, 0x3C     //Overdrive skip ROM
000367 d032                      	rcall OWWriteByteOD
000368 ef00                      	ldi r16, 0xF0     //Read PIO Registers command
000369 d030                      	rcall OWWriteByteOD
00036a e80d                      	ldi r16, 0x8D     //TA1 beginning adress
00036b d02e                      	rcall OWWriteByteOD
00036c e000                      	ldi r16, 0x00     //TA2 adress 008Dh
00036d d02c                      	rcall OWWriteByteOD
00036e d046                      	rcall OWReadByteOD //Read Control/Status Register and verify
                                 
00036f d00d                      	rcall OWResetOD
000370 e30c                      	ldi r16, 0x3C     //Overdrive skip ROM
000371 d028                      	rcall OWWriteByteOD
000372 e50a                      	ldi r16, 0x5A     //Channel-access Write command
000373 d026                      	rcall OWWriteByteOD
000374 2f02                      	mov r16, r18     //Write byte to PIO
000375 d024                      	rcall OWWriteByteOD
000376 2f02                      	mov r16, r18     //
000377 9500                      	com r16           //
                                 	//ldi r16, 0xFF     //Write inverted byte to PIO
000378 d021                      	rcall OWWriteByteOD
000379 d03b                      	rcall OWReadByteOD //Read for verification (AAh = success)
00037a d03a                      	rcall OWReadByteOD //Read PIO pin status
00037b d001                      	rcall OWResetOD
                                 	
00037c 9508                      ret
                                 
                                 
                                 
                                 ;-------------------Overdrive Mode Start---------------------------------------
                                 ;------------------------------------------------------------------------------
                                 
                                 ;------------------------------------------------------------------------------
                                 ; Output : T - presence bit
                                 ;------------------------------------------------------------------------------
                                 OWResetOD:
00037d 985c                      	cbi		OW_PORT,OW_DQ
00037e 9a54                      	sbi		OW_DDR,OW_DQ
                                 
00037f e0b1                      	ldi		XH, HIGH(DVUS(55))
000380 e1a3                      	ldi		XL, LOW(DVUS(55))
000381 ddcd                      	rcall	Wait4xCycles
                                 	
000382 9854                      	cbi		OW_DDR,OW_DQ
                                 
000383 e0b0                      	ldi		XH, HIGH(DVUS(8))
000384 e2a8                      	ldi		XL, LOW(DVUS(8))
000385 ddc9                      	rcall	Wait4xCycles
                                 
000386 9468                      	set
000387 9b4c                      	sbis	OW_PIN,OW_DQ
000388 94e8                      	clt
                                 
000389 e0b0                      	ldi		XH, HIGH(DVUS(48))
00038a efa0                      	ldi		XL, LOW(DVUS(48))
00038b ddc3                      	rcall	Wait4xCycles
                                 
00038c 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Input : C - bit to write
                                 ;------------------------------------------------------------------------------
                                 OWWriteBitOD:
00038d f418                      	brcc	OWWriteZeroOD
00038e e0b0                      	ldi		XH, HIGH(DVUS(1))//Måste Kalibreras
00038f e0a5                      	ldi		XL, LOW(DVUS(1))//Måste Kalibreras
000390 c002                      	rjmp	OWWriteOneOD
                                 OWWriteZeroOD:	
000391 e0b0                      	ldi		XH, HIGH(DVUS(10)) 
000392 e3a2                      	ldi		XL, LOW(DVUS(10)) 
                                 OWWriteOneOD:
000393 9a54                      	sbi		OW_DDR, OW_DQ
000394 ddba                      	rcall	Wait4xCycles
000395 9854                      	cbi		OW_DDR, OW_DQ
                                 	
000396 e0b0                      	ldi		XH, HIGH(DVUS(10))
000397 e3a2                      	ldi		XL, LOW(DVUS(10))
000398 ddb6                      	rcall	Wait4xCycles
000399 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Input : r16 - byte to write
                                 ;------------------------------------------------------------------------------
                                 OWWriteByteOD:
00039a 931f                      	push	OWCount
00039b e010                      	ldi		OWCount,0
                                 OWWriteLoopOD:	
00039c 9507                      	ror		r16
00039d dfef                      	rcall	OWWriteBitOD	
00039e 9513                      	inc		OWCount
00039f 3018                      	cpi		OWCount,8
0003a0 f7d9                      	brne	OWWriteLoopOD
0003a1 911f                      	pop		OWCount		
0003a2 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Output : C - bit from slave
                                 ;------------------------------------------------------------------------------
                                 OWReadBitOD:
0003a3 e0b0                      	ldi		XH, HIGH(DVUS(1)) //Måste kalibreras
0003a4 e0a5                      	ldi		XL, LOW(DVUS(1)) //Måste kalibreras
0003a5 9a54                      	sbi		OW_DDR, OW_DQ
0003a6 dda8                      	rcall	Wait4xCycles
0003a7 9854                      	cbi		OW_DDR, OW_DQ
0003a8 e0b0                      	ldi		XH, HIGH(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent, 1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
0003a9 e0a5                      	ldi		XL, LOW(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent,  1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
0003aa dda4                      	rcall	Wait4xCycles
0003ab 94e8                      	clt
0003ac 994c                      	sbic	OW_PIN,OW_DQ
0003ad 9468                      	set
0003ae e0b0                      	ldi		XH, HIGH(DVUS(10))
0003af e3a2                      	ldi		XL, LOW(DVUS(10))
0003b0 dd9e                      	rcall	Wait4xCycles
0003b1 9408                      	sec
0003b2 f00e                      	brts	OWReadBitEndOD
0003b3 9488                      	clc
                                 OWReadBitEndOD:
0003b4 9508                      	ret
                                 ;------------------------------------------------------------------------------
                                 ; Output : r16 - byte from slave
                                 ;------------------------------------------------------------------------------
                                 OWReadByteOD:
0003b5 931f                      	push	OWCount
0003b6 e010                      	ldi		OWCount,0
                                 OWReadLoopOD:
0003b7 dfeb                      	rcall	OWReadBitOD
0003b8 9507                      	ror		r16
0003b9 9513                      	inc		OWCount
0003ba 3018                      	cpi		OWCount,8
0003bb f7d9                      	brne	OWReadLoopOD
0003bc 911f                      	pop		OWCount
0003bd 9508                      	ret
