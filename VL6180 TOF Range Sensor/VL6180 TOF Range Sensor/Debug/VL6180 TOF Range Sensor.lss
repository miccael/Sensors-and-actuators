                                 #include "wait.asm" ; AVR Assembler v.2
                                 
                                  * wait.asm
                                  *
                                  *  Created: 2015-01-01 18:40:21
                                  *   Author: Mikael
                                  */ 
                                 
                                 
                                 ;------------------------------------------------------------------------------
                                 ; Busy-wait loops utilities module
                                 ; For F_CPU >= 4MHz
                                 ; http://avr-mcu.dxp.pl
                                 ; (c) Radoslaw Kwiecien, 2008
                                 ;------------------------------------------------------------------------------
                                 
                                 #ifndef F_CPU
                                 #endif
                                 
                                 #if F_CPU < 4000000
                                 #endif
                                 
                                 #define CYCLES_PER_US (F_CPU/1000000)
                                 #define C4PUS (CYCLES_PER_US/4)
                                 #define DVUS(x) (C4PUS*x)
                                 
                                 ;------------------------------------------------------------------------------
                                 ; Input : XH:XL - number of CPU cycles to wait (divided by four)
                                 ;------------------------------------------------------------------------------
                                 Wait4xCycles:
00014f 9711                        sbiw	  XH:XL, 1
000150 f7f1                        brne	  Wait4xCycles
000151 9508                        ret
                                 ;------------------------------------------------------------------------------
                                 ; Input : r16 - number of miliseconds to wait
                                 ;------------------------------------------------------------------------------
                                 WaitMiliseconds:
000152 930f                        push	r16
                                 WaitMsLoop: 
000153 e0b9                        ldi	   XH,HIGH(DVUS(500))
000154 eca4                        ldi	   XL,LOW(DVUS(500))
000155 dff9                        rcall	 Wait4xCycles
000156 e0b9                        ldi	   XH,HIGH(DVUS(500))
000157 eca4                        ldi	   XL,LOW(DVUS(500))
000158 dff6                        rcall	 Wait4xCycles
000159 950a                        dec	   r16
00015a f7c1                        brne	  WaitMsLoop
00015b 910f                        pop	   r16
00015c 9508                        ret
                                 ;------------------------------------------------------------------------------
                                 ; End of file
                                 
