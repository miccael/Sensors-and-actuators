                                 ;writes two bytes with the selected start register
                                 VL6180Write://(byte index_hi, byte index_lo, byte data){
                                   
                                  
                                     //TWCR = (1<<TWINT)|(1<<TWSTA)|
                                     //(1<<TWEN);
000210 ea04                      	ldi r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
000211 9300 00bc                 	sts TWCR, r16
                                     
                                     //while (!(TWCR & (1<<TWINT)))
                                     ;
                                     wait1:
000213 9100 00bc                 	lds r16,TWCR
000215 ff07                      	sbrs r16,TWINT
000216 cffc                      	rjmp wait1
                                 
                                     //if ((TWSR & 0xF8) != START)
                                     //ERROR();
000217 9100 00b9                     lds r16,TWSR
000219 7f08                      	andi r16, 0xF8
00021a 3008                      	cpi r16, START
00021b f799                      	brne ERROR1
                                 
                                 	
                                     //TWDR = SLA_W;
                                     //TWCR = (1<<TWINT) |
                                     //(1<<TWEN);
00021c e502                      	ldi r16, SLA_W
00021d 9300 00bb                 	sts TWDR, r16
00021f e804                      	ldi r16, (1<<TWINT)|(1<<TWEN)
000220 9300 00bc                 	sts TWCR, r16
                                     
                                 	
                                     //while (!(TWCR & (1<<TWINT)))
                                     //;
                                 	wait2:
000222 9100 00bc                 	lds r16,TWCR
000224 ff07                      	sbrs r16,TWINT
000225 cffc                      	rjmp wait2
                                 
                                     
                                     //if ((TWSR & 0xF8) !=
                                     //MT_SLA_ACK)
                                     //ERROR();
000226 9100 00b9                 	lds r16,TWSR
000228 7f08                      	andi r16, 0xF8
000229 3108                      	cpi r16, MT_SLA_ACK
00022a f721                      	brne ERROR1
                                 
                                     
                                 	
                                 
                                     //---------------------
                                     //TWDR = index_hi; //
                                     //TWCR = (1<<TWINT) |
                                     //(1<<TWEN);
00022b 2f03                          mov r16, INDEX_HI //ex. INDEX_HI
00022c 9300 00bb                 	sts TWDR, r16
00022e e804                      	ldi r16, (1<<TWINT)|(1<<TWEN)
00022f 9300 00bc                 	sts TWCR, r16
                                 
                                 	
                                     //while (!(TWCR & (1<<TWINT)))
                                     //;
                                 	wait3:
000231 9100 00bc                 	lds r16,TWCR
000233 ff07                      	sbrs r16,TWINT
000234 cffc                      	rjmp wait3
                                     
                                 	
                                     //if ((TWSR & 0xF8) !=
                                     //MT_DATA_ACK)
                                     //ERROR();
000235 9100 00b9                 	lds r16,TWSR
000237 7f08                      	andi r16, 0xF8 
000238 3208                      	cpi r16, MT_DATA_ACK
000239 f511                      	brne ERROR2
                                 	//---------------------
                                 
                                     //---------------------
                                     //TWDR = index_lo; //
                                     //TWCR = (1<<TWINT) |
                                     //(1<<TWEN);
00023a 2f04                          mov r16, INDEX_LO //ex. INDEX_LO
00023b 9300 00bb                 	sts TWDR, r16
00023d e804                      	ldi r16, (1<<TWINT)|(1<<TWEN)
00023e 9300 00bc                 	sts TWCR, r16
                                 
                                 	
                                     //while (!(TWCR & (1<<TWINT)))
                                     //;
                                 	wait4:
000240 9100 00bc                 	lds r16,TWCR
000242 ff07                      	sbrs r16,TWINT
000243 cffc                      	rjmp wait4
                                     
                                 	
                                     //if ((TWSR & 0xF8) !=
                                     //MT_DATA_ACK)
                                     //ERROR();
000244 9100 00b9                 	lds r16,TWSR
000246 7f08                      	andi r16, 0xF8
000247 3208                      	cpi r16, MT_DATA_ACK
000248 f499                      	brne ERROR2
                                 	//---------------------
                                 
                                 	//---------------------
                                     //TWDR = data; //
                                     //TWCR = (1<<TWINT) |
                                     //(1<<TWEN);
000249 2f05                          mov r16, DATA //ex. DATA
00024a 9300 00bb                 	sts TWDR, r16
00024c e804                      	ldi r16, (1<<TWINT)|(1<<TWEN)
00024d 9300 00bc                 	sts TWCR, r16
                                 
                                 	
                                     //while (!(TWCR & (1<<TWINT)))
                                     //;
                                 	wait5:
00024f 9100 00bc                 	lds r16,TWCR
000251 ff07                      	sbrs r16,TWINT
000252 cffc                      	rjmp wait5
                                     
                                 	
                                     //if ((TWSR & 0xF8) !=
                                     //MT_DATA_ACK)
                                     //ERROR();
000253 9100 00b9                 	lds r16,TWSR
000255 7f08                      	andi r16, 0xF8
000256 3208                      	cpi r16, MT_DATA_ACK
000257 f421                      	brne ERROR2
                                 	//---------------------
                                 
                                 
                                     //TWCR = (1<<TWINT)|(1<<TWEN)|
                                     //(1<<TWSTO);
000258 e904                      	ldi r16,(1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
000259 9300 00bc                 	sts TWCR, r16
                                 
