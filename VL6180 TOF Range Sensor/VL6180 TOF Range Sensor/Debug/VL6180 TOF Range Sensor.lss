                                       //if ((TWSR & 0xF8) != START)
                                       //ERROR();
000264 9100 00b9                 	  lds r16,TWSR
000266 7f08                      	  andi r16, 0xF8
000267 3008                      	  cpi r16, START
000268 f799                      	  brne ERROR2
                                       
                                 
                                 	  
                                       //TWDR = SLA_W;
                                       //TWCR = (1<<TWINT) |
                                       //(1<<TWEN);
000269 e502                      	  ldi r16, SLA_W
00026a 9300 00bb                 	  sts TWDR, r16
00026c e804                      	  ldi r16, (1<<TWINT)|(1<<TWEN)
00026d 9300 00bc                 	  sts TWCR, r16
                                       
                                 	  
                                       //while (!(TWCR & (1<<TWINT)))
                                       //;
                                       wait7:
00026f 9100 00bc                 	  lds r16,TWCR
000271 ff07                      	  sbrs r16,TWINT
000272 cffc                      	  rjmp wait7
                                 
                                 	 
                                       //if ((TWSR & 0xF8) !=
                                       //MT_SLA_ACK)
                                       //ERROR();
000273 9100 00b9                 	  lds r16,TWSR
000275 7f08                      	  andi r16, 0xF8
000276 3108                      	  cpi r16, MT_SLA_ACK
000277 f721                      	  brne ERROR2
                                       
                                 	  //---------------------
                                     //TWDR = index_hi; //
                                     //TWCR = (1<<TWINT) |
                                     //(1<<TWEN);
000278 2f03                          mov r16, INDEX_HI //ex. INDEX_HI
000279 9300 00bb                 	sts TWDR, r16
00027b e804                      	ldi r16, (1<<TWINT)|(1<<TWEN)
00027c 9300 00bc                 	sts TWCR, r16
                                 
                                 	
                                     //while (!(TWCR & (1<<TWINT)))
                                     //;
                                 	wait8:
00027e 9100 00bc                 	lds r16,TWCR
000280 ff07                      	sbrs r16,TWINT
000281 cffc                      	rjmp wait8
                                     
                                 	
                                     //if ((TWSR & 0xF8) !=
                                     //MT_DATA_ACK)
                                     //ERROR();
000282 9100 00b9                 	lds r16,TWSR
000284 7f08                      	andi r16, 0xF8
000285 3208                      	cpi r16, MT_DATA_ACK
000286 f6a9                      	brne ERROR2
                                 	//---------------------
                                 
                                 	 //---------------------
                                     //TWDR = index_lo; //
                                     //TWCR = (1<<TWINT) |
                                     //(1<<TWEN);
000287 2f04                          mov r16, INDEX_LO //ex. INDEX_LO
000288 9300 00bb                 	sts TWDR, r16
00028a e804                      	ldi r16, (1<<TWINT)|(1<<TWEN)
00028b 9300 00bc                 	sts TWCR, r16
                                 
                                 	
                                     //while (!(TWCR & (1<<TWINT)))
                                     //;
                                 	wait9:
00028d 9100 00bc                 	lds r16,TWCR
00028f ff07                      	sbrs r16,TWINT
000290 cffc                      	rjmp wait9
                                     
                                 	
                                     //if ((TWSR & 0xF8) !=
                                     //MT_DATA_ACK)
                                     //ERROR();
000291 9100 00b9                 	lds r16,TWSR
000293 7f08                      	andi r16, 0xF8
000294 3208                      	cpi r16, MT_DATA_ACK
000295 f631                      	brne ERROR2
                                 	//---------------------
                                 
                                      
                                 
                                 
                                 
                                 
                                 
                                 
                                 /*
                                 	 //TWCR = (1<<TWINT)|(1<<TWEN)|
                                     //(1<<TWSTO);
                                 	ldi r16,(1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
                                 	sts TWCR, r16
                                 
                                 
                                 		ldi r16, 20
                                 		rcall	WaitMiliseconds //wait
                                 		ldi r16, 20
                                 		rcall	WaitMiliseconds
                                 		ldi r16, 20
                                 		rcall	WaitMiliseconds //
                                 		ldi r16, 20
                                 		rcall	WaitMiliseconds
                                 
                                 
                                 	//TWCR = (1<<TWINT)|(1<<TWSTA)|
                                     //(1<<TWEN);
                                 	ldi r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
                                 	sts TWCR, r16
                                 
                                 	//while (!(TWCR & (1<<TWINT)))
                                       //;
                                 	  wait6_1:
                                 	  lds r16,TWCR
                                 	  sbrs r16,TWINT
                                 	  rjmp wait6_1
                                 
                                       
                                       //if ((TWSR & 0xF8) != START)
                                       //ERROR();
                                 	  lds r16,TWSR
                                 	  andi r16, 0xF8
                                 	  cpi r16, START
                                 	  brne ERROR3
                                 */
                                 
                                 
                                 
                                 
                                 
                                 	  
                                       //TWCR = (1<<TWINT)|(1<<TWSTA)|
                                       //(1<<TWEN); //Repeated Start Condition OBS!! Will Repeated Start Work? See p.38 in VL6180 datasheet.
000296 ea04                            ldi r16, (1<<TWINT)|(1<<TWSTA)|(1<<TWEN)
000297 9300 00bc                 	  sts TWCR, r16
                                 	  
                                 	  
                                       //while (!(TWCR & (1<<TWINT)))
                                       //;
                                       wait10:
000299 9100 00bc                 	  lds r16,TWCR
00029b ff07                      	  sbrs r16,TWINT
00029c cffc                      	  rjmp wait10
                                 
                                 	  
                                       //if ((TWSR & 0xF8) != R_START)
                                       //ERROR();
00029d 9100 00b9                 	  lds r16,TWSR
00029f 7f08                      	  andi r16, 0xF8
0002a0 3100                      	  cpi r16, R_START
0002a1 f511                      	  brne ERROR3
                                 
                                 
                                 
                                       
                                       
                                       //TWDR = SLA_R;
                                       //TWCR = (1<<TWINT) |
                                       //(1<<TWEN);
0002a2 e503                            ldi r16, SLA_R
0002a3 9300 00bb                 	  sts TWDR, r16
0002a5 e804                      	  ldi r16, (1<<TWINT)|(1<<TWEN)
0002a6 9300 00bc                 	  sts TWCR, r16
                                 
                                 	  
                                       //while (!(TWCR & (1<<TWINT)))
                                       //;
                                 	  wait11:
0002a8 9100 00bc                 	  lds r16,TWCR
0002aa ff07                      	  sbrs r16,TWINT
0002ab cffc                      	  rjmp wait11
                                       
                                 	 
                                       //if ((TWSR & 0xF8) !=
                                       //MR_SLA_ACK)
                                       //ERROR();
0002ac 9100 00b9                 	  lds r16,TWSR
0002ae 7f08                      	  andi r16, 0xF8
0002af 3400                      	  cpi r16, MR_SLA_ACK
0002b0 f499                      	  brne ERROR3
                                 
                                       
                                       //TWCR = (1<<TWINT) |
                                       //(0<<TWEA)|(1<<TWEN); //Data byte will be received and 
                                                             //NOT ACK TWEA=0 will be returned
0002b1 e804                            ldi r16, (1<<TWINT)|(0<<TWEA)|(1<<TWEN)
0002b2 9300 00bc                 	  sts TWCR, r16
                                 	  
                                 	  
                                       //while (!(TWCR & (1<<TWINT)))
                                       //;
                                 	  wait12:
0002b4 9100 00bc                 	  lds r16,TWCR
0002b6 ff07                      	  sbrs r16,TWINT
0002b7 cffc                      	  rjmp wait12
                                       
                                 	  
                                       //if ((TWSR & 0xF8) !=
                                       //MR_DATA_NOACK)
                                       //ERROR();
0002b8 9100 00b9                 	  lds r16,TWSR
0002ba 7f08                      	  andi r16, 0xF8
0002bb 3508                      	  cpi r16, MR_DATA_NOACK//MR_DATA_NOACK
0002bc f439                      	  brne ERROR3
                                       
                                      
                                       //data_lsb = TWDR; //read data byte
0002bd 9100 00bb                       lds r16,TWDR
0002bf 2f50                      	  mov DATA,r16
                                 
                                       
                                       //TWCR = (1<<TWINT)|(1<<TWEN)|
                                       //(1<<TWSTO); // Send a Stop Condition
0002c0 e904                            ldi r16, (1<<TWINT)|(1<<TWEN)|(1<<TWSTO)
0002c1 9300 00bc                 	  sts TWCR, r16
                                 
                                 	  
                                       //return data;
                                 
0002c3 9508                      ret
                                 
                                 ERROR3:
                                 ;rcall LCD
0002c4 9508                      ret
                                 
                                 
                                 
                                 
                                 
