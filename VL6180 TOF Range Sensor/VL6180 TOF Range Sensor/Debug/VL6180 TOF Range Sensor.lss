                                 //-----------------------------------------------------------------
00001c d2a8                       rcall LCD
                                 
                                 
                                 
                                 
                                 ; Replace with your application code
                                 main:
                                 
                                 
00001d e604                      		ldi r16, 100
00001e d133                      		rcall	WaitMiliseconds //wait
                                 /*
                                 
                                 
                                 		
                                 		
                                  wait0_1:
                                 
                                 ldi INDEX_HI, 0x00 //
                                 ldi INDEX_LO, 0x4D //RESULT__RANGE_STATUS{0x4D}; 
                                 //if [0] = 1 then 
                                 //Device Ready. When set to 1, indicates the device mode and
                                 //configuration can be changed and a new start command will be accepted
                                 rcall VL6180Read ;output in DATA
                                 
                                 
                                 
                                 mov r16,DATA
                                 sbrs r16,0
                                 rjmp wait0_1
                                 */
                                 
                                 
00001f e604                      		ldi r16, 100
000020 d131                      		rcall	WaitMiliseconds //wait
                                 		
                                 
                                 
000021 e030                      ldi INDEX_HI, 0x00 //
000022 e144                      ldi INDEX_LO, 0x14 //
000023 e054                      ldi DATA, 0x04
000024 d1eb                      rcall VL6180Write
                                 
                                 
                                 
                                 
000025 e604                      		ldi r16, 100
000026 d12b                      		rcall	WaitMiliseconds //wait
                                 		
                                 
                                 
000027 e030                      ldi INDEX_HI, 0x00 //
000028 e148                      ldi INDEX_LO, 0x18 //SYSRANGE_START{0x18}; [1] Ranging Mode Single-Shot, [0] starts a single measurement
000029 e051                      ldi DATA, 0x01
00002a d1e5                      rcall VL6180Write
                                 
                                 
                                 
00002b e604                      		ldi r16, 100
00002c d125                      		rcall	WaitMiliseconds //wait
                                 		
                                 
                                 wait0_0:
00002d e030                      ldi INDEX_HI, 0x00 //
00002e e44f                      ldi INDEX_LO, 0x4F //RESULT__INTERRUPT_STATUS_GPIO{0x4F}; if [2] = 1 then New Sample Ready threshold event
00002f d22d                      rcall VL6180Read; output in DATA
                                 
                                 
                                 
                                 
000030 2f05                      mov r16,DATA
000031 ff02                      sbrs r16,2
000032 cffa                      rjmp wait0_0
                                 
                                 
                                 
