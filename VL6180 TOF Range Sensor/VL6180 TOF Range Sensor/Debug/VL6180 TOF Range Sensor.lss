                                 .equ	RWW_START_ADDR	= 0x0
                                 .equ	RWW_STOP_ADDR	= 0x37ff
                                 .equ	PAGESIZE	= 64
                                 .equ	FIRSTBOOTSTART	= 0x3f00
                                 .equ	SECONDBOOTSTART	= 0x3e00
                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; VL6180 TOF Range Sensor.asm
                                 ;
                                 ; Created: 2018-05-12 14:39:56
                                 ; Author : Mikael Glans
                                 ;
                                 
                                 
                                 
                                 
                                 .dseg
000100                           PAGE_START_OLED: .BYTE 1 ; reserve 1 byte to PAGE_START_OLED
000101                           PAGE_END_OLED: .BYTE 1 ; reserve 1 byte to PAGE_START_OLED
000102                           COLUMN_START_OLED: .BYTE 1 ; reserve 1 byte to COLUMN_START_OLED 
000103                           COLUMN_END_OLED: .BYTE 1 ; reserve 1 byte to COLUMN_START_OLED 
                                 
                                 .cseg
                                 
                                 
                                 //---------System Clock init----------------
                                   #define F_CPU 20000000 //
                                  //---------System Clock init----------------
                                  
                                 		
                                 
                                 
                                 
                                 	
                                 	//---------------I2C definitions and init----------------------
                                 	//-------------------------------------------------------------
                                 	
                                 	.def INDEX_HI = r19
                                 	.def INDEX_LO = r20
                                 	.def DATA	  = r21
000000 2755                      	clr DATA
                                 	.equ SLA_W = 0x52 //0x52 slave adress, 0x29 and R/W=0
                                 	.equ SLA_R = 0x53 //0x53 slave adress, 0x29 and R/W=1 
                                 	.equ START = 0x08
                                 	.equ R_START = 0x10
                                 	.equ MT_SLA_ACK = 0x18
                                 	.equ MR_SLA_ACK = 0x40
                                 	.equ MT_DATA_ACK = 0x28
                                 	.equ MR_DATA_ACK = 0x50
                                 	.equ MT_DATA_NOACK = 0x30
                                 	.equ MR_DATA_NOACK = 0x58
                                 
000001 e604                      	ldi r16, 100
000002 d14f                      	rcall	WaitMiliseconds //wait .1s
                                 
                                 	// deactivate internal pullups for twi.
000003 e000                      	ldi r16, (0<<PC4)|(0<<PC5)
000004 9300 0007                 	sts DDRC, r16
                                 
                                 	//**********************OBS OBS OBS OBS********************************************************
                                 	//This step below for SCL Speed 100 kHz TWI is crucial, it won´t work at all in any other case
                                 	//Even Thou I2C it´s VERY time critical (Below 100kHz TWI won´t work. 
                                 	//Comment on 2018-05-19 after days on troubleshooting.
                                 	//------------SCL speed 400kHz @ 20MHz ATmega328p-----------
000006 e101                      	ldi r16, 0x11
000007 9300 00b8                 	sts TWBR, r16 //400kHz TWI
000009 e000                      	ldi r16, (0<<TWPS1)|(0<<TWPS0) //Prescaler 1
00000a 9300 00b9                 	sts TWSR, r16
                                 	 //--------------------------------------------
                                 	 //**********************OBS OBS OBS OBS********************************************************
                                 
                                 // enable twi module, acks, and twi interrupt
00000c e405                      ldi r16, (1<<TWEN) | (1<<TWIE) | (1<<TWEA)
00000d 9300 00bc                 sts TWCR, r16
                                 	 
                                 	//---------------I2C definitions and init----------------------
                                 	//-------------------------------------------------------------
                                 
                                 		
                                 
                                 
                                 
                                 //---------------init of VL6180------------------------------------
                                 //-----------------------------------------------------------------
00000f d032                      rcall VL6180_settings
                                 		
000010 ec08                      		ldi r16, 200
000011 d140                      		rcall	WaitMiliseconds //wait 1s
000012 ec08                      		ldi r16, 200
000013 d13e                      		rcall	WaitMiliseconds
000014 ec08                      		ldi r16, 200
000015 d13c                      		rcall	WaitMiliseconds //
000016 ec08                      		ldi r16, 200
000017 d13a                      		rcall	WaitMiliseconds
000018 ec08                      		ldi r16, 200
000019 d138                      		rcall	WaitMiliseconds
00001a ec08                      		ldi r16, 200
00001b d136                      		rcall	WaitMiliseconds
                                 
