                 OWResetWS2811:
000227 985b      	cbi		PORTD, PD3  //
                 	
000228 e0b0      	ldi		XH, HIGH(DVUS(50))
000229 efaa      	ldi		XL, LOW(DVUS(50))
00022a de2d      	rcall	Wait4xCycles
                 	
                 	
                 
00022b 9508      	ret
                 
                 
00022c 9508      ret
                 ;------------------------------------------------------------------------------
                 ; Output : r16 - byte from slave
                 ;------------------------------------------------------------------------------
                 DAC:
                 
                  //---------------------1-wire init Vcc powered device Overdrive Mode---------------
00022d d063      	rcall OWReset
00022e e30c      	ldi r16, 0x3C     //Overdrive skip ROM
00022f d07e      	rcall OWWriteByte
000230 ec0c      	ldi r16, 0xCC     //Write Conditional Search Register command
000231 d03b      	rcall OWWriteByteOD
000232 e80d      	ldi r16, 0x8D     //TA1 beginning adress
000233 d039      	rcall OWWriteByteOD
000234 e000      	ldi r16, 0x00     //TA2 adress 008Dh
000235 d037      	rcall OWWriteByteOD
000236 e801      	ldi r16, 0x81     //data byte adress 008Dh
000237 d035      	rcall OWWriteByteOD
                 	//---------------------1-wire init Vcc powered device Overdrive Mode---------------
                 
000238 d017      	rcall OWResetOD
000239 e30c      	ldi r16, 0x3C     //Overdrive skip ROM
00023a d032      	rcall OWWriteByteOD
00023b ef00      	ldi r16, 0xF0     //Read PIO Registers command
00023c d030      	rcall OWWriteByteOD
00023d e80d      	ldi r16, 0x8D     //TA1 beginning adress
00023e d02e      	rcall OWWriteByteOD
00023f e000      	ldi r16, 0x00     //TA2 adress 008Dh
000240 d02c      	rcall OWWriteByteOD
000241 d046      	rcall OWReadByteOD //Read Control/Status Register and verify
                 
000242 d00d      	rcall OWResetOD
000243 e30c      	ldi r16, 0x3C     //Overdrive skip ROM
000244 d028      	rcall OWWriteByteOD
000245 e50a      	ldi r16, 0x5A     //Channel-access Write command
000246 d026      	rcall OWWriteByteOD
000247 2f02      	mov r16, r18     //Write byte to PIO
000248 d024      	rcall OWWriteByteOD
000249 2f02      	mov r16, r18     //
00024a 9500      	com r16           //
                 	//ldi r16, 0xFF     //Write inverted byte to PIO
00024b d021      	rcall OWWriteByteOD
00024c d03b      	rcall OWReadByteOD //Read for verification (AAh = success)
00024d d03a      	rcall OWReadByteOD //Read PIO pin status
00024e d001      	rcall OWResetOD
                 	
00024f 9508      ret
                 
                 
                 
                 ;-------------------Overdrive Mode Start---------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 ;------------------------------------------------------------------------------
                 ; Output : T - presence bit
                 ;------------------------------------------------------------------------------
                 OWResetOD:
000250 9859      	cbi		OW_PORT,OW_DQ
000251 9a51      	sbi		OW_DDR,OW_DQ
                 
000252 e0b1      	ldi		XH, HIGH(DVUS(55))
000253 e1a3      	ldi		XL, LOW(DVUS(55))
000254 de03      	rcall	Wait4xCycles
                 	
000255 9851      	cbi		OW_DDR,OW_DQ
                 
000256 e0b0      	ldi		XH, HIGH(DVUS(8))
000257 e2a8      	ldi		XL, LOW(DVUS(8))
000258 ddff      	rcall	Wait4xCycles
                 
000259 9468      	set
00025a 9b49      	sbis	OW_PIN,OW_DQ
00025b 94e8      	clt
                 
00025c e0b0      	ldi		XH, HIGH(DVUS(48))
00025d efa0      	ldi		XL, LOW(DVUS(48))
00025e ddf9      	rcall	Wait4xCycles
                 
00025f 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : C - bit to write
                 ;------------------------------------------------------------------------------
                 OWWriteBitOD:
000260 f418      	brcc	OWWriteZeroOD
000261 e0b0      	ldi		XH, HIGH(DVUS(1))//Måste Kalibreras
000262 e0a5      	ldi		XL, LOW(DVUS(1))//Måste Kalibreras
000263 c002      	rjmp	OWWriteOneOD
                 OWWriteZeroOD:	
000264 e0b0      	ldi		XH, HIGH(DVUS(10)) 
000265 e3a2      	ldi		XL, LOW(DVUS(10)) 
                 OWWriteOneOD:
000266 9a51      	sbi		OW_DDR, OW_DQ
000267 ddf0      	rcall	Wait4xCycles
000268 9851      	cbi		OW_DDR, OW_DQ
                 	
000269 e0b0      	ldi		XH, HIGH(DVUS(10))
00026a e3a2      	ldi		XL, LOW(DVUS(10))
00026b ddec      	rcall	Wait4xCycles
00026c 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : r16 - byte to write
                 ;------------------------------------------------------------------------------
                 OWWriteByteOD:
00026d 931f      	push	OWCount
00026e e010      	ldi		OWCount,0
                 OWWriteLoopOD:	
00026f 9507      	ror		r16
000270 dfef      	rcall	OWWriteBitOD	
000271 9513      	inc		OWCount
000272 3018      	cpi		OWCount,8
000273 f7d9      	brne	OWWriteLoopOD
000274 911f      	pop		OWCount		
000275 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Output : C - bit from slave
                 ;------------------------------------------------------------------------------
                 OWReadBitOD:
000276 e0b0      	ldi		XH, HIGH(DVUS(1)) //Måste kalibreras
000277 e0a5      	ldi		XL, LOW(DVUS(1)) //Måste kalibreras
000278 9a51      	sbi		OW_DDR, OW_DQ
000279 ddde      	rcall	Wait4xCycles
00027a 9851      	cbi		OW_DDR, OW_DQ
00027b e0b0      	ldi		XH, HIGH(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent, 1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
00027c e0a5      	ldi		XL, LOW(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent,  1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
00027d ddda      	rcall	Wait4xCycles
00027e 94e8      	clt
00027f 9949      	sbic	OW_PIN,OW_DQ
000280 9468      	set
000281 e0b0      	ldi		XH, HIGH(DVUS(10))
000282 e3a2      	ldi		XL, LOW(DVUS(10))
000283 ddd4      	rcall	Wait4xCycles
000284 9408      	sec
000285 f00e      	brts	OWReadBitEndOD
000286 9488      	clc
                 OWReadBitEndOD:
000287 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Output : r16 - byte from slave
                 ;------------------------------------------------------------------------------
                 OWReadByteOD:
000288 931f      	push	OWCount
000289 e010      	ldi		OWCount,0
