                  //---------System Clock init----------------
                   #define F_CPU 20000000 //
                 
                  //ldi r16, 0xFF
                  //out OSCCAL, r16
                 
                 /* ldi r16,(1<<CLKPS3)|(0<<CLKPS2)|(0<<CLKPS1)|(0<<CLKPS0)
                  out CLKPR, r16 //prescaler 256*/
                  //---------System Clock init----------------
                  
                 
                 
000000 e008        ldi r16, (1<<DDD3)
000001 b90a        out DDRD, r16
                   
                 
                   
                 
                  
000002 d063       rcall LCD
                 
                 	
                 
                 	
                 
                 	.def Count = r22
                 
                 
                 	
                 	
                 
                 
                 
                 	
                 	
                 
                  Main:
                 
                 
000003 d223       rcall OWResetWS2811
000004 e001      	ldi r16, 1
000005 d055      	rcall	WaitMiliseconds
000006 e000      	ldi r16, 0x00
000007 d1fb      	rcall WS2811
000008 e000      	ldi r16, 0x00
000009 d1f9      	rcall WS2811
00000a e000      	ldi r16, 0x00
00000b d1f7      	rcall WS2811
00000c d21a      	rcall OWResetWS2811
