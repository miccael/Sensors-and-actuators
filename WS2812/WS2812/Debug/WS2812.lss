                 WS2812:
                 
                 //rcall OWResetWS2812
                 ;------------------------------------------------------------------------------
                 ; Input : r16 - byte to write
                 ;------------------------------------------------------------------------------
                 OWWriteByteWS2812:
0001e0 931f      	push	OWCount
0001e1 e010      	ldi		OWCount,0
                 OWWriteLoopWS2812:	
0001e2 9507      	ror		r16
0001e3 d005      	rcall	OWWriteBitWS2812
                 		
0001e4 9513      	inc		OWCount
0001e5 3018      	cpi		OWCount,8
0001e6 f7d9      	brne	OWWriteLoopWS2812
0001e7 911f      	pop		OWCount		
0001e8 9508      	ret
                 
                 ;------------------------------------------------------------------------------
                 ; Input : C - bit to write
                 ;------------------------------------------------------------------------------
                 OWWriteBitWS2812:
0001e9 f408      	brcc	OWWriteZeroWS2812
0001ea c006      	rjmp	OWWriteOneWS2812
                 OWWriteZeroWS2812:
                 		
0001eb ee50      		ldi r21, 0b11100000
0001ec bd5e      		out SPDR,r21
                 		Wait_Transmit0:
                 		; Wait for transmission complete
0001ed b55d      		in r21, SPSR
0001ee ff57      		sbrs r21, SPIF
0001ef cffd      		rjmp Wait_Transmit0	
                 		
0001f0 c005      	rjmp	OWWriteBitWS2812END
                 OWWriteOneWS2812:
                 		
0001f1 ef5e      		ldi r21, 0b11111110
0001f2 bd5e      		out SPDR,r21
                 		
                 		
                 		Wait_Transmit1:
                 		; Wait for transmission complete
0001f3 b55d      		in r21, SPSR
0001f4 ff57      		sbrs r21, SPIF
0001f5 cffd      		rjmp Wait_Transmit1	
                 		
                 OWWriteBitWS2812END:
0001f6 9508      	ret
                 
                 OWResetWS2812:
0001f7 982d      	cbi		PORTB, PB5  //is idle high????IMPORTANT!
                 	
0001f8 e0b1      	ldi		XH, HIGH(DVUS(55))
0001f9 e1a3      	ldi		XL, LOW(DVUS(55))
0001fa de3a      	rcall	Wait4xCycles
                 	
0001fb 9a2d      	sbi		PORTB, PB5
                 
0001fc 9508      	ret
                 
                 
0001fd 9508      ret
                 ;------------------------------------------------------------------------------
                 ; Output : r16 - byte from slave
                 ;------------------------------------------------------------------------------
                 DAC:
                 
                  //---------------------1-wire init Vcc powered device Overdrive Mode---------------
0001fe d0cc      	rcall OWReset
0001ff e30c      	ldi r16, 0x3C     //Overdrive skip ROM
000200 d0e7      	rcall OWWriteByte
000201 ec0c      	ldi r16, 0xCC     //Write Conditional Search Register command
000202 d0a4      	rcall OWWriteByteOD
000203 e80d      	ldi r16, 0x8D     //TA1 beginning adress
000204 d0a2      	rcall OWWriteByteOD
000205 e000      	ldi r16, 0x00     //TA2 adress 008Dh
000206 d0a0      	rcall OWWriteByteOD
000207 e801      	ldi r16, 0x81     //data byte adress 008Dh
000208 d09e      	rcall OWWriteByteOD
                 	//---------------------1-wire init Vcc powered device Overdrive Mode---------------
                 
000209 d080      	rcall OWResetOD
00020a e30c      	ldi r16, 0x3C     //Overdrive skip ROM
00020b d09b      	rcall OWWriteByteOD
00020c ef00      	ldi r16, 0xF0     //Read PIO Registers command
00020d d099      	rcall OWWriteByteOD
00020e e80d      	ldi r16, 0x8D     //TA1 beginning adress
00020f d097      	rcall OWWriteByteOD
000210 e000      	ldi r16, 0x00     //TA2 adress 008Dh
000211 d095      	rcall OWWriteByteOD
000212 d0af      	rcall OWReadByteOD //Read Control/Status Register and verify
                 
000213 d076      	rcall OWResetOD
000214 e30c      	ldi r16, 0x3C     //Overdrive skip ROM
000215 d091      	rcall OWWriteByteOD
000216 e50a      	ldi r16, 0x5A     //Channel-access Write command
000217 d08f      	rcall OWWriteByteOD
000218 2f02      	mov r16, r18     //Write byte to PIO
000219 d08d      	rcall OWWriteByteOD
00021a 2f02      	mov r16, r18     //
00021b 9500      	com r16           //
                 	//ldi r16, 0xFF     //Write inverted byte to PIO
00021c d08a      	rcall OWWriteByteOD
00021d d0a4      	rcall OWReadByteOD //Read for verification (AAh = success)
00021e d0a3      	rcall OWReadByteOD //Read PIO pin status
00021f d06a      	rcall OWResetOD
                 	
000220 9508      ret
                 
                 ;------------------------------------------------------------------------------
                 ; Output : r16 - byte from slave
                 ;------------------------------------------------------------------------------
                 SENSOR_DS1822:
                 
000221 d0ea      	rcall OWResetDS1822
000222 ec0c      	ldi r16, 0xCC     //skip ROM
000223 d105      	rcall OWWriteByteDS1822
000224 e40e      	ldi r16, 0x4E     //Master issues Write Scratchpad command
000225 d103      	rcall OWWriteByteDS1822
000226 e400      	ldi r16, 0b01000000     //Master sends three data bytes to scratchpad (TH, TL, and config) [TH] S=0 positive numbers
000227 d101      	rcall OWWriteByteDS1822
000228 e008      	ldi r16, 0b00001000     // [TL] S=0 positive numbers
000229 d0ff      	rcall OWWriteByteDS1822
00022a e10f      	ldi r16, 0b00011111     // [CONFIGURATION REGISTER] 9-bit resolution, 93.75ms conversion time
00022b d0fd      	rcall OWWriteByteDS1822
                 
00022c d0df      	rcall OWResetDS1822
00022d ec0c      	ldi r16, 0xCC     //skip ROM
00022e d0fa      	rcall OWWriteByteDS1822
00022f eb0e      	ldi r16, 0xBE     //Master issues Read Scratchpad command.
000230 d0f8      	rcall OWWriteByteDS1822
000231 d112      	rcall OWReadByteDS1822 //Read 9 Byte
000232 d111      	rcall OWReadByteDS1822 //
000233 d110      	rcall OWReadByteDS1822 //
000234 d10f      	rcall OWReadByteDS1822 //
000235 d10e      	rcall OWReadByteDS1822 //
000236 d10d      	rcall OWReadByteDS1822 //
000237 d10c      	rcall OWReadByteDS1822 //
000238 d10b      	rcall OWReadByteDS1822 //
000239 d10a      	rcall OWReadByteDS1822 //
                 
00023a d0d1      	rcall OWResetDS1822
00023b ec0c      	ldi r16, 0xCC     //skip ROM
00023c d0ec      	rcall OWWriteByteDS1822
00023d e408      	ldi r16, 0x48     //Master issues Copy Scratchpad command
00023e d0ea      	rcall OWWriteByteDS1822
00023f e00c      	ldi r16, 12
000240 ddf7      	rcall	WaitMiliseconds //Master applies strong pullup to DQ for at least 10ms while copy operation is in progress
                 
000241 d0ca      	rcall OWResetDS1822
000242 ec0c      	ldi r16, 0xCC     //skip ROM
000243 d0e5      	rcall OWWriteByteDS1822
000244 e404      	ldi r16, 0x44     //Master issues Convert T command
000245 d0e3      	rcall OWWriteByteDS1822
000246 e604      	ldi r16, 100
000247 ddf0      	rcall	WaitMiliseconds //Master applies strong pullup to DQ for the duration of the conversion (tconv)
                 
000248 d0c3      	rcall OWResetDS1822
000249 ec0c      	ldi r16, 0xCC     //skip ROM
00024a d0de      	rcall OWWriteByteDS1822
00024b eb0e      	ldi r16, 0xBE     //Master issues Read Scratchpad command
00024c d0dc      	rcall OWWriteByteDS1822
00024d d0f6      	rcall OWReadByteDS1822 //Read 2 Byte, Temperature LSB
00024e d0f5      	rcall OWReadByteDS1822 // Temperature MSB
00024f 2f30      	mov r19, r16
000250 0f33      	lsl r19
000251 0f33      	lsl r19
000252 0f33      	lsl r19
                 
                 
                 
                 
000253 e020      	ldi r18, 0b00000000 //format RS:E:D7:D6:D5:D4:N/A:N/A Clear Display
000254 dfa9      rcall DAC
000255 ec08      	ldi r16, 200
000256 dde1      	rcall	WaitMiliseconds
000257 e420      ldi r18, 0b01000000 //format RS:E:D7:D6:D5:D4:N/A:N/A
000258 dfa5      rcall DAC
000259 ec08      	ldi r16, 200
00025a dddd      	rcall	WaitMiliseconds
00025b e020      ldi r18, 0b00000000 //format RS:E:D7:D6:D5:D4:N/A:N/A
00025c dfa1      rcall DAC
00025d ec08      	ldi r16, 200
00025e ddd9      	rcall	WaitMiliseconds
00025f e024      ldi r18, 0b00000100 //format RS:E:D7:D6:D5:D4:N/A:N/A 
000260 df9d      rcall DAC
000261 ec08      	ldi r16, 200
000262 ddd5      	rcall	WaitMiliseconds
000263 e424      ldi r18, 0b01000100 //format RS:E:D7:D6:D5:D4:N/A:N/A
000264 df99      rcall DAC
000265 ec08      	ldi r16, 200
000266 ddd1      	rcall	WaitMiliseconds
000267 e024      ldi r18, 0b00000100 //format RS:E:D7:D6:D5:D4:N/A:N/A
000268 df95      rcall DAC
000269 ec08      	ldi r16, 200
00026a ddcd      	rcall	WaitMiliseconds
                 
                 //Temperature information
                 
00026b e840      ldi r20, 0b10000000
00026c 2b43      or r20, r19
00026d 2f24      mov r18, r20
00026e df8f      rcall DAC
00026f ec08      	ldi r16, 200
000270 ddc7      	rcall	WaitMiliseconds
000271 ec40      ldi r20, 0b11000000
000272 2b43      or r20, r19
000273 2f24      mov r18, r20
000274 df89      rcall DAC
000275 ec08      	ldi r16, 200
000276 ddc1      	rcall	WaitMiliseconds
000277 e840      ldi r20, 0b10000000
000278 2b43      or r20, r19
000279 2f24      mov r18, r20
00027a df83      rcall DAC
00027b ec08      	ldi r16, 200
00027c ddbb      	rcall	WaitMiliseconds
00027d e820      ldi r18, 0b10000000 //format RS:E:D7:D6:D5:D4:N/A:N/A 
00027e df7f      rcall DAC
00027f ec08      	ldi r16, 200
000280 ddb7      	rcall	WaitMiliseconds
000281 ec20      ldi r18, 0b11000000 //format RS:E:D7:D6:D5:D4:N/A:N/A
000282 df7b      rcall DAC
000283 ec08      	ldi r16, 200
000284 ddb3      	rcall	WaitMiliseconds
000285 e820      ldi r18, 0b10000000 //format RS:E:D7:D6:D5:D4:N/A:N/A
000286 df77      rcall DAC
000287 ec08      	ldi r16, 200
000288 ddaf      	rcall	WaitMiliseconds
                 	
000289 9508      ret
                 
                 ;-------------------Overdrive Mode Start---------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 ;------------------------------------------------------------------------------
                 ; Output : T - presence bit
                 ;------------------------------------------------------------------------------
                 OWResetOD:
00028a 9859      	cbi		OW_PORT,OW_DQ
00028b 9a51      	sbi		OW_DDR,OW_DQ
                 
00028c e0b1      	ldi		XH, HIGH(DVUS(55))
00028d e1a3      	ldi		XL, LOW(DVUS(55))
00028e dda6      	rcall	Wait4xCycles
                 	
00028f 9851      	cbi		OW_DDR,OW_DQ
                 
000290 e0b0      	ldi		XH, HIGH(DVUS(8))
000291 e2a8      	ldi		XL, LOW(DVUS(8))
000292 dda2      	rcall	Wait4xCycles
                 
000293 9468      	set
000294 9b49      	sbis	OW_PIN,OW_DQ
000295 94e8      	clt
                 
000296 e0b0      	ldi		XH, HIGH(DVUS(48))
000297 efa0      	ldi		XL, LOW(DVUS(48))
000298 dd9c      	rcall	Wait4xCycles
                 
000299 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : C - bit to write
                 ;------------------------------------------------------------------------------
                 OWWriteBitOD:
00029a f418      	brcc	OWWriteZeroOD
00029b e0b0      	ldi		XH, HIGH(DVUS(1))//Måste Kalibreras
00029c e0a5      	ldi		XL, LOW(DVUS(1))//Måste Kalibreras
00029d c002      	rjmp	OWWriteOneOD
                 OWWriteZeroOD:	
00029e e0b0      	ldi		XH, HIGH(DVUS(10)) 
00029f e3a2      	ldi		XL, LOW(DVUS(10)) 
                 OWWriteOneOD:
0002a0 9a51      	sbi		OW_DDR, OW_DQ
0002a1 dd93      	rcall	Wait4xCycles
0002a2 9851      	cbi		OW_DDR, OW_DQ
                 	
0002a3 e0b0      	ldi		XH, HIGH(DVUS(10))
0002a4 e3a2      	ldi		XL, LOW(DVUS(10))
0002a5 dd8f      	rcall	Wait4xCycles
0002a6 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : r16 - byte to write
                 ;------------------------------------------------------------------------------
                 OWWriteByteOD:
0002a7 931f      	push	OWCount
0002a8 e010      	ldi		OWCount,0
                 OWWriteLoopOD:	
0002a9 9507      	ror		r16
0002aa dfef      	rcall	OWWriteBitOD	
0002ab 9513      	inc		OWCount
0002ac 3018      	cpi		OWCount,8
0002ad f7d9      	brne	OWWriteLoopOD
0002ae 911f      	pop		OWCount		
0002af 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Output : C - bit from slave
                 ;------------------------------------------------------------------------------
                 OWReadBitOD:
0002b0 e0b0      	ldi		XH, HIGH(DVUS(1)) //Måste kalibreras
0002b1 e0a5      	ldi		XL, LOW(DVUS(1)) //Måste kalibreras
0002b2 9a51      	sbi		OW_DDR, OW_DQ
0002b3 dd81      	rcall	Wait4xCycles
0002b4 9851      	cbi		OW_DDR, OW_DQ
0002b5 e0b0      	ldi		XH, HIGH(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent, 1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
0002b6 e0a5      	ldi		XL, LOW(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent,  1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
0002b7 dd7d      	rcall	Wait4xCycles
0002b8 94e8      	clt
0002b9 9949      	sbic	OW_PIN,OW_DQ
0002ba 9468      	set
0002bb e0b0      	ldi		XH, HIGH(DVUS(10))
0002bc e3a2      	ldi		XL, LOW(DVUS(10))
0002bd dd77      	rcall	Wait4xCycles
0002be 9408      	sec
0002bf f00e      	brts	OWReadBitEndOD
0002c0 9488      	clc
                 OWReadBitEndOD:
0002c1 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Output : r16 - byte from slave
                 ;------------------------------------------------------------------------------
                 OWReadByteOD:
0002c2 931f      	push	OWCount
0002c3 e010      	ldi		OWCount,0
                 OWReadLoopOD:
0002c4 dfeb      	rcall	OWReadBitOD
0002c5 9507      	ror		r16
0002c6 9513      	inc		OWCount
0002c7 3018      	cpi		OWCount,8
0002c8 f7d9      	brne	OWReadLoopOD
0002c9 911f      	pop		OWCount
0002ca 9508      	ret
                 ;------------------------------------------------------------------------------
                 ;
                 ;------------------------------------------------------------------------------
                 
                 
                 
                 ;-------------------Overdrive Mode End-----------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 
                 ;-------------------Standard Mode Start-----------------------------------------
                 ;------------------------------------------------------------------------------
                 
                 ;------------------------------------------------------------------------------
                 ; Output : T - presence bit
                 ;------------------------------------------------------------------------------
                 OWReset:
0002cb 9859      	cbi		OW_PORT,OW_DQ
0002cc 9a51      	sbi		OW_DDR,OW_DQ
                 
0002cd e0b9      	ldi		XH, HIGH(DVUS(470))
0002ce e2ae      	ldi		XL, LOW(DVUS(470))
0002cf dd65      	rcall	Wait4xCycles
                 	
0002d0 9851      	cbi		OW_DDR,OW_DQ
                 
0002d1 e0b1      	ldi		XH, HIGH(DVUS(70))
0002d2 e5ae      	ldi		XL, LOW(DVUS(70))
0002d3 dd61      	rcall	Wait4xCycles
                 
