                  * WS2812.asm
                  *
                  *  Created: 2015-05-18 16:47:46
                  *   Author: Mikael
                  */ 
                 
                 
                  //---------System Clock init----------------
                   #define F_CPU 20000000 //
                 
                  //ldi r16, 0xFF
                  //out OSCCAL, r16
                 
                 /* ldi r16,(1<<CLKPS3)|(0<<CLKPS2)|(0<<CLKPS1)|(0<<CLKPS0)
                  out CLKPR, r16 //prescaler 256*/
                  //---------System Clock init----------------
                  
                 //-------------------SPI init------------------------------------------------------------------------------
000000 e20c        ldi r16, (1<<DDB2)|(1<<DDB3)|(1<<DDB5) ;PB2 |SS [16], PB3 MOSI [17], PB5 SCK [19]
000001 b904        out DDRB, r16 ;
                 
                   //ldi r16, (1<<PB5) ;SCK is high to begin with (this is crucial, why?)
                   //out PORTB, r16
                 
000002 e000        ldi r16, (0<<PRSPI)
000003 9300 0064   sts PRR, r16 //Power Reduction Serial Peripheral Interface bit disabled
                 
                   ; Enable SPI, MSB first, sample (rising) setup (falling), Master, set clock rate fck/2
000005 e50c      ldi r16, (0<<SPIE)|(1<<SPE)|(0<<DORD)|(1<<CPOL)|(1<<CPHA)|(1<<MSTR)|(0<<SPR1)|(0<<SPR0)
000006 bd0c      out SPCR,r16
                   ; Double SPI Speed Bit set
000007 e001      ldi r16, (1<<SPI2X)
000008 bd0d      out SPSR,r16
                 
                 /*ldi r16, (1<<UMSEL01)|(1<<UMSEL00)|(0<<UDORD0)|(0<<UCPHA0)|(0<<UCPOL0)
                 sts UCSR0C, r16*/ //UART example
                  //------------------SPI init-------------------------------------------------------------------------------
                  
                  //-------------------ADC init------------------------------------------------------------------------------
000009 e000       ldi r16, (0<<PRADC)
00000a 9300 0064  sts PRR, r16 //Power Reduction ADC bit disabled
                  
00000c e600       ldi r16, (0<<REFS1)|(1<<REFS0)|(1<<ADLAR)|(0<<MUX3)|(0<<MUX2)|(0<<MUX1)|(0<<MUX0) 
00000d 9300 007c  sts ADMUX, r16 ;AVCC with external capacitor at AREF pin, result left adjusted, ADC0/PC0 [23] input channel 
                 
00000f e807       ldi r16, (1<<ADEN)|(0<<ADSC)|(0<<ADATE)|(0<<ADIF)|(0<<ADIE)|(1<<ADPS2)|(1<<ADPS1)|(1<<ADPS0) 
000010 9300 007a  sts ADCSRA, r16 ;ADC Disable, ADC not start conversion, ADC Auto Trigger Enable, ADC Prescaler Select Bits 128
                 
                 
000012 e007       ldi r16, (1<<ADTS2)|(1<<ADTS1)|(1<<ADTS0)
000013 9300 007b  sts ADCSRB, r16 ;ADC Auto Trigger Source: Free Running Mode (Temporarily Disabled)
                 
000015 e000       ldi r16, (0<<ADC0D)
000016 9300 007e  sts DIDR0, r16 ;ADC5D..ADC0D: ADC5..0 Digital Input Enabled: on ADC0
                  //-------------------ADC init------------------------------------------------------------------------------
                  
000018 d02a       rcall LCD
                 
                 	
                 
                 	
                 
                 	.def Count = r22
                 
000019 937f      	push r23
00001a 938f      	push r24
00001b 939f      	push r25
00001c 936f      	push	Count
00001d e870      	ldi     r23, 0b10000000
00001e e081      	ldi     r24, 0b00000001
00001f e890      	ldi     r25, 0b10000000
000020 e060      	ldi		Count,0
                 LoopWS2812:	
000021 9576      	lsr		r23
000022 0f88      	lsl     r24
000023 9596      	lsr     r25
                 	
000024 2f07      	mov r16, r23
                 	//ldi r16, 0b11111000
000025 d1ba      	rcall WS2812
                 
000026 2f08      	mov r16, r24
                 	//ldi r16, 0b00000000
000027 d1b8      	rcall WS2812
                 	
000028 2f09      	mov r16, r25
                 	//ldi r16, 0b11111000
000029 d1b6      	rcall WS2812
                 	
00002a ec08      		ldi r16, 200
00002b d00c      	rcall	WaitMiliseconds
00002c 9563      	inc		Count
00002d 3067      	cpi		Count,7
00002e f791      brne	LoopWS2812
00002f 916f      	pop		Count	
000030 917f      	pop r23
000031 918f      	pop r24
000032 919f      	pop r25
                 	
                 
                  Main:
                 
                  /*
                  //------------------ADC method-----------------------
                  ldi r16, (1<<ADEN)|(1<<ADSC)|(0<<ADATE)|(0<<ADIF)|(0<<ADIE)|(1<<ADPS2)|(1<<ADPS1)|(1<<ADPS0)
                  sts ADCSRA, r16 //ADC Conversion Started
                  loop:
                  lds r16, ADCSRA
                  sbrc r16, ADIF
                  rjmp loop
                  
                  
                  lds r18, ADCH
                  rcall DAC
                  
                  
                  ldi r16, (1<<ADEN)|(0<<ADSC)|(0<<ADATE)|(1<<ADIF)|(0<<ADIE)|(1<<ADPS2)|(1<<ADPS1)|(1<<ADPS0)
                  sts ADCSRA, r16 //ADC Flag cleared
                 //------------------ADC method-----------------------
                 */
                 
                 	
                 	
                 
                 
000033 d1ed      	rcall SENSOR_DS1822
                 	
                 	
                 	
                 	
                 
                  
                 	
                 
000034 cffe      	rjmp Main
                 
                 
                  #include "wait.asm" ; AVR Assembler v.2
                 
                  * wait.asm
                  *
                  *  Created: 2015-01-01 18:40:21
                  *   Author: Mikael
                  */ 
                 
                 
                 ;------------------------------------------------------------------------------
                 ; Busy-wait loops utilities module
                 ; For F_CPU >= 4MHz
                 ; http://avr-mcu.dxp.pl
                 ; (c) Radoslaw Kwiecien, 2008
                 ;------------------------------------------------------------------------------
                 
                 #ifndef F_CPU
                 #endif
                 
                 #if F_CPU < 4000000
                 #endif
                 
                 #define CYCLES_PER_US (F_CPU/1000000)
                 #define C4PUS (CYCLES_PER_US/4)
                 #define DVUS(x) (C4PUS*x)
                 
                 ;------------------------------------------------------------------------------
                 ; Input : XH:XL - number of CPU cycles to wait (divided by four)
                 ;------------------------------------------------------------------------------
                 Wait4xCycles:
000035 9711        sbiw	  XH:XL, 1
000036 f7f1        brne	  Wait4xCycles
000037 9508        ret
                 ;------------------------------------------------------------------------------
                 ; Input : r16 - number of miliseconds to wait
                 ;------------------------------------------------------------------------------
                 WaitMiliseconds:
000038 930f        push	r16
                 WaitMsLoop: 
000039 e0b9        ldi	   XH,HIGH(DVUS(500))
00003a eca4        ldi	   XL,LOW(DVUS(500))
00003b dff9        rcall	 Wait4xCycles
00003c e0b9        ldi	   XH,HIGH(DVUS(500))
00003d eca4        ldi	   XL,LOW(DVUS(500))
00003e dff6        rcall	 Wait4xCycles
00003f 950a        dec	   r16
000040 f7c1        brne	  WaitMsLoop
000041 910f        pop	   r16
000042 9508        ret
                 ;------------------------------------------------------------------------------
                 ; End of file
                  ;------------------------------------------------------------------------------
                 ; 1-wire definitions
                 ;------------------------------------------------------------------------------
                 .equ	OW_PORT	= PORTD
                 .equ	OW_PIN	= PIND
                 .equ	OW_DDR	= DDRD
                 .equ	OW_DQ	= PD1
                 
                 .def	OWCount = r17
                 ;------------------------------------------------------------------------------
                 ; 1-wire definitions
                 ;------------------------------------------------------------------------------
                 
                 
