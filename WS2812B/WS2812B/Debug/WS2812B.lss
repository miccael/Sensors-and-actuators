000202 de8c      	rcall	Wait4xCycles
000203 9854      	cbi		OW_DDR, OW_DQ
                 	
000204 e0b0      	ldi		XH, HIGH(DVUS(10))
000205 e3a2      	ldi		XL, LOW(DVUS(10))
000206 de88      	rcall	Wait4xCycles
000207 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : r16 - byte to write
                 ;------------------------------------------------------------------------------
                 OWWriteByteOD:
000208 931f      	push	OWCount
000209 e010      	ldi		OWCount,0
                 OWWriteLoopOD:	
00020a 9507      	ror		r16
00020b dfef      	rcall	OWWriteBitOD	
00020c 9513      	inc		OWCount
00020d 3018      	cpi		OWCount,8
00020e f7d9      	brne	OWWriteLoopOD
00020f 911f      	pop		OWCount		
000210 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Output : C - bit from slave
                 ;------------------------------------------------------------------------------
                 OWReadBitOD:
000211 e0b0      	ldi		XH, HIGH(DVUS(1)) //Måste kalibreras
000212 e0a5      	ldi		XL, LOW(DVUS(1)) //Måste kalibreras
000213 9a54      	sbi		OW_DDR, OW_DQ
000214 de7a      	rcall	Wait4xCycles
000215 9854      	cbi		OW_DDR, OW_DQ
000216 e0b0      	ldi		XH, HIGH(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent, 1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
000217 e0a5      	ldi		XL, LOW(DVUS(1)) //1.5 kohm optimal pull-up. Kalibrera så att sampling inte sker försent,  1us-2us tRD - READ VALID, pga oexakta tider, oscilloskop!
000218 de76      	rcall	Wait4xCycles
000219 94e8      	clt
00021a 994c      	sbic	OW_PIN,OW_DQ
00021b 9468      	set
00021c e0b0      	ldi		XH, HIGH(DVUS(10))
00021d e3a2      	ldi		XL, LOW(DVUS(10))
00021e de70      	rcall	Wait4xCycles
00021f 9408      	sec
000220 f00e      	brts	OWReadBitEndOD
000221 9488      	clc
                 OWReadBitEndOD:
000222 9508      	ret
