                  #include "wait.asm" ; AVR Assembler v.2
                 
                  * wait.asm
                  *
                  *  Created: 2015-01-01 18:40:21
                  *   Author: Mikael
                  */ 
                 
                 
                 ;------------------------------------------------------------------------------
                 ; Busy-wait loops utilities module
                 ; For F_CPU >= 4MHz
                 ; http://avr-mcu.dxp.pl
                 ; (c) Radoslaw Kwiecien, 2008
                 ;------------------------------------------------------------------------------
                 
                 #ifndef F_CPU
                 #endif
                 
                 #if F_CPU < 4000000
                 #endif
                 
                 #define CYCLES_PER_US (F_CPU/1000000)
                 #define C4PUS (CYCLES_PER_US/4)
                 #define DVUS(x) (C4PUS*x)
                 
                 ;------------------------------------------------------------------------------
                 ; Input : XH:XL - number of CPU cycles to wait (divided by four)
                 ;------------------------------------------------------------------------------
                 Wait4xCycles:
00008f 9711        sbiw	  XH:XL, 1
000090 f7f1        brne	  Wait4xCycles
000091 9508        ret
                 ;------------------------------------------------------------------------------
                 ; Input : r16 - number of miliseconds to wait
                 ;------------------------------------------------------------------------------
                 WaitMiliseconds:
000092 930f        push	r16
                 WaitMsLoop: 
000093 e0b9        ldi	   XH,HIGH(DVUS(500))
000094 eca4        ldi	   XL,LOW(DVUS(500))
000095 dff9        rcall	 Wait4xCycles
000096 e0b9        ldi	   XH,HIGH(DVUS(500))
000097 eca4        ldi	   XL,LOW(DVUS(500))
000098 dff6        rcall	 Wait4xCycles
000099 950a        dec	   r16
00009a f7c1        brne	  WaitMsLoop
00009b 910f        pop	   r16
00009c 9508        ret
                 ;------------------------------------------------------------------------------
                 ; End of file
                  ;------------------------------------------------------------------------------
                 ; 1-wire definitions
                 ;------------------------------------------------------------------------------
                 .equ	OW_PORT	= PORTD
                 .equ	OW_PIN	= PIND
                 .equ	OW_DDR	= DDRD
                 .equ	OW_DQ	= PD4
                 
                 .def	OWCount = r17
                 ;------------------------------------------------------------------------------
                 ; 1-wire definitions
                 ;------------------------------------------------------------------------------
                 
                 
                 ;------------------------------------------------------------------------------
                 ; 1-wire definitions WS2812
                 ;------------------------------------------------------------------------------
                 .def    DATA            = r21
                 .def    red             = r22
                 .def    green           = r23
                 .def    blue			= r24
                 .equ	OW_PORT_WS2812	= PORTD
                 .equ	OW_PIN_WS2812	= PIND
                 .equ	OW_DDR_WS2812	= DDRD
                 .equ	OW_DQ_WS2812	= PD3
                 
                 //.def	OWCount = r17
                 ;------------------------------------------------------------------------------
                 ; 1-wire definitions WS2812
                 ;------------------------------------------------------------------------------
                 
                 
