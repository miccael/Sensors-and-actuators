                 OWWriteBitOD:
0001fb f418      	brcc	OWWriteZeroOD
0001fc e0b0      	ldi		XH, HIGH(DVUS(1))//Måste Kalibreras
0001fd e0a5      	ldi		XL, LOW(DVUS(1))//Måste Kalibreras
0001fe c002      	rjmp	OWWriteOneOD
                 OWWriteZeroOD:	
0001ff e0b0      	ldi		XH, HIGH(DVUS(10)) 
000200 e3a2      	ldi		XL, LOW(DVUS(10)) 
                 OWWriteOneOD:
