                 OWResetOD:
0001eb 985c      	cbi		OW_PORT,OW_DQ
0001ec 9a54      	sbi		OW_DDR,OW_DQ
                 
0001ed e0b1      	ldi		XH, HIGH(DVUS(55))
0001ee e1a3      	ldi		XL, LOW(DVUS(55))
0001ef de9f      	rcall	Wait4xCycles
                 	
0001f0 9854      	cbi		OW_DDR,OW_DQ
                 
0001f1 e0b0      	ldi		XH, HIGH(DVUS(8))
0001f2 e2a8      	ldi		XL, LOW(DVUS(8))
0001f3 de9b      	rcall	Wait4xCycles
                 
0001f4 9468      	set
0001f5 9b4c      	sbis	OW_PIN,OW_DQ
0001f6 94e8      	clt
                 
0001f7 e0b0      	ldi		XH, HIGH(DVUS(48))
0001f8 efa0      	ldi		XL, LOW(DVUS(48))
0001f9 de95      	rcall	Wait4xCycles
                 
0001fa 9508      	ret
                 ;------------------------------------------------------------------------------
                 ; Input : C - bit to write
