                 ; WS2812B.asm
                 ;
                 ; Created: 2016-10-08 16:43:12
                 ; Author : Mikael Glans
                 ;
                 
                 
                 
                  //---------System Clock init----------------
                   #define F_CPU 20000000
                 
                  //---------System Clock init----------------
                  
                  
                  
000000 d09c       rcall LCD
000001 d158       rcall LCDwrite
                  
                 
                 
                  Main:
                 
                 
                 	
000002 e070      	ldi green, 0x00  //first pixel
000003 e060      	ldi red, 0x00
000004 e080      	ldi blue, 0x00
000005 d14d      	rcall LED_WS2812
                 
000006 e070      	ldi green, 0x00  //second pixel
000007 ef60      	ldi red, 0xf0
000008 e080      	ldi blue, 0x00
000009 d149      	rcall LED_WS2812
                 
00000a ef70      	ldi green, 0xf0  //third pixel
00000b e060      	ldi red, 0x00
00000c e080      	ldi blue, 0x00
00000d d145      	rcall LED_WS2812
                 
00000e e070      	ldi green, 0x00  //fourth pixel
00000f e060      	ldi red, 0x00
000010 ef80      	ldi blue, 0xf0
000011 d141      	rcall LED_WS2812
                 
