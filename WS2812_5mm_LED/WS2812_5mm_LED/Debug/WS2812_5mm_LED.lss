0000dd d116      	rcall OWWriteByte
0000de ec0c      	ldi r16, 0xCC     //Write Conditional Search Register command
0000df d0d3      	rcall OWWriteByteOD
0000e0 e80d      	ldi r16, 0x8D     //TA1 beginning adress
0000e1 d0d1      	rcall OWWriteByteOD
0000e2 e000      	ldi r16, 0x00     //TA2 adress 008Dh
0000e3 d0cf      	rcall OWWriteByteOD
0000e4 e801      	ldi r16, 0x81     //data byte adress 008Dh
0000e5 d0cd      	rcall OWWriteByteOD
                 	//---------------------1-wire init Vcc powered device Overdrive Mode---------------
                 
0000e6 d0af      	rcall OWResetOD
0000e7 e30c      	ldi r16, 0x3C     //Overdrive skip ROM
0000e8 d0ca      	rcall OWWriteByteOD
0000e9 ef00      	ldi r16, 0xF0     //Read PIO Registers command
0000ea d0c8      	rcall OWWriteByteOD
0000eb e80d      	ldi r16, 0x8D     //TA1 beginning adress
0000ec d0c6      	rcall OWWriteByteOD
0000ed e000      	ldi r16, 0x00     //TA2 adress 008Dh
0000ee d0c4      	rcall OWWriteByteOD
0000ef d0de      	rcall OWReadByteOD //Read Control/Status Register and verify
                 
0000f0 d0a5      	rcall OWResetOD
0000f1 e30c      	ldi r16, 0x3C     //Overdrive skip ROM
0000f2 d0c0      	rcall OWWriteByteOD
0000f3 e50a      	ldi r16, 0x5A     //Channel-access Write command
0000f4 d0be      	rcall OWWriteByteOD
0000f5 2f02      	mov r16, r18     //Write byte to PIO
0000f6 d0bc      	rcall OWWriteByteOD
0000f7 2f02      	mov r16, r18     //
0000f8 9500      	com r16           //
                 	//ldi r16, 0xFF     //Write inverted byte to PIO
0000f9 d0b9      	rcall OWWriteByteOD
0000fa d0d3      	rcall OWReadByteOD //Read for verification (AAh = success)
0000fb d0d2      	rcall OWReadByteOD //Read PIO pin status
0000fc d099      	rcall OWResetOD
                 	
0000fd 9508      ret
                 
