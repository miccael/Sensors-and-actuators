                 ; WS2812_5mm_LED.asm
                 ;
                 ; Created: 2016-08-08 19:18:53
                 ; Author : Mikael Glans
                 ;
                 
                 
                 
                 
                 
                  //---------System Clock init----------------
                   #define F_CPU 20000000
                 
                  //---------System Clock init----------------
                  
                  
                  
                    
                 
                 	
                  
000000 d047       rcall LCD
                 
                  Main:
                 
                 	
000001 e060      	ldi red, 0x00  //first pixel
000002 ef70      	ldi green, 0xf0
000003 e080      	ldi blue, 0x00
000004 d0f9      	rcall LED_WS2812
                 
000005 e060      	ldi red, 0x00 //second pixel
000006 ef70      	ldi green, 0xf0
000007 ef80      	ldi blue, 0xf0
000008 d0f5      	rcall LED_WS2812
                 
000009 ef60      	ldi red, 0xf0 //third pixel
00000a ef70      	ldi green, 0xf0
00000b e080      	ldi blue, 0x00
00000c d0f1      	rcall LED_WS2812
                 
00000d d20a      	rcall OWResetWS2812
                 	
00000e ec08      	ldi r16, 200
00000f d02d      	rcall	WaitMiliseconds
